@model GameStore.Models.GioHang


@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Giỏ hàng";
    var total = Model.ChiTietGioHangs.Sum(x => x.DonGiaHienTai);

}


<div class="container mt-5">

    <h2 class="mb-4">🛒 Your Shopping Cart</h2>

    @if (TempData["Msg"] != null)
    {
        <div class="alert alert-warning">
            @TempData["Msg"]
        </div>
    }

    @if (Model == null || !Model.ChiTietGioHangs.Any())
    {
        <div class="alert alert-info">
            Giỏ hàng của bạn đang trống 😢
        </div>

        <a asp-controller="Home"
           asp-action="Index"
           class="btn btn-primary">
            ← Quay lại mua game
        </a>
    }
    else
    {
        <table class="table table-dark table-hover align-middle">
            <thead>
                <tr>
                    <th>Game</th>
                    <th>Price</th>
                    <th>Action</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var item in Model.ChiTietGioHangs)
                {
                    <tr>
                        <td class="d-flex align-items-center gap-3">
                            <img asp-append-version="true"
                                 src="@Url.Content("~/images/" + item.Game.Hinh)"
                                 width="80"
                                 style="border-radius:8px;">
                            <span>@item.Game.TenGame</span>
                        </td>

                        <td class="text-warning">
                            @item.DonGiaHienTai.ToString("N0") VND
                        </td>

                        <td>

                            <a asp-controller="Cart"
                               asp-action="Remove"
                               asp-route-gameId="@item.MaGame"
                               class="btn btn-danger btn-sm">
                                ❌ Remove
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>



        <div class="d-flex justify-content-between align-items-center mt-4">

            <div>
                @{
                    var returnUrl = TempData["ReturnUrl"]?.ToString() ?? "/home";
                }

                <a href="@returnUrl" class="btn btn-secondary">
                    ← Quay lại game
                </a>
            </div>
            <h4>
                Total:
                <span class="text-warning">
                    @total.ToString("N0") VND
                </span>
            </h4>

            <div class="d-flex gap-2">

                <a asp-controller="Cart"
                   asp-action="Clear"
                   class="btn btn-outline-danger"
                   onclick="return confirm('Are you sure to clear cart?')">
                    🧹 Clear Cart
                </a>
 
                <form method="get" action="/checkout" class="d-inline">
                    <input type="hidden" name="method" value="balance" />
                    <button type="submit" class="btn btn-success btn-lg">
                        💳 Pay with Balance
                    </button>
                </form>

                <a asp-controller="Vnpay"
                   asp-action="Pay"
                   class="btn btn-outline-primary btn-lg">
                    🟦 Pay with VNPay
                </a>
            </div>

        </div>

        <!-- Top-up card -->
        <div class="card mt-4 bg-dark text-light p-3" style="max-width:420px;">
            <h5>Nạp tiền vào ví (Top-up)</h5>
            <p class="small text-muted">Quét mã hoặc thanh toán qua VNPay để nạp tiền vào tài khoản của bạn.</p>

            <form method="get" action="/api/vnpay/topup" class="row g-2">
                <div class="col-8">
                    <input type="number" step="1000" min="1000" name="amount" class="form-control" placeholder="Số tiền (VND)" required />
                </div>
                <div class="col-4">
                    <button type="submit" class="btn btn-warning w-100">Nạp VNPay</button>
                </div>
                <div class="col-12">
                    <small class="text-muted">Lưu ý: hệ thống sẽ chuyển bạn đến trang VNPay để hoàn tất nạp tiền.</small>
                </div>
            </form>
        </div>
    }

</div>