@model GameStore.Models.GioHang


@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Giỏ hàng";
    var total = Model.ChiTietGioHangs.Sum(x => x.DonGiaHienTai);

}


<div class="container mt-5">

    <h2 class="mb-4">🛒 Your Shopping Cart</h2>

    @if (TempData["Msg"] != null)
    {
        <div class="alert alert-warning">
            @TempData["Msg"]
        </div>
    }

    @if (Model == null || !Model.ChiTietGioHangs.Any())
    {
        <div class="alert alert-info">
            Giỏ hàng của bạn đang trống 😢
        </div>

        <a href="/home" class="btn btn-primary">
            ← Quay lại mua game
        </a>
    }
    else
    {
        <table class="table table-dark table-hover align-middle">
            <thead>
                <tr>
                    <th>Game</th>
                    <th>Price</th>
                    <th>Action</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var item in Model.ChiTietGioHangs)
                {
                    <tr>
                        <td class="d-flex align-items-center gap-3">
                            <img src="@Url.Content("~/images/" + item.Game.Hinh)"
                                 width="80"
                                 style="border-radius:8px;">
                            <span>@item.Game.TenGame</span>
                        </td>

                        <td class="text-warning">
                            @item.DonGiaHienTai.ToString("N0") VND
                        </td>

                        <td>
                            <a href="/cart/remove?gameId=@item.MaGame"
                               class="btn btn-danger btn-sm">
                                ❌ Remove
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>



        <div class="d-flex justify-content-between align-items-center mt-4">

            <h4>
                Total:
                <span class="text-warning">
                    @total.ToString("N0") VND
                </span>
            </h4>

            <div class="d-flex gap-2">
                <a href="/cart/clear" class="btn btn-outline-danger" onclick="return confirm(`Are U Sure CLear?`)">
                    🧹 Clear Cart
                </a>

                <a href="/checkout" class="btn btn-success btn-lg">
                    💳 Checkout
                </a>
            </div>

        </div>
    }

</div>