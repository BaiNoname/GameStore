@model GameStore.Models.GioHang


@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Giỏ hàng";
    var total = Model.ChiTietGioHangs.Sum(x => x.DonGiaHienTai);

}


<div class="container mt-5">

    <h2 class="mb-4">🛒 Your Shopping Cart</h2>

    @if (Model == null || !Model.ChiTietGioHangs.Any())
    {
        <div class="alert alert-info">
            Your shopping cart is empty. 😢
        </div>

        <a asp-controller="Home"
           asp-action="Index"
           class="btn btn-primary">
            ← Back Home
        </a>
    }
    else
    {
        <table class="table table-dark table-hover align-middle">
            <thead>
                <tr>
                    <th>Game</th>
                    <th>Price</th>
                    <th>Action</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var item in Model.ChiTietGioHangs)
                {
                    <tr>
                        <td class="d-flex align-items-center gap-3">
                            <img asp-append-version="true"
                                 src="@Url.Content("~/images/" + item.Game.Hinh)"
                                 width="80"
                                 style="border-radius:8px;">
                            <span>@item.Game.TenGame</span>
                        </td>

                        <td class="text-warning">
                            @item.DonGiaHienTai.ToString("N0") VND
                        </td>

                        <td>

                            <a asp-controller="Cart"
                               asp-action="Remove"
                               asp-route-gameId="@item.MaGame"
                               asp-route-returnUrl="@ViewBag.ReturnUrl"
                               class="btn btn-danger btn-sm">
                                ❌ Remove
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>



        <div class="d-flex justify-content-between align-items-center mt-4">

            <div>
                @{
                    var returnUrl = ViewBag.ReturnUrl ?? TempData["ReturnUrl"]?.ToString() ?? "/home";
                }

                <a href="@returnUrl" class="btn btn-secondary">
                    ← Back
                </a>

            </div>
            <h4>
                Total:
                <span class="text-warning">
                    @total.ToString("N0") VND
                </span>
            </h4>

            <div class="d-flex gap-2">

                <button class="btn btn-outline-danger"
                        data-bs-toggle="modal"
                        data-bs-target="#clearCartModal">
                    🧹 Clear Cart
                </button>
                <div class="modal fade" id="clearCartModal" tabindex="-1">
                    <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content bg-dark text-light">

                            <div class="modal-header border-secondary">
                                <h5 class="modal-title">Xác nhận</h5>
                                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                            </div>

                            <div class="modal-body">
                                Bạn có chắc muốn xóa toàn bộ giỏ hàng không? 🧹
                            </div>

                            <div class="modal-footer border-secondary">
                                <button class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>

                                <a asp-controller="Cart"
                                   asp-action="Clear"
                                   class="btn btn-danger">
                                    Đồng ý
                                </a>
                            </div>

                        </div>
                    </div>
                </div>

                <button class="btn btn-success btn-lg"
                        data-bs-toggle="modal"
                        data-bs-target="#checkoutModal">
                    💳 Pay with Balance
                </button>
                <div class="modal fade" id="checkoutModal" tabindex="-1">
                    <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content bg-dark text-light">

                            <div class="modal-header border-secondary">
                                <h5 class="modal-title">Xác nhận thanh toán</h5>
                                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                            </div>

                            <div class="modal-body">
                                Bạn có chắc muốn thanh toán bằng số dư không? 💳
                            </div>

                            <div class="modal-footer border-secondary">
                                <button class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>

                                <form method="get" action="/checkout">
                                    <input type="hidden" name="method" value="balance" />
                                    <button type="submit" class="btn btn-success">
                                        Đồng ý thanh toán
                                    </button>
                                </form>
                            </div>

                        </div>
                    </div>
                </div>

                <a asp-controller="Cart"
                   asp-action="Checkout"
                   asp-route-method="momo"
                   class="btn btn-outline-pink btn-lg"
                   style="border-color:#ae2070;color:#ae2070;">
                    🟣 Pay with MoMo
                </a>
            </div>

        </div>

        <!-- Top-up card -->
        <div class="card mt-4 bg-dark text-light p-3" style="max-width:420px;">
            <h5>Top up your wallet (Top-up)</h5>
            <p class="small text-muted">Thanh toán qua MoMo để nạp tiền vào tài khoản của bạn.</p>

            <form method="get" action="/api/momo/topup" class="row g-2">
                <div class="col-8">
                    <input type="number" step="1000" min="5000" name="amount"
                           class="form-control" placeholder="Số tiền (VND)" required />
                </div>
                <div class="col-4">
                    <input type="hidden" name="userId" value="@(int.Parse(User.FindFirst("UserId").Value))" />
                    <button type="submit" class="btn btn-danger w-100">Nạp MoMo</button>
                </div>
                <div class="col-12">
                    <small class="text-muted">Tối thiểu 5.000 VND. Hệ thống sẽ chuyển bạn đến MoMo để hoàn tất.</small>
                </div>
            </form>
        </div>
    }

</div>