    <div id="aiChatPopup" class="ai-popup hidden">
        <div class="ai-header">
            🤖 Game AI Assistant
            <span id="closeChat" class="ai-close">✖</span>
        </div>

        <div id="aiBox" class="ai-body"></div>

        <div class="ai-footer">
            <input id="aiInput" placeholder="Ask about games..." />
            <button class="ai-send" onclick="sendMsg()">➤</button>
            <div id="suggestBox" class="ai-suggest"></div>
        </div>
    </div>

    <div id="toastBox"
         style="position: fixed; top: 20px; right: 20px; z-index: 9999;"></div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>

    @RenderSection("Scripts", required: false)

    <script>
        const currentUser = '@User.Identity.Name' || 'guest';

        function getChatKey() {
            return `game_chat_${currentUser}`;
        }

        const conn = new signalR.HubConnectionBuilder()
            .withUrl("/chatHub")
            .build();

        let isConnected = false;
        let aiStreamingDiv = null;
        let lastAIMessage = "";

        conn.start()
            .then(() => {
                isConnected = true;
                console.log("SignalR Connected");
            })
            .catch(err => console.error(err));

        function saveChat(user, msg) {
            let key = getChatKey();
            let chats = JSON.parse(localStorage.getItem(key) || "[]");

            chats.push({
                user: user,
                msg: msg,
                time: Date.now()
            });

            localStorage.setItem(key, JSON.stringify(chats));
        }

        function loadChat() {
            const box = document.getElementById("aiBox");
            if (!box) return;

            let key = getChatKey();
            let chats = JSON.parse(localStorage.getItem(key) || "[]");

            chats.forEach(c => {
                const isAI = c.user === "AI";
                const div = document.createElement("div");

                div.style.marginBottom = "8px";
                div.style.display = "flex";
                div.style.justifyContent = isAI ? "flex-start" : "flex-end";

                div.innerHTML = `
                    <div style="
                        max-width:70%;
                        padding:10px 12px;
                        border-radius:14px;
                        background:${isAI ? '#1e293b' : '#2563eb'};
                        color:white;
                    ">
                        <b>${c.user}:</b> ${c.msg}
                    </div>
                `;

                box.appendChild(div);
            });

            box.scrollTop = box.scrollHeight;
        }

        window.addEventListener("load", loadChat);

        conn.on("ReceiveMessage", (user, msg) => {
            saveChat(user, msg);

            const box = document.getElementById("aiBox");
            const isAI = user === "AI";
            const div = document.createElement("div");

            div.style.marginBottom = "8px";
            div.style.display = "flex";
            div.style.justifyContent = isAI ? "flex-start" : "flex-end";

            div.innerHTML = `
                <div style="
                    max-width:70%;
                    padding:10px 12px;
                    border-radius:14px;
                    background:${isAI ? '#1e293b' : '#2563eb'};
                    color:white;
                ">
                    <b>${user}:</b> ${msg}
                </div>
            `;

            box.appendChild(div);
            box.scrollTop = box.scrollHeight;
        });

        conn.on("ReceiveMessageStream", (user, msg) => {
            const box = document.getElementById("aiBox");

            if (!aiStreamingDiv) {
                const wrapper = document.createElement("div");
                wrapper.style.display = "flex";
                wrapper.style.justifyContent = "flex-start";

                aiStreamingDiv = document.createElement("div");
                aiStreamingDiv.style.maxWidth = "70%";
                aiStreamingDiv.style.padding = "10px 12px";
                aiStreamingDiv.style.borderRadius = "14px";
                aiStreamingDiv.style.background = "#1e293b";
                aiStreamingDiv.style.color = "#fff";

                wrapper.appendChild(aiStreamingDiv);
                box.appendChild(wrapper);
            }

            aiStreamingDiv.innerHTML = `<b>${user}:</b> ${msg}`;
            lastAIMessage = msg;
            box.scrollTop = box.scrollHeight;
        });

        let isSending = false;
        function sendMsg() {
            if (isSending) return;
            isSending = true;

            const input = document.getElementById("aiInput");
            const msg = input.value.trim();

            if (msg === "") {
                isSending = false;
                return;
            }

            aiStreamingDiv = null;

            conn.invoke("SendMessage", msg)
                .finally(() => {
                    isSending = false;
                });

            input.value = "";
            input.focus();

            setTimeout(() => {
                if (lastAIMessage) {
                    saveChat("AI", lastAIMessage);
                }
            }, 1500);
        }

        document.getElementById("aiInput").addEventListener("keydown", function (e) {
            if (e.key === "Enter") {
                e.preventDefault();
                sendMsg();
            }
        });

        document.getElementById("openAiChat").onclick = function () {
            document.getElementById("aiChatPopup").classList.remove("hidden");
        };

        document.getElementById("closeChat").onclick = function () {
            document.getElementById("aiChatPopup").classList.add("hidden");
        };

        function showToast(message, type = "success") {
            const toast = document.createElement("div");

            toast.style.minWidth = "250px";
            toast.style.marginBottom = "10px";
            toast.style.padding = "12px 16px";
            toast.style.borderRadius = "12px";
            toast.style.color = "white";
            toast.style.fontWeight = "500";
            toast.style.boxShadow = "0 5px 15px rgba(0,0,0,0.3)";
            toast.style.opacity = "0";
            toast.style.transform = "translateX(100%)";
            toast.style.transition = "all 0.4s ease";

            if (type === "success") toast.style.background = "#16a34a";
            else if (type === "error") toast.style.background = "#dc2626";
            else toast.style.background = "#2563eb";

            toast.innerText = message;

            document.getElementById("toastBox").appendChild(toast);

            setTimeout(() => {
                toast.style.opacity = "1";
                toast.style.transform = "translateX(0)";
            }, 100);

            setTimeout(() => {
                toast.style.opacity = "0";
                toast.style.transform = "translateX(100%)";

                setTimeout(() => toast.remove(), 400);
            }, 3000);
        }
    </script>

    @{
        var msg = TempData.Peek("ToastMessage") as string;
        var type = TempData.Peek("ToastType") as string;
    }

    @if (msg != null)
    {
        TempData.Remove("ToastMessage");
        TempData.Remove("ToastType");

        <script>
            showToast("@Html.Raw(msg)", "@type");
        </script>
    }

    <script>
        const globalSearchForm = document.getElementById("globalSearchForm");
        if (globalSearchForm) {
            globalSearchForm.addEventListener("submit", function () {
                const keyword = globalSearchForm.querySelector('input[name="globalSearch"]');
                if (keyword && keyword.value.trim() !== "") {
                    globalSearchForm.action = "/home#all-games-section";
                } else {
                    globalSearchForm.action = "/home";
                }
            });
        }
    </script>
</body>
</html>