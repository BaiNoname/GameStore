@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor
@inject GameStore.Models.GameStoreContext _db

@{
    var userName = HttpContextAccessor.HttpContext.Session.GetString("UserName");
}

<!doctype html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - GameStore</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" />

    @RenderSection("Styles", required: false)
</head>
<body>

    <header class="gs-topbar">
        <div class="container-xxl">

            <nav class="navbar navbar-expand-md navbar-dark">

                <!-- Logo -->
                <a class="navbar-brand" href="/">
                    <img src="https://store.fastly.steamstatic.com/public/shared/images/header/logo_steam.svg?t=962016"
                         width="176" height="44">
                </a>

                <!-- Nút menu mobile -->
                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainMenu">

                    <span class="navbar-toggler-icon"></span>
                </button>

                <!-- Menu -->
                <div class="collapse navbar-collapse" id="mainMenu">

                    <!-- Menu trái -->
                    <ul class="navbar-nav ms-3 fw-bold text-white">
                        <li class="nav-item">
                            <a class="nav-link" href="/">STORE</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" href="/Home/About">ABOUT</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" href="/Home/Support">SUPPORT</a>
                        </li>
                    </ul>

                    <!-- Menu phải -->
                    <div class="ms-auto d-flex align-items-center gap-3">

                        @if (!User.Identity.IsAuthenticated)
                        {
                            <a asp-controller="Auth" asp-action="Login">Sign in</a>
                        }
                        else
                        {
                            <div class="dropdown">

                                <button class="btn btn-outline-light dropdown-toggle"
                                        data-bs-toggle="dropdown">

                                    👤 @User.Identity.Name
                                </button>

                                <ul class="dropdown-menu dropdown-menu-end">
                                   
                                    <li>
                                        <a class="dropdown-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Library" ? "active" : "")"
                                           asp-controller="Library"
                                           asp-action="Index">
                                            🎮 My Library
                                        </a>
                                    </li>

                                    <li>
                                        <a class="dropdown-item"
                                           asp-controller="Account"
                                           asp-action="Profile">
                                            👤 My profile
                                        </a>
                                    </li>

                                    <li><hr class="dropdown-divider"></li>

                                    @{
                                        var uid = int.Parse(User.FindFirst("UserId").Value);
                                        var currentUser = _db.NguoiDungs.Find(uid);
                                    }
                                    <li>
                                        <span class="dropdown-item-text text-warning fw-bold">
                                            My Balance: 💰 @((currentUser?.SoDu ?? 0).ToString("N0")) VND
                                        </span>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>

                                    <li>
                                        <a class="dropdown-item text-danger"
                                           asp-controller="Auth"
                                           asp-action="Logout">
                                            🚪 Logout
                                        </a>
                                    </li>

                                </ul>
                            </div>
                        }

                        <a href="/cart" class="btn btn-outline-light">
                            🛒 Cart
                        </a>

                        <a class="gs-toplink gs-accent" href="javascript:void(0)" id="openAiChat">
                            🤖 AI Game Assistant
                        </a>

                    </div>

                </div>

            </nav>

        </div>
    </header>


    @if (ViewBag.HideSubBar == null)
    {
        <!-- Sub Navbar -->
        <section class="gs-subbar">
            <div class="container-xxl">
                <div class="gs-subbar-inner">
                    <div class="d-flex align-items-center gap-3 flex-wrap">
                        <div class="dropdown">
                            <button class="btn gs-pill dropdown-toggle" data-bs-toggle="dropdown">
                                Recommendations
                            </button>

                            <ul class="dropdown-menu gs-dd">

                                <li>
                                    <a class="dropdown-item" href="/home?type=new">
                                        New Games
                                    </a>
                                </li>

                                <li>
                                    <a class="dropdown-item" href="/home?type=hot">
                                        Hot Games
                                    </a>
                                </li>

                            </ul>
                        </div>

                        <div class="dropdown">
                            <button class="btn gs-pill dropdown-toggle" data-bs-toggle="dropdown">
                                Categories
                            </button>
                            <ul class="dropdown-menu gs-dd">
                                <li><a class="dropdown-item" href="/Home">All</a></li>
                                @if (ViewBag.Categories != null)
                                {
                                    foreach (var c in ViewBag.Categories)
                                    {
                                        <li>
                                            <a class="dropdown-item" href="/home?category=@c.MaTheLoai">
                                                @c.TenLoaiGame
                                            </a>
                                        </li>
                                    }
                                }
                            </ul>
                        </div>
                    </div>

                    <form class="gs-search ms-auto" method="get" action="/home">
                        <input class="form-control gs-search-input"
                               type="text"
                               name="search"
                               placeholder="Search game..." />

                        <button class="btn gs-search-btn" type="submit">
                            Search
                        </button>
                    </form>
                </div>
            </div>
        </section>
    }


    <!-- Nội dung riêng từng trang -->
    <main>
        @RenderBody()
    </main>

    <footer class="bg-dark text-secondary pt-4 pb-3 border-top mt-5">
        <div class="container">

            <div class="row align-items-start mb-3">
                <div class="col-md-9">
                    <img src="https://store.cloudflare.steamstatic.com/public/images/v6/logo_valve_footer.png"
                         style="height:25px;" class="mb-2" alt="Valve Footer Logo">

                    <p class="small mb-1">
                        © 2026 Valve Corporation. All rights reserved. All trademarks are property of their respective owners in the US and other countries.
                    </p>

                    <p class="small">
                        VAT included in all prices where applicable.
                        <a href="#" class="footer-link">Privacy Policy</a> |
                        <a href="#" class="footer-link">Legal</a> |
                        <a href="#" class="footer-link">Accessibility</a> |
                        <a href="#" class="footer-link">Steam Subscriber Agreement</a> |
                        <a href="#" class="footer-link">Refunds</a> |
                        <a href="#" class="footer-link">Cookies</a>
                    </p>
                </div>

                <div class="col-md-3 text-md-end">
                    <img src="https://store.cloudflare.steamstatic.com/public/images/v6/logo_steam_footer.png"
                         style="height:30px;" alt="Steam Footer Logo">
                </div>
            </div>

            <div class="row border-top pt-3 small">
                <div class="col-md-9">
                    <a href="#" class="footer-link me-3">About Valve</a>
                    <a href="#" class="footer-link me-3">Jobs</a>
                    <a href="#" class="footer-link me-3">Steamworks</a>
                    <a href="#" class="footer-link me-3">Steam Distribution</a>
                    <a href="#" class="footer-link me-3">Support</a>
                    <a href="#" class="footer-link me-3">Gift Cards</a>
                </div>

                <div class="col-md-3 text-md-end">
                    <a href="#" class="footer-link me-2">F</a>
                    <a href="#" class="footer-link me-2">X</a>
                    <a href="#" class="footer-link">🦋</a>
                </div>
            </div>

        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    @RenderSection("Scripts", required: false)
    <style>
        .ai-popup {
            position: fixed;
            bottom: 90px;
            right: 20px;
            width: 360px;
            height: 480px;
            background: #0f172a;
            color: #fff;
            display: flex;
            flex-direction: column;
            border-radius: 16px;
            z-index: 9999;
            box-shadow: 0 10px 40px rgba(0,0,0,0.6);
            overflow: hidden;
            animation: fadeIn 0.25s ease;
        }

        .hidden {
            display: none;
        }

        /* header */
        .ai-header {
            padding: 12px 15px;
            background: linear-gradient(90deg, #0d6efd, #00c6ff);
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-weight: bold;
        }

        /* nút close */
        .ai-close {
            cursor: pointer;
            transition: 0.2s;
        }

            .ai-close:hover {
                transform: scale(1.2);
                color: #ff4d4f;
            }

        /* body */
        .ai-body {
            flex: 1;
            overflow-y: auto;
            padding: 10px;
            background: #020617;
        }

        /* message bubble */
        .ai-msg {
            max-width: 75%;
            padding: 8px 12px;
            border-radius: 12px;
            margin-bottom: 8px;
            font-size: 14px;
        }

        .ai-user {
            background: #0d6efd;
            margin-left: auto;
        }

        .ai-bot {
            background: #1e293b;
            margin-right: auto;
        }

        /* footer */
        .ai-footer {
            display: flex;
            gap: 6px;
            padding: 10px;
            background: #020617;
            border-top: 1px solid #1e293b;
            position: relative;
        }

            /* input */
            .ai-footer input {
                flex: 1;
                border-radius: 20px;
                border: none;
                padding: 8px 12px;
                outline: none;
            }

        /* send button */
        .ai-send {
            background: #0d6efd;
            border: none;
            border-radius: 50%;
            width: 36px;
            height: 36px;
            color: white;
            cursor: pointer;
            transition: 0.2s;
        }

            .ai-send:hover {
                background: #0b5ed7;
                transform: scale(1.15);
            }

        /* suggest box */
        .ai-suggest {
            position: absolute;
            bottom: 50px;
            left: 0;
            width: 300px;
            background: #1e293b;
            display: none;
            border-radius: 8px;
            overflow: hidden;
        }

            .ai-suggest div {
                padding: 8px;
                cursor: pointer;
            }

                .ai-suggest div:hover {
                    background: #334155;
                }

        /* animation */
        @@keyframes fadeIn {
            from

        {
            transform: translateY(20px);
            opacity: 0;
        }

        to {
            transform: translateY(0);
            opacity: 1;
        }

        }
    </style>
    <div id="aiChatPopup" class="ai-popup hidden">

        <div class="ai-header">
            🤖 Game AI Assistant
            <span id="closeChat" class="ai-close">✖</span>
        </div>

        <div id="aiBox" class="ai-body"></div>

        <div class="ai-footer">
            <input id="aiInput" placeholder="Ask about games..." />

            <!-- nút send đẹp -->
            <button class="ai-send" onclick="sendMsg()">➤</button>

            <!-- suggest -->
            <div id="suggestBox" class="ai-suggest"></div>
        </div>

    </div>



    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>

    <script>

        // ================= USER =================
        const currentUser = '@User.Identity.Name' || 'guest';

        function getChatKey() {
            return `game_chat_${currentUser}`;
        }

        // ================= SIGNALR =================
        const conn = new signalR.HubConnectionBuilder()
            .withUrl("/chatHub")
            .build();

        let isConnected = false;

        let aiStreamingDiv = null;
        let lastAIMessage = "";

        conn.start()
            .then(() => {
                isConnected = true;
                console.log("SignalR Connected");
            })
            .catch(err => console.error(err));


        // ================= SAVE CHAT =================
        function saveChat(user, msg) {

            let key = getChatKey();

            let chats = JSON.parse(localStorage.getItem(key) || "[]");

            chats.push({
                user: user,
                msg: msg,
                time: Date.now()
            });

            localStorage.setItem(key, JSON.stringify(chats));
        }


        // ================= LOAD CHAT =================
        function loadChat() {

            const box = document.getElementById("aiBox");
            if (!box) return;

            let key = getChatKey();
            let chats = JSON.parse(localStorage.getItem(key) || "[]");

            chats.forEach(c => {

                const isAI = c.user === "AI";

                const div = document.createElement("div");

                div.style.marginBottom = "8px";
                div.style.display = "flex";
                div.style.justifyContent = isAI ? "flex-start" : "flex-end";

                div.innerHTML = `
                    <div style="
                        max-width:70%;
                        padding:8px;
                        border-radius:10px;
                        background:${isAI ? '#222' : '#0d6efd'};
                        color:white;
                    ">
                        <b>${c.user}:</b> ${c.msg}
                    </div>
                `;

                box.appendChild(div);
            });

            box.scrollTop = box.scrollHeight;
        }

        window.addEventListener("load", loadChat);


        // ================= RECEIVE NORMAL =================
        conn.on("ReceiveMessage", (user, msg) => {

            saveChat(user, msg);

            const box = document.getElementById("aiBox");

            const isAI = user === "AI";

            const div = document.createElement("div");

            div.style.marginBottom = "8px";
            div.style.display = "flex";
            div.style.justifyContent = isAI ? "flex-start" : "flex-end";

            div.innerHTML = `
                <div style="
                    max-width:70%;
                    padding:8px;
                    border-radius:10px;
                    background:${isAI ? '#222' : '#0d6efd'};
                    color:white;
                ">
                    <b>${user}:</b> ${msg}
                </div>
            `;

            box.appendChild(div);
            box.scrollTop = box.scrollHeight;
        });


        // ================= STREAMING =================
        conn.on("ReceiveMessageStream", (user, msg) => {

            const box = document.getElementById("aiBox");

            if (!aiStreamingDiv) {

                const wrapper = document.createElement("div");
                wrapper.style.display = "flex";
                wrapper.style.justifyContent = "flex-start";

                aiStreamingDiv = document.createElement("div");
                aiStreamingDiv.style.maxWidth = "70%";
                aiStreamingDiv.style.padding = "8px";
                aiStreamingDiv.style.borderRadius = "10px";
                aiStreamingDiv.style.background = "#222";
                aiStreamingDiv.style.color = "#fff";

                wrapper.appendChild(aiStreamingDiv);
                box.appendChild(wrapper);
            }

            aiStreamingDiv.innerHTML = `<b>${user}:</b> ${msg}`;

            lastAIMessage = msg;

            box.scrollTop = box.scrollHeight;
        });


        // ================= SEND MESSAGE =================
        let isSending = false;
        function sendMsg() {

                if (isSending) return;
        isSending = true;

        const input = document.getElementById("aiInput");
        const msg = input.value.trim();

        if (msg === "") {
            isSending = false;
            return;
        }

        aiStreamingDiv = null;

        conn.invoke("SendMessage", msg)
            .finally(() => {
                isSending = false;
            });

        input.value = "";
            input.focus();

            // lưu AI sau khi stream
            setTimeout(() => {
                if (lastAIMessage) {
                    saveChat("AI", lastAIMessage);
                }
            }, 1500);
        }


        // ================= ENTER SEND =================
        document.getElementById("aiInput").addEventListener("keydown", function (e) {
            if (e.key === "Enter") {
                e.preventDefault();
                sendMsg();
            }
        });


        // ================= OPEN CHAT =================
        document.getElementById("openAiChat").onclick = function () {
            document.getElementById("aiChatPopup").classList.remove("hidden");
        };


        // ================= CLOSE CHAT =================
        document.getElementById("closeChat").onclick = function () {
            document.getElementById("aiChatPopup").classList.add("hidden");
        };

    </script>

    <!-- TOAST -->
    <div id="toastBox"
         style="position: fixed; top: 20px; right: 20px; z-index: 9999;"></div>

    <script>
        function showToast(message, type = "success") {

            const toast = document.createElement("div");

            toast.style.minWidth = "250px";
            toast.style.marginBottom = "10px";
            toast.style.padding = "12px 16px";
            toast.style.borderRadius = "8px";
            toast.style.color = "white";
            toast.style.fontWeight = "500";
            toast.style.boxShadow = "0 5px 15px rgba(0,0,0,0.3)";
            toast.style.opacity = "0";
            toast.style.transform = "translateX(100%)";
            toast.style.transition = "all 0.4s ease";

            // màu theo type
            if (type === "success") toast.style.background = "#28a745";
            else if (type === "error") toast.style.background = "#dc3545";
            else toast.style.background = "#007bff";

            toast.innerText = message;

            document.getElementById("toastBox").appendChild(toast);

            // animation vào
            setTimeout(() => {
                toast.style.opacity = "1";
                toast.style.transform = "translateX(0)";
            }, 100);

            // tự biến mất sau 3s
            setTimeout(() => {
                toast.style.opacity = "0";
                toast.style.transform = "translateX(100%)";

                setTimeout(() => toast.remove(), 400);
            }, 3000);
        }
    </script>
    @{
        var msg = TempData.Peek("ToastMessage") as string;
        var type = TempData.Peek("ToastType") as string;
    }

    @if (msg != null)
    {
        TempData.Remove("ToastMessage");
        TempData.Remove("ToastType");

        <script>
            showToast("@Html.Raw(msg)", "@type");
        </script>
    }
</body>
</html>
