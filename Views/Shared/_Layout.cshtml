@using GameStore.Services
@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor
@inject GameStore.Models.GameStoreContext _db
@inject UserIconEffectService UserIconEffectService

@{
    // Lấy tên user từ session
    var userName = HttpContextAccessor.HttpContext.Session.GetString("UserName");
    string? equippedCssClass = null;

    // Lấy effect đang equip của user hiện tại
    if (User.Identity != null && User.Identity.IsAuthenticated)
    {
        var userIdClaim = User.FindFirst("UserId")?.Value;
        if (!string.IsNullOrWhiteSpace(userIdClaim))
        {
            int userId = int.Parse(userIdClaim);
            equippedCssClass = UserIconEffectService.GetEquippedCssClass(userId);
        }
    }
}

<!doctype html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - GameStore</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Orbitron:wght@600;700&display=swap" rel="stylesheet">

    <!-- Cho phép từng view chèn CSS riêng -->
    @RenderSection("Styles", required: false)

    <style>
        :root {
            --gs-bg: #07111f;
            --gs-bg-2: #0b1728;
            --gs-panel: rgba(13, 24, 42, 0.92);
            --gs-panel-2: rgba(18, 31, 52, 0.92);
            --gs-line: rgba(255,255,255,0.08);
            --gs-text: #f8fbff;
            --gs-muted: #a5b4c7;
            --gs-primary: linear-gradient(135deg, #7c3aed, #2563eb 55%, #06b6d4);
            --gs-primary-solid: #2563eb;
            --gs-shadow: 0 18px 40px rgba(0,0,0,0.28);
        }

        .gs-footer {
            margin-top: 60px;
            padding: 30px 0 26px;
            background: rgba(8, 14, 24, 0.92);
            border-top: 1px solid rgba(255,255,255,0.08);
            backdrop-filter: blur(10px);
        }

        .gs-footer-top {
            padding-bottom: 22px;
        }

        .gs-footer-bottom {
            border-top: 1px solid rgba(255,255,255,0.08);
            padding-top: 18px;
        }

        .gs-footer-brand img {
            max-height: 28px;
            width: auto;
            opacity: 0.95;
        }

        .gs-footer-brand-right img {
            max-height: 34px;
        }

        .gs-footer-text {
            color: #cbd5e1;
            font-size: 0.93rem;
            line-height: 1.7;
        }

        .gs-footer-subtext {
            color: #94a3b8;
            font-size: 0.9rem;
            line-height: 1.8;
        }

        .gs-footer-link {
            color: #9fb1c7;
            text-decoration: none;
            transition: color 0.2s ease, opacity 0.2s ease;
        }

            .gs-footer-link:hover {
                color: #ffffff;
            }

        .gs-footer-sep {
            color: rgba(255,255,255,0.18);
            margin: 0 8px;
        }

        .gs-footer-nav {
            display: flex;
            flex-wrap: wrap;
            gap: 10px 18px;
        }

        .gs-footer-social {
            display: inline-flex;
            align-items: center;
            gap: 10px;
        }

        .gs-footer-social-link {
            width: 38px;
            height: 38px;
            border-radius: 999px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            background: rgba(255,255,255,0.05);
            border: 1px solid rgba(255,255,255,0.08);
            color: #dbe6f7;
            text-decoration: none;
            transition: all 0.2s ease;
        }

            .gs-footer-social-link:hover {
                color: #fff;
                background: rgba(255,255,255,0.1);
                transform: translateY(-1px);
            }

        @@media (max-width: 991.98px) {
            .gs-footer {
                padding: 24px 0 22px;
            }

            .gs-footer-brand-right {
                text-align: left;
            }
        }

        @@media (max-width: 575.98px) {
            .gs-footer-text,
            .gs-footer-subtext {
                font-size: 0.88rem;
            }

            .gs-footer-sep {
                margin: 0 5px;
            }

            .gs-footer-social-link {
                width: 34px;
                height: 34px;
            }
        }

        html, body {
            background: radial-gradient(circle at top left, rgba(124, 58, 237, 0.16), transparent 25%), radial-gradient(circle at top right, rgba(37, 99, 235, 0.14), transparent 25%), linear-gradient(180deg, #050b16 0%, #07111f 40%, #091626 100%);
            color: var(--gs-text);
            min-height: 100%;
        }

        body {
            display: flex;
            flex-direction: column;
            font-family: 'Inter', sans-serif;
        }

        a {
            text-decoration: none;
        }

        main {
            flex: 1;
        }

        .gs-topbar {
            position: sticky;
            top: 0;
            z-index: 1040;
            background: rgba(6, 11, 22, 0.84);
            backdrop-filter: blur(14px);
            border-bottom: 1px solid var(--gs-line);
            box-shadow: 0 10px 30px rgba(0,0,0,0.18);
        }

        .navbar-brand img {
            filter: brightness(1.08);
        }

        .navbar-dark .navbar-nav .nav-link {
            color: #dce7f8;
            font-weight: 700;
            letter-spacing: .4px;
            padding: .75rem 1rem;
            border-radius: 12px;
            transition: .2s ease;
        }

            .navbar-dark .navbar-nav .nav-link:hover,
            .navbar-dark .navbar-nav .nav-link.active {
                color: #fff;
                background: rgba(255,255,255,0.06);
            }

        .gs-toplink {
            color: #dbeafe;
            font-weight: 700;
            transition: .2s ease;
        }

            .gs-toplink:hover {
                color: #fff;
            }

        .gs-accent {
            padding: 10px 14px;
            border-radius: 999px;
            background: rgba(255,255,255,0.06);
            border: 1px solid rgba(255,255,255,0.08);
        }

            .gs-accent:hover {
                background: rgba(255,255,255,0.12);
            }

        .btn-outline-light {
            border-radius: 999px;
        }

        .gs-subbar {
            background: rgba(8, 15, 28, 0.72);
            border-bottom: 1px solid var(--gs-line);
            backdrop-filter: blur(10px);
        }

        .gs-subbar-inner {
            gap: 16px;
        }

        .gs-search {
            min-width: min(100%, 420px);
            background: rgba(255,255,255,0.05);
            border: 1px solid rgba(255,255,255,0.08);
            border-radius: 999px;
            padding: 6px;
            box-shadow: inset 0 1px 0 rgba(255,255,255,0.03);
        }

        .gs-search-input,
        .gs-search-input:focus {
            background: transparent;
            border: none;
            color: #fff;
            box-shadow: none;
            padding-left: 14px;
        }

            .gs-search-input::placeholder {
                color: #9fb1c7;
                opacity: 1;
            }

        .gs-search-btn {
            white-space: nowrap;
            border: none;
            border-radius: 999px;
            background: var(--gs-primary);
            color: #fff;
            font-weight: 700;
            padding: 10px 18px;
            box-shadow: 0 10px 24px rgba(37, 99, 235, 0.24);
        }

            .gs-search-btn:hover {
                color: #fff;
                transform: translateY(-1px);
            }

        .dropdown-menu {
            background: #0f1b31;
            border: 1px solid rgba(255,255,255,0.08);
            border-radius: 16px;
            box-shadow: var(--gs-shadow);
        }

            .dropdown-menu .dropdown-item {
                color: #dbe6f7;
                border-radius: 10px;
            }

                .dropdown-menu .dropdown-item:hover,
                .dropdown-menu .dropdown-item.active {
                    background: rgba(255,255,255,0.07);
                    color: #fff;
                }

            .dropdown-menu .dropdown-item-text {
                color: #e8eef9;
            }

        footer {
            background: rgba(8, 14, 24, 0.92) !important;
            border-top: 1px solid var(--gs-line) !important;
        }

        .footer-link {
            color: #9fb1c7;
            transition: .2s ease;
        }

            .footer-link:hover {
                color: #fff;
            }

        .ai-popup {
            position: fixed;
            bottom: 90px;
            right: 20px;
            width: 360px;
            height: 500px;
            background: #0b1220;
            color: #fff;
            display: flex;
            flex-direction: column;
            border-radius: 20px;
            z-index: 9999;
            box-shadow: 0 20px 60px rgba(0,0,0,0.55);
            overflow: hidden;
            border: 1px solid rgba(255,255,255,0.08);
            animation: fadeIn 0.25s ease;
        }

        .hidden {
            display: none;
        }

        .ai-header {
            padding: 14px 16px;
            background: linear-gradient(90deg, #2563eb, #06b6d4);
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-weight: 800;
        }

        .ai-close {
            cursor: pointer;
            transition: 0.2s;
        }

            .ai-close:hover {
                transform: scale(1.15);
                color: #ffe4e6;
            }

        .ai-body {
            flex: 1;
            overflow-y: auto;
            padding: 12px;
            background: #020617;
        }

        .ai-footer {
            display: flex;
            gap: 8px;
            padding: 10px;
            background: #020617;
            border-top: 1px solid #1e293b;
            position: relative;
        }

            .ai-footer input {
                flex: 1;
                border-radius: 999px;
                border: 1px solid rgba(255,255,255,0.08);
                background: #0f172a;
                color: #fff;
                padding: 10px 14px;
                outline: none;
            }

        .ai-send {
            background: #2563eb;
            border: none;
            border-radius: 50%;
            width: 40px;
            height: 40px;
            color: white;
            cursor: pointer;
            transition: 0.2s;
        }

            .ai-send:hover {
                background: #1d4ed8;
                transform: scale(1.08);
            }

        .ai-suggest {
            position: absolute;
            bottom: 56px;
            left: 10px;
            width: 300px;
            background: #1e293b;
            display: none;
            border-radius: 10px;
            overflow: hidden;
            border: 1px solid rgba(255,255,255,0.08);
        }

            .ai-suggest div {
                padding: 8px 10px;
                cursor: pointer;
            }

                .ai-suggest div:hover {
                    background: #334155;
                }

        @@keyframes fadeIn {
            from {
                transform: translateY(20px);
                opacity: 0;
            }

            to {
                transform: translateY(0);
                opacity: 1;
            }
        }

        @@media (max-width: 991.98px) {
            .gs-subbar-inner {
                align-items: stretch !important;
            }

            .gs-search {
                width: 100%;
                min-width: 100%;
            }
        }

        @@media (max-width: 767.98px) {
            .navbar-brand img {
                width: 150px;
                height: auto;
            }

            .ai-popup {
                width: calc(100vw - 20px);
                right: 10px;
                bottom: 16px;
                height: 70vh;
            }
        }

        .navbar-brand.brand-combo {
            display: inline-flex;
            align-items: center;
            gap: 45px;
            padding: 0;
            line-height: 1;
        }

        /* ICON */
        .brand-icon {
            height: 56px;
            transform: scale(1.8);
            transform-origin: right center; /* 🔥 đổi từ left → right */
            display: block;
        }

        /* CHỮ */
        .brand-wordmark {
            height: 80px;
            transform: scale(1.28);
            transform-origin: left center;
            display: block;
            margin-left: -70px;
        }

        .insta-credit {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            color: #fff;
            text-decoration: none;
        }

            .insta-credit i {
                font-size: 18px;
                line-height: 1;
            }

        .gs-user-dropdown {
            min-width: 0;
        }

        .gs-user-toggle {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            max-width: 220px;
            border-radius: 999px;
            white-space: nowrap;
        }

        .gs-user-icon {
            flex: 0 0 auto;
        }

        .gs-user-name {
            display: inline-block;
            max-width: 130px;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
            vertical-align: bottom;
        }

        .gs-user-menu {
            min-width: 250px;
            max-width: min(92vw, 320px);
            padding: 10px;
        }

            .gs-user-menu .dropdown-item,
            .gs-user-menu .dropdown-item-text {
                white-space: normal;
                word-break: break-word;
                line-height: 1.45;
            }

        .gs-balance-text {
            display: flex;
            flex-direction: column;
            gap: 2px;
        }

        .gs-balance-label {
            color: #cbd5e1;
            font-size: 0.86rem;
            font-weight: 600;
        }

        .gs-balance-value {
            color: #facc15;
            font-weight: 800;
        }

        @@media (max-width: 991.98px) {
            .navbar-collapse .ms-auto.d-flex

        {
            width: 100%;
            align-items: stretch !important;
            gap: 10px !important;
            margin-top: 12px;
        }

        .gs-user-dropdown,
        .gs-user-dropdown .dropdown-toggle,
        .navbar-collapse .btn-outline-light,
        .navbar-collapse .gs-accent {
            width: 100%;
        }

        .gs-user-toggle {
            justify-content: center;
            max-width: 100%;
        }

        .gs-user-name {
            max-width: 180px;
        }

        .gs-user-menu {
            width: 100%;
            min-width: 100%;
            max-width: 100%;
        }

        }

        @@media (max-width: 575.98px) {
            .gs-user-toggle

        {
            min-height: 44px;
            padding-left: 14px;
            padding-right: 14px;
        }

        .gs-user-name {
            max-width: 120px;
        }

        .gs-user-menu {
            padding: 8px;
            border-radius: 14px;
        }

            .gs-user-menu .dropdown-item,
            .gs-user-menu .dropdown-item-text {
                font-size: 0.92rem;
            }

        .gs-balance-value {
            font-size: 0.95rem;
        }

        }

        @@media (max-width: 575.98px) {
            .gs-user-name

        {
            max-width: 90px;
        }

        }


        /* Avatar effect */
        .gs-user-avatar {
            width: 30px;
            height: 30px;
            min-width: 30px;
            border-radius: 50%;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            position: relative;
            transition: all .25s ease;
        }

        .gs-user-avatar-core {
            width: 100%;
            height: 100%;
            border-radius: 50%;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            background: rgba(124, 58, 237, 0.14);
            color: #c4b5fd;
            font-size: 14px;
            line-height: 1;
        }

        /* các hiệu ứng effect avatar */
        .gs-user-avatar.effect-neon-purple {
            box-shadow: 0 0 0 4px rgba(168, 85, 247, 0.22), 0 0 18px rgba(168, 85, 247, 0.72), 0 0 30px rgba(168, 85, 247, 0.42);
        }

        .gs-user-avatar.effect-champion-gold {
            box-shadow: 0 0 0 4px rgba(234, 179, 8, 0.22), 0 0 18px rgba(234, 179, 8, 0.72), 0 0 30px rgba(234, 179, 8, 0.42);
        }

        .gs-user-avatar.effect-community-blue {
            box-shadow: 0 0 0 4px rgba(59, 130, 246, 0.22), 0 0 18px rgba(59, 130, 246, 0.72), 0 0 30px rgba(59, 130, 246, 0.42);
        }

        .gs-user-avatar.effect-crimson-blaze {
            box-shadow: 0 0 0 3px rgba(239, 68, 68, 0.24), 0 0 16px rgba(239, 68, 68, 0.78), 0 0 28px rgba(185, 28, 28, 0.42);
        }

        .gs-user-avatar.effect-emerald-pulse {
            box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.22), 0 0 16px rgba(16, 185, 129, 0.76), 0 0 28px rgba(5, 150, 105, 0.35);
        }

        .gs-user-avatar.effect-frost-crown {
            box-shadow: 0 0 0 3px rgba(125, 211, 252, 0.24), 0 0 16px rgba(125, 211, 252, 0.78), 0 0 28px rgba(186, 230, 253, 0.45);
        }

        .gs-user-avatar.effect-shadow-rift {
            box-shadow: 0 0 0 3px rgba(75, 85, 99, 0.24), 0 0 18px rgba(17, 24, 39, 0.82), 0 0 32px rgba(88, 28, 135, 0.38);
        }

        .gs-user-avatar.effect-sunset-nova {
            box-shadow: 0 0 0 3px rgba(251, 146, 60, 0.25), 0 0 16px rgba(249, 115, 22, 0.76), 0 0 28px rgba(244, 114, 182, 0.34);
        }

        .gs-user-avatar.effect-cyber-lime {
            box-shadow: 0 0 0 3px rgba(132, 204, 22, 0.26), 0 0 16px rgba(132, 204, 22, 0.78), 0 0 28px rgba(190, 242, 100, 0.36);
        }

        .gs-user-avatar.effect-rose-halo {
            box-shadow: 0 0 0 3px rgba(244, 114, 182, 0.24), 0 0 16px rgba(236, 72, 153, 0.72), 0 0 28px rgba(192, 132, 252, 0.32);
        }

        /* Banner cảnh báo bài tập */
        .gs-school-banner {
            margin-top: 10px;
            margin-bottom: 6px;
            padding: 10px 18px;
            border-radius: 14px;
            background: linear-gradient(90deg, rgba(220,38,38,0.18), rgba(234,179,8,0.18));
            border: 1px solid rgba(255,255,255,0.12);
            color: #fff;
            font-weight: 800;
            font-size: 0.95rem;
            letter-spacing: 0.4px;
            text-transform: uppercase;
            box-shadow: 0 8px 24px rgba(0,0,0,0.25);
            backdrop-filter: blur(8px);
        }

        @@media (max-width: 768px) {
            .gs-school-banner {
                font-size: 0.75rem;
                line-height: 1.5;
                padding: 10px 12px;
            }
        }
    </style>
</head>
<body>

    <header class="gs-topbar">
        <div class="container-xxl">
            <nav class="navbar navbar-expand-md navbar-dark py-2">

                <a class="navbar-brand brand-combo" href="/">
                    <img src="~/assets/images/logos/Artboard2.svg" class="brand-wordmark">
                    <img src="~/assets/images/logos/Artboard1.svg" class="brand-icon">
                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainMenu">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainMenu">

                    <ul class="navbar-nav ms-3 fw-bold text-white">
                        <li class="nav-item">
                            <a class="nav-link" href="/">STORE</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" href="/Home/About">ABOUT</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" href="/Home/Support">SUPPORT</a>
                        </li>
                    </ul>

                    <!-- Khu user / cart / AI -->
                    <div class="ms-auto d-flex align-items-center gap-3 flex-wrap">

                        @if (!User.Identity.IsAuthenticated)
                        {
                            <!-- Nút đăng nhập -->
                            <a class="gs-toplink" asp-controller="Auth" asp-action="Login">Sign in</a>
                        }
                        else
                        {
                            <!-- Dropdown tài khoản người dùng -->
                            <div class="dropdown gs-user-dropdown">
                                <button class="btn btn-outline-light dropdown-toggle gs-user-toggle"
                                        data-bs-toggle="dropdown">
                                    <span class="gs-user-avatar @(equippedCssClass ?? "")">
                                        <span class="gs-user-avatar-core">👤</span>
                                    </span>
                                    <span class="gs-user-name">@User.Identity.Name</span>
                                </button>

                                <ul class="dropdown-menu dropdown-menu-end gs-user-menu">

                                    <!-- Link thư viện game -->
                                    <li>
                                        <a class="dropdown-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Library" ? "active" : "")"
                                           asp-controller="Library"
                                           asp-action="Index">
                                            🎮 My Library
                                        </a>
                                    </li>

                                    <!-- Link sự kiện của người dùng -->
                                    <li>
                                        <a class="dropdown-item @(ViewContext.RouteData.Values["action"]?.ToString() == "MyEvents" ? "active" : "")"
                                           asp-controller="Event"
                                           asp-action="MyEvents">
                                            🗓️ My Events
                                        </a>
                                    </li>

                                    <!-- Link hiệu ứng của người dùng -->
                                    <li>
                                        <a class="dropdown-item"
                                           asp-controller="Profile"
                                           asp-action="MyEffects">
                                            ✨ My Effects
                                        </a>
                                    </li>

                                    <!-- Link profile-->
                                    <li>
                                        <a class="dropdown-item"
                                           asp-controller="Account"
                                           asp-action="Profile">
                                            👤 My profile
                                        </a>
                                    </li>

                                    <li><hr class="dropdown-divider"></li>

                                    @{
                                        // Lấy số dư hiện tại của user
                                        var uid = int.Parse(User.FindFirst("UserId").Value);
                                        var currentUser = _db.NguoiDungs.Find(uid);
                                    }

                                    <!-- Hiển thị số dư -->
                                    <li>
                                        <span class="dropdown-item-text text-warning fw-bold gs-balance-text">
                                            <span class="gs-balance-label">My Balance:</span>
                                            <span class="gs-balance-value">💰 @((currentUser?.SoDu ?? 0).ToString("N0")) VND</span>
                                        </span>
                                    </li>

                                    <li><hr class="dropdown-divider"></li>

                                    <!-- Đăng xuất -->
                                    <li>
                                        <a class="dropdown-item text-danger"
                                           asp-controller="Auth"
                                           asp-action="Logout">
                                            🚪 Logout
                                        </a>
                                    </li>
                                </ul>
                            </div>
                        }

                        <!-- Link giỏ hàng -->
                        <a href="/cart" class="btn btn-outline-light">
                            🛒 Cart
                        </a>

                        <!-- Link AI Game Assistant -->
                        <a class="gs-toplink gs-accent" href="javascript:void(0)" id="openAiChat">
                            🤖 AI Game Assistant
                        </a>
                    </div>
                </div>
            </nav>
           
        </div>
    </header>
    <!-- Banner thông báo bài tập môn học -->
    <div class="gs-school-banner text-center">
        ĐÂY LÀ SẢN PHẨM BÀI TẬP PHỤC VỤ CHẤM ĐIỂM MÔN HỌC, KHÔNG NHẰM MỤC ĐÍCH THƯƠNG MẠI.
    </div>

    @if (ViewBag.HideSubBar == null)
    {
        <section class="gs-subbar py-2">
            <div class="container-xxl">
