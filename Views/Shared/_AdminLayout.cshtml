@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor

@{
    var userName = HttpContextAccessor.HttpContext.Session.GetString("UserName");
}

<!doctype html>
<html lang="vi">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@ViewData["Title"] - Admin GameStore</title>

    <link rel="shortcut icon" type="image/png" href="~/assets/images/logos/favicon.png" />
    <link rel="stylesheet" href="~/assets/css/styles.min.css" />

    @RenderSection("Styles", required: false)

    <style>

        .left-sidebar .brand-logo {
            min-height: 70px;
            padding: 0 16px;
        }

        .body-wrapper-inner {
            padding-top: 8px;
        }

            .body-wrapper-inner .container-fluid {
                padding-left: 20px;
                padding-right: 20px;
                padding-bottom: 20px;
            }

        .app-header .navbar {
            min-height: 70px;
            padding-left: 16px;
            padding-right: 16px;
        }

        .admin-greeting {
            display: inline-block;
            max-width: 280px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            vertical-align: middle;
        }

        .admin-avatar {
            object-fit: cover;
            display: block;
        }

        .dropdown-menu {
            min-width: 180px;
        }

        #toastBox {
            max-width: calc(100vw - 20px);
        }

            #toastBox > div {
                max-width: min(360px, calc(100vw - 20px));
                min-width: 250px;
                word-break: break-word;
            }

        @@media (max-width: 1199.98px) {
            .app-topstrip {
                padding-left: 16px !important;
                padding-right: 16px !important;
            }

            .body-wrapper-inner .container-fluid {
                padding-left: 16px;
                padding-right: 16px;
            }

            .admin-greeting {
                max-width: 220px;
            }
        }

        @@media (max-width: 991.98px) {
            .app-topstrip {
                min-height: 60px;
                padding-top: 12px !important;
                padding-bottom: 12px !important;
            }

            .app-header .navbar {
                min-height: 64px;
                padding-left: 12px;
                padding-right: 12px;
            }

            .body-wrapper-inner .container-fluid {
                padding-left: 14px;
                padding-right: 14px;
                padding-bottom: 16px;
            }

            .admin-greeting {
                max-width: 170px;
                font-size: 14px;
            }

            .navbar-nav.flex-row.ms-auto.align-items-center.gap-3 {
                gap: 10px !important;
            }
        }

        @@media (max-width: 767.98px) {
            .app-topstrip {
                min-height: 56px;
                padding-top: 10px !important;
                padding-bottom: 10px !important;
            }

            .app-header .navbar {
                min-height: 60px;
                padding-left: 10px;
                padding-right: 10px;
            }

            .body-wrapper-inner .container-fluid {
                padding-left: 12px;
                padding-right: 12px;
            }

            .admin-greeting {
                max-width: 120px;
                font-size: 13px;
            }

            .dropdown-menu {
                right: 0 !important;
                left: auto !important;
            }

            #toastBox {
                top: 12px !important;
                right: 12px !important;
            }

                #toastBox > div {
                    min-width: unset !important;
                    width: min(320px, calc(100vw - 24px));
                }
        }

        @@media (max-width: 575.98px) {
            .app-topstrip {
                justify-content: center !important;
                text-align: center;
            }

                .app-topstrip .d-flex.align-items-center.justify-content-center.gap-5 {
                    gap: 0 !important;
                    margin-bottom: 0 !important;
                }


            .app-header .navbar {
                min-height: 56px;
                padding-left: 8px;
                padding-right: 8px;
            }

            .body-wrapper-inner {
                padding-top: 4px;
            }

                .body-wrapper-inner .container-fluid {
                    padding-left: 10px;
                    padding-right: 10px;
                    padding-bottom: 14px;
                }

            .admin-greeting {
                max-width: 82px;
                font-size: 12px;
            }

            .navbar-nav.flex-row.ms-auto.align-items-center.gap-3 {
                gap: 8px !important;
            }

            .navbar-nav .nav-link {
                padding-left: 6px;
                padding-right: 6px;
            }

            .dropdown-menu {
                min-width: 160px;
                font-size: 14px;
            }

        }

        .navbar-brand.brand-combo {
            display: inline-flex;
            align-items: center;
            gap: 45px;
            padding: 0;
            line-height: 1;
        }

        .brand-icon {
            height: 56px;
            transform: scale(1.8);
            transform-origin: right center;
            display: block;
            width: auto;
            max-width: none;
        }

        .brand-wordmark {
            height: 80px;
            transform: scale(1.28);
            transform-origin: left center;
            display: block;
            margin-left: -70px;
            width: auto;
            max-width: none;
        }

        .app-topstrip .brand-combo {
            overflow: visible;
        }

            .app-topstrip .brand-combo img {
                display: block;
                filter: brightness(1.08);
            }

        @@media (max-width: 767.98px) {
            .navbar-brand.brand-combo

        {
            gap: 20px;
        }

        .brand-icon {
            height: 42px;
            transform: scale(1.35);
        }

        .brand-wordmark {
            height: 58px;
            transform: scale(1.08);
            margin-left: -38px;
        }

        }

        @@media (max-width: 575.98px) {
            .navbar-brand.brand-combo

        {
            gap: 14px;
        }

        .brand-icon {
            height: 34px;
            transform: scale(1.18);
        }

        .brand-wordmark {
            height: 46px;
            transform: scale(1);
            margin-left: -24px;
        }

        }

        .app-topstrip {
            min-height: 68px;
            position: relative;
            z-index: 2000;
        }

        .left-sidebar {
            z-index: 1000;
        }

        .app-topstrip .d-flex.align-items-center.justify-content-center.gap-5 {
            position: relative;
            z-index: 2001;
        }

        .app-topstrip .brand-combo {
            position: relative;
            z-index: 2002;
        }

        #navbarNav {
            margin-top: 50px;
        }

        @@media (max-width: 991.98px) {
            #navbarNav

        {
            margin-top: 20px;
        }

        }

        @@media (max-width: 767.98px) {
            #navbarNav

        {
            margin-top: 10px;
        }

        }

        @@media (max-width: 575.98px) {
            #navbarNav

        {
            margin-top: 0;
        }

        }


    </style>
</head>

<body>
    <div class="page-wrapper" id="main-wrapper"
         data-layout="vertical"
         data-navbarbg="skin6"
         data-sidebartype="full"
         data-sidebar-position="fixed"
         data-header-position="fixed">

        <!-- Top strip -->
        <div class="app-topstrip bg-dark py-3 px-3 w-100 d-lg-flex align-items-center justify-content-between">
            <div class="d-flex align-items-center justify-content-center gap-5 mb-2 mb-lg-0">
                <a class="navbar-brand brand-combo" href="/admin">
                    <img src="~/assets/images/logos/Artboard2.svg" class="brand-wordmark" />
                    <img src="~/assets/images/logos/Artboard1.svg" class="brand-icon" />
                </a>
            </div>
        </div>

        <!-- Sidebar -->
        <aside class="left-sidebar">
            <div>
                <div class="brand-logo d-flex align-items-center justify-content-between">
                    @* <a href="/admin/index" class="text-nowrap logo-img">
                        <img src="~/assets/images/logos/Gaming-store-logo.jpg" alt="Logo" width="95" height="31" />
                    </a> *@
                    <div class="close-btn d-xl-none d-block sidebartoggler cursor-pointer" id="sidebarCollapse">
                        <i class="ti ti-x fs-6"></i>
                    </div>
                </div>

                <nav class="sidebar-nav scroll-sidebar" data-simplebar="">
                    <ul id="sidebarnav">
                        <li class="nav-small-cap">
                            <iconify-icon icon="solar:menu-dots-linear" class="nav-small-cap-icon fs-4"></iconify-icon>
                            <span class="hide-menu">Management Game Store</span>
                        </li>

                        <li class="sidebar-item">
                            <a class="sidebar-link" href="/admin/dashboard" aria-expanded="false">
                                <i class="ti ti-layout-dashboard"></i>
                                <span class="hide-menu">Dashboard</span>
                            </a>
                        </li>

                        <li class="sidebar-item">
                            <a class="sidebar-link" href="/admin/user/index" aria-expanded="false">
                                <i class="ti ti-user"></i>
                                <span class="hide-menu">Users</span>
                            </a>
                        </li>

                        <li class="sidebar-item">
                            <a class="sidebar-link" href="/admin/category/index" aria-expanded="false">
                                <i class="ti ti-category"></i>
                                <span class="hide-menu">Categories Game</span>
                            </a>
                        </li>

                        <li class="sidebar-item">
                            <a class="sidebar-link" href="/admin/game/index" aria-expanded="false">
                                <i class="ti ti-device-gamepad-2"></i>
                                <span class="hide-menu">Games</span>
                            </a>
                        </li>

                        <li class="sidebar-item">
                            <a class="sidebar-link" href="/admin/payment/index" aria-expanded="false">
                                <i class="ti ti-credit-card"></i>
                                <span class="hide-menu">Payments</span>
                            </a>
                        </li>

                        <li class="sidebar-item">
                            <a class="sidebar-link" href="/admin/news/index" aria-expanded="false">
                                <i class="ti ti-news"></i>
                                <span class="hide-menu">News</span>
                            </a>
                        </li>

                    </ul>
                </nav>
            </div>
        </aside>

        <!-- Main -->
        <div class="body-wrapper">
            <!-- Header -->
            <header class="app-header">
                <nav class="navbar navbar-expand-lg navbar-light">
                    <ul class="navbar-nav">
                        <li class="nav-item d-block d-xl-none">
                            <a class="nav-link sidebartoggler" id="headerCollapse" href="javascript:void(0)">
                                <i class="ti ti-menu-2"></i>
                            </a>
                        </li>
                    </ul>

                    <div class="navbar-collapse justify-content-end px-0" id="navbarNav">
                        <ul class="navbar-nav flex-row ms-auto align-items-center gap-3">

                            <!-- 👋 Hi Admin -->
                            <li class="nav-item">
                                <span class="fw-semibold text-dark admin-greeting">
                                    👋 Hi Admin, @User.Identity.Name
                                </span>
                            </li>

                            <!-- Avatar + dropdown -->
                            <li class="nav-item dropdown">
                                <a class="nav-link" href="javascript:void(0)" data-bs-toggle="dropdown">
                                    <img src="~/assets/images/profile/user-1.jpg"
                                         width="35"
                                         height="35"
                                         class="rounded-circle admin-avatar">
                                </a>

                                <div class="dropdown-menu dropdown-menu-end">
                                    <a class="dropdown-item"
                                       asp-controller="AdminAccount"
                                       asp-action="Profile">
                                        👤 My Profile
                                    </a>

                                    <a class="dropdown-item text-danger"
                                       asp-controller="auth"
                                       asp-action="logout">
                                        Logout
                                    </a>
                                </div>
                            </li>

                        </ul>
                    </div>
                </nav>
            </header>

            <!-- Content -->
            <div class="body-wrapper-inner">
                <div class="container-fluid">
                    @RenderBody()
                </div>
            </div>
        </div>
    </div>

    <script src="~/assets/libs/jquery/dist/jquery.min.js"></script>
    <script src="~/assets/libs/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/assets/js/sidebarmenu.js"></script>
    <script src="~/assets/js/app.min.js"></script>
    <script src="~/assets/libs/apexcharts/dist/apexcharts.min.js"></script>
    <script src="~/assets/libs/simplebar/dist/simplebar.js"></script>
    <script src="~/assets/js/dashboard.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/iconify-icon@1.0.8/dist/iconify-icon.min.js"></script>

    @RenderSection("Scripts", required: false)

    <!-- TOAST -->
    <div id="toastBox"
         style="position: fixed; top: 20px; right: 20px; z-index: 9999;"></div>

    <script>
        function showToast(message, type = "success") {

            const toast = document.createElement("div");

            toast.style.minWidth = "250px";
            toast.style.marginBottom = "10px";
            toast.style.padding = "12px 16px";
            toast.style.borderRadius = "8px";
            toast.style.color = "white";
            toast.style.fontWeight = "500";
            toast.style.boxShadow = "0 5px 15px rgba(0,0,0,0.3)";
            toast.style.opacity = "0";
            toast.style.transform = "translateX(100%)";
            toast.style.transition = "all 0.4s ease";

            if (type === "success") toast.style.background = "#28a745";
            else if (type === "error") toast.style.background = "#dc3545";
            else toast.style.background = "#007bff";

            toast.innerText = message;

            document.getElementById("toastBox").appendChild(toast);

            setTimeout(() => {
                toast.style.opacity = "1";
                toast.style.transform = "translateX(0)";
            }, 100);

            setTimeout(() => {
                toast.style.opacity = "0";
                toast.style.transform = "translateX(100%)";

                setTimeout(() => toast.remove(), 400);
            }, 3000);
        }
    </script>
    @{
        var msg = TempData.Peek("ToastMessage") as string;
        var type = TempData.Peek("ToastType") as string;
    }

    @if (msg != null)
    {
        TempData.Remove("ToastMessage");
        TempData.Remove("ToastType");

        <script>
            showToast("@Html.Raw(msg)", "@type");
        </script>
    }
</body>

</html>