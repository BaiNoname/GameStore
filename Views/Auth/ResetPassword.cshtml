<div class="container mt-5 col-md-4">

    <h3 class="text-center mb-3">Đổi mật khẩu</h3>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">
            @ViewBag.Error
        </div>
    }

    <form method="post" asp-controller="Auth" asp-action="ResetPassword">

        <input name="password" type="password" class="form-control" placeholder="Mật khẩu mới" required />

        <input name="confirmPassword" type="password" class="form-control mt-2" placeholder="Xác nhận mật khẩu" required />

        <button type="submit" class="btn btn-warning mt-3 w-100">
            Đổi mật khẩu
        </button>

    </form>

</div>