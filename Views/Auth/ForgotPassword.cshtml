@{
    ViewData["Title"] = "Quên mật khẩu";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Quên mật khẩu</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <style>
        :root {
            --gs-text: #f3f7ff;
            --gs-muted: #94a3b8;
            --gs-line: rgba(255,255,255,0.08);
            --gs-primary: linear-gradient(135deg, #7c3aed, #2563eb 55%, #06b6d4);
        }

        body {
            min-height: 100vh;
            margin: 0;
            color: white;
            background: radial-gradient(circle at top left, rgba(124, 58, 237, 0.18), transparent 25%), radial-gradient(circle at top right, rgba(37, 99, 235, 0.14), transparent 25%), linear-gradient(180deg, #050b16 0%, #07111f 45%, #091626 100%);
        }

        .auth-page {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 24px 12px;
        }

        .auth-card {
            width: 100%;
            max-width: 470px;
            padding: 30px;
            border-radius: 28px;
            background: linear-gradient(180deg, rgba(14, 25, 43, 0.94), rgba(9, 18, 33, 0.94));
            border: 1px solid var(--gs-line);
            box-shadow: 0 24px 50px rgba(0,0,0,0.30);
        }

        .auth-kicker {
            font-size: 12px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1.8px;
            color: #7dd3fc;
            margin-bottom: 8px;
        }

        .auth-title {
            font-size: 2rem;
            font-weight: 800;
            margin-bottom: 10px;
            color: #fff;
        }

        .auth-subtitle {
            color: var(--gs-muted);
            margin-bottom: 24px;
            line-height: 1.7;
        }

        .alert {
            border-radius: 16px;
            border: 1px solid rgba(255,255,255,0.08);
        }

        .form-control,
        .form-control:focus {
            min-height: 50px;
            border-radius: 16px;
            background: rgba(255,255,255,0.05);
            border: 1px solid rgba(255,255,255,0.08);
            color: #fff;
            box-shadow: none;
        }

            .form-control::placeholder {
                color: #94a3b8;
                opacity: 1;
            }

        .btn-auth {
            min-height: 50px;
            border-radius: 999px;
            font-weight: 700;
            border: none;
            background: var(--gs-primary);
            color: #fff;
            box-shadow: 0 14px 28px rgba(37, 99, 235, 0.25);
        }

            .btn-auth:hover {
                color: #fff;
            }
    </style>
</head>
<body>
    <div class="auth-page">
        <div class="auth-card">
            <div class="auth-kicker">Recovery</div>
            <h3 class="auth-title text-center">Quên mật khẩu</h3>
            <p class="auth-subtitle text-center">
                Nhập email để hệ thống gửi mã xác nhận khôi phục mật khẩu.
            </p>

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger">
                    @ViewBag.Error
                </div>
            }

            <form method="post" asp-controller="Auth" asp-action="ForgotPassword">
                <input name="email" class="form-control" placeholder="Nhập email" required />

                <button type="submit" class="btn btn-auth mt-3 w-100">
                    Gửi mã
                </button>
            </form>
        </div>
    </div>
</body>
</html>