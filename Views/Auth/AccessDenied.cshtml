@{
    ViewData["Title"] = "Access Denied";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Access Denied</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <style>
        body {
            margin: 0;
            height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            background: radial-gradient(circle at top, #1b2838, #0f172a);
            color: white;
            font-family: Arial, sans-serif;
        }

        .box {
            text-align: center;
            padding: 40px;
            background: rgba(255,255,255,0.05);
            border: 1px solid rgba(255,255,255,0.1);
            border-radius: 20px;
            box-shadow: 0 0 30px rgba(0,0,0,0.5);
            max-width: 420px;
        }

        .icon {
            font-size: 70px;
            margin-bottom: 10px;
        }

        h1 {
            font-size: 28px;
            margin-bottom: 10px;
        }

        p {
            color: #cbd5e1;
            margin-bottom: 25px;
        }

        .btn-home {
            background: #0d6efd;
            border: none;
            padding: 10px 20px;
            border-radius: 50px;
            color: white;
            text-decoration: none;
            display: inline-block;
            transition: 0.2s;
        }

            .btn-home:hover {
                background: #2563eb;
                transform: scale(1.05);
            }


    </style>
</head>

<body>

    <div class="box">
        <div class="icon">⛔</div>

        <h1>Access Denied</h1>

        <p>No Permission.</p>

        <a class="btn-home" href="/">🏠 Back Home</a>

    </div>

</body>
</html>