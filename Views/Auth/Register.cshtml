@model GameStore.Models.NguoiDung

@{
    ViewData["Title"] = "Register";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <title>Register</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

    <style>
        :root {
            --gs-text: #f3f7ff;
            --gs-muted: #94a3b8;
            --gs-line: rgba(255,255,255,0.08);
            --gs-primary: linear-gradient(135deg, #7c3aed, #2563eb 55%, #06b6d4);
            --gs-warning: linear-gradient(135deg, #f59e0b, #f97316);
        }

        body {
            min-height: 100vh;
            margin: 0;
            color: white;
            background: radial-gradient(circle at top left, rgba(124, 58, 237, 0.18), transparent 25%), radial-gradient(circle at top right, rgba(37, 99, 235, 0.14), transparent 25%), linear-gradient(180deg, #050b16 0%, #07111f 45%, #091626 100%);
        }

        .auth-page {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 28px 0;
        }

        .auth-shell {
            width: 100%;
            max-width: 1160px;
            overflow: hidden;
            border-radius: 32px;
            border: 1px solid var(--gs-line);
            background: linear-gradient(180deg, rgba(13, 23, 40, 0.96), rgba(8, 17, 30, 0.96));
            box-shadow: 0 28px 60px rgba(0,0,0,0.34);
        }

        .auth-left {
            position: relative;
            min-height: 680px;
            background: linear-gradient(180deg, rgba(3,7,18,0.18), rgba(3,7,18,0.72)), url('https://images.unsplash.com/photo-1511512578047-dfb367046420?auto=format&fit=crop&w=1400&q=80') center/cover no-repeat;
        }

        .auth-left-overlay {
            position: absolute;
            inset: 0;
            background: linear-gradient(180deg, rgba(8,15,28,0.12) 0%, rgba(8,15,28,0.82) 100%);
        }

        .auth-left-content {
            position: relative;
            z-index: 2;
            height: 100%;
            display: flex;
            flex-direction: column;
            justify-content: end;
            padding: 34px;
        }

        .auth-kicker {
            display: inline-flex;
            align-items: center;
            width: fit-content;
            padding: 8px 14px;
            border-radius: 999px;
            background: rgba(255,255,255,0.08);
            border: 1px solid rgba(255,255,255,0.12);
            font-size: 13px;
            font-weight: 700;
            margin-bottom: 16px;
            backdrop-filter: blur(10px);
        }

        .auth-left-title {
            font-size: clamp(2rem, 4vw, 3.2rem);
            line-height: 1.08;
            font-weight: 800;
            margin-bottom: 12px;
        }

        .auth-left-desc {
            color: #d7e2f2;
            font-size: 1rem;
            line-height: 1.7;
            max-width: 520px;
            margin-bottom: 0;
        }

        .auth-right {
            padding: 40px 34px;
            display: flex;
            align-items: center;
            min-height: 680px;
        }

        .auth-form-wrap {
            width: 100%;
            max-width: 460px;
            margin: 0 auto;
        }

        .auth-mini {
            font-size: 12px;
            font-weight: 700;
            letter-spacing: 1.8px;
            text-transform: uppercase;
            color: #7dd3fc;
            margin-bottom: 8px;
        }

        .auth-title {
            font-size: 2rem;
            font-weight: 800;
            color: #fff;
            margin-bottom: 10px;
        }

        .auth-subtitle {
            color: var(--gs-muted);
            margin-bottom: 26px;
        }

        .alert {
            border-radius: 16px;
            border: 1px solid rgba(255,255,255,0.08);
        }

        .form-label {
            color: #dbe6f7;
            font-weight: 600;
            margin-bottom: 8px;
        }

        .auth-input,
        .auth-input:focus {
            min-height: 50px;
            border-radius: 16px;
            background: rgba(255,255,255,0.05);
            border: 1px solid rgba(255,255,255,0.08);
            color: #fff;
            box-shadow: none;
        }

            .auth-input::placeholder {
                color: #94a3b8;
                opacity: 1;
            }

        .form-check {
            padding-left: 1.8rem;
        }

        .form-check-input {
            background-color: rgba(255,255,255,0.06);
            border: 1px solid rgba(255,255,255,0.14);
        }

        .form-check-label {
            color: #dbe6f7;
        }

        .btn-auth-primary,
        .btn-auth-warning {
            min-height: 50px;
            border-radius: 999px;
            font-weight: 700;
            border: none;
        }

        .btn-auth-primary {
            background: var(--gs-primary);
            color: #fff;
            box-shadow: 0 14px 28px rgba(37, 99, 235, 0.25);
        }

            .btn-auth-primary:hover {
                color: #fff;
            }

        .btn-auth-warning {
            background: var(--gs-warning);
            color: #fff;
            box-shadow: 0 14px 28px rgba(245, 158, 11, 0.22);
        }

            .btn-auth-warning:hover {
                color: #fff;
            }

        @@media (max-width: 991.98px) {
            .auth-left {
                min-height: 320px;
            }

            .auth-right {
                min-height: auto;
                padding: 28px 20px;
            }

            .auth-left-content {
                padding: 24px;
            }
        }

        @@media (max-width: 575.98px) {
            .auth-title {
                font-size: 1.7rem;
            }

            .auth-left-title {
                font-size: 1.9rem;
            }
        }
    </style>

</head>

<body>
    <div class="container auth-page">
        <div class="row g-0 auth-shell">

            <div class="col-lg-6">
                <div class="auth-left">
                    <div class="auth-left-overlay"></div>
                    <div class="auth-left-content">
                        <div class="auth-kicker">Create Profile</div>
                        <h1 class="auth-left-title">Build your GameStore account and start collecting games</h1>
                        <p class="auth-left-desc">
                            Tạo tài khoản để mua game, quản lý thư viện cá nhân, sử dụng ví số dư và theo dõi hoạt động trên nền tảng.
                        </p>
                    </div>
                </div>
            </div>

            <div class="col-lg-6">
                <div class="auth-right">
                    <div class="auth-form-wrap">

                        <div class="auth-mini">Join GameStore</div>
                        <h2 class="auth-title">Create Your Account</h2>
                        <p class="auth-subtitle">Đăng ký nhanh để bắt đầu trải nghiệm mua game với giao diện hiện đại.</p>

                        @if (ViewBag.Error != null)
                        {
                            <div class="alert alert-danger">
                                @ViewBag.Error
                            </div>
                        }

                        <form method="post" asp-controller="Auth" asp-action="Register">

                            <div class="mb-3">
                                <label class="form-label">Email</label>
                                <input class="form-control auth-input" asp-for="Email" placeholder="Enter email">
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Username</label>
                                <input class="form-control auth-input" asp-for="TenNguoiDung" placeholder="Enter username">
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Password</label>
                                <input type="password" class="form-control auth-input" asp-for="MatKhau" placeholder="Enter password">
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Confirm Password</label>
                                <input type="password" class="form-control auth-input" name="confirmPassword" placeholder="Confirm password">
                            </div>

                            <div class="form-check mb-3">
                                <input class="form-check-input" type="checkbox" required>
                                <label class="form-check-label">
                                    I agree to the terms
                                </label>
                            </div>

                            <button type="submit" class="btn btn-auth-primary w-100">
                                Create Account
                            </button>

                            <div class="text-center mt-3">
                                <a asp-controller="auth" asp-action="login" class="btn btn-auth-warning w-100">
                                    Sign In
                                </a>
                            </div>

                        </form>

                    </div>
                </div>
            </div>

        </div>
    </div>
</body>
</html>