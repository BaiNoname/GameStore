<script>
    function showArchivedRoomToast() {
        if (typeof showToast === "function") {
            showToast("Sự kiện đã kết thúc. Phòng hiện ở chế độ lưu trữ.", "error");
        } else {
            alert("Sự kiện đã kết thúc. Phòng hiện ở chế độ lưu trữ.");
        }
    }
</script>