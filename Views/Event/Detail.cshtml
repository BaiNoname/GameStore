@model GameStore.Models.Event

@{
    ViewData["Title"] = Model.Title;

    // Get user join status, event full status, and event ended status from ViewBag or calculate based on model
    bool isJoined = ViewBag.IsJoined != null && (bool)ViewBag.IsJoined;
    bool isFull = Model.MaxParticipants.HasValue && Model.CurrentParticipants >= Model.MaxParticipants.Value;
    bool isEnded = (Model.Status ?? "").Trim().Equals("Ended", StringComparison.OrdinalIgnoreCase);
    string returnUrl = ViewBag.ReturnUrl as string ?? "/event?eventType=All&status=All&page=1";
    bool fromMyEvents = string.Equals(returnUrl, "/event/my-events", StringComparison.OrdinalIgnoreCase);
    string backText = fromMyEvents ? "Back to My Events" : "Back to Events";

    // Helper function to get the correct image URL
    string GetImage(string? image)
    {
        if (string.IsNullOrWhiteSpace(image))
            return "https://images.unsplash.com/photo-1511512578047-dfb367046420?auto=format&fit=crop&w=1600&q=80";

        if (image.StartsWith("http://") || image.StartsWith("https://"))
            return image;

        return Url.Content("~/images/events/" + image);
    }
}

<main class="gs-page">
    <div class="container-xxl">
        <div class="row g-4">
            <div class="col-lg-8">
                <article class="gs-article-card">
                    <div class="gs-breadcrumb mb-3">
                        <a href="/">Home</a>
                        <span>/</span>
                        <a href="@returnUrl">Event</a>
                        <span>/</span>
                        <span class="active">@Model.Title</span>
                    </div>

                    <h1 class="gs-article-title">@Model.Title</h1>

                    <div class="gs-meta mb-4">
                        <span>📅 @Model.StartAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
                        <span>🏁 @Model.EndAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
                        <span>👥 @Model.CurrentParticipants / @(Model.MaxParticipants?.ToString() ?? "∞")</span>
                        <span>💰 @Model.Price.ToString("N0") VND</span>
                        <span>🎮 @(Model.Game?.TenGame ?? "GameStore Event")</span>
                    </div>

                    <div class="gs-hero-image-wrap mb-4">
                        <img src="@GetImage(Model.Banner)" alt="@Model.Title" class="gs-hero-image" />
                    </div>

                    <div class="gs-summary-box mb-4">
                        @(string.IsNullOrWhiteSpace(Model.Summary) ? "Event information is being updated." : Model.Summary)
                    </div>

                    <div class="gs-article-content">
                        @Html.Raw((Model.Content ?? "").Replace("\n", "<br />"))
                    </div>

                    <div class="mt-4 d-flex gap-2 flex-wrap">
                        @if (isJoined)
                        {
                            if (isEnded)
                            {
                                <a href="/event/room/@Model.EventId?returnUrl=@Uri.EscapeDataString(returnUrl)" class="gs-btn-outline">View Archived Room</a>
                            }
                            else
                            {
                                <a href="/event/room/@Model.EventId?returnUrl=@Uri.EscapeDataString(returnUrl)" class="gs-btn-primary">Open Member Area</a>
                            }
                        }
                        // If not joined, show disabled buttons for ended or full events, otherwise show join/buy button
                        else if (isEnded)
                        {
                            <button type="button"
                                    class="gs-btn-disabled"
                                    onclick="showEndedToast()">
                                Event Ended
                            </button>
                        }
                        // If the event is full, show a disabled button with a toast message on click
                        else if (isFull)
                        {
                            <button type="button"
                                    class="gs-btn-disabled"
                                    onclick="showEventFullToast()">
                                Event Full
                            </button>
                        }
                        // If not joined and event is not full or ended, show join or buy button based on access type
                        else
                        {
                            // Normalize access type for comparison
                            if ((Model.AccessType ?? "").Trim().ToLower() == "free")
                            {
                                <button type="button"
                                        class="gs-btn-free"
                                        data-bs-toggle="modal"
                                        data-bs-target="#confirmJoinFreeEventModal">
                                    <span class="gs-btn-free-icon">⚡</span>
                                    <span>Join Free Event</span>
                                </button>
                            }
                            // If the event requires purchase, show the buy button with price
                            else
                            {
                                <button type="button"
                                        class="gs-btn-primary"
                                        data-bs-toggle="modal"
                                        data-bs-target="#confirmBuyEventModal">
                                    Buy Access - @Model.Price.ToString("N0") VND
                                </button>
                            }
                        }

                        <a href="@returnUrl" class="gs-btn-outline">@backText</a>
                    </div>

                    <div id="eventFullToast" class="gs-inline-toast">
                        This event has reached the maximum number of participants.
                    </div>

                    @if (!isJoined && !isFull && !isEnded && (Model.AccessType ?? "").Trim().ToLower() == "free")
                    {
                        <div class="modal fade" id="confirmJoinFreeEventModal" tabindex="-1" aria-labelledby="confirmJoinFreeEventModalLabel" aria-hidden="true">
                            <div class="modal-dialog modal-dialog-centered">
                                <div class="modal-content gs-confirm-modal">
                                    <div class="modal-header border-0">
                                        <h5 class="modal-title" id="confirmJoinFreeEventModalLabel">Confirm Join Event</h5>
                                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                                    </div>

                                    <div class="modal-body">
                                        <p class="mb-2 text-light">
                                            You are about to join a free event:
                                        </p>

                                        <div class="gs-confirm-box mb-3 free">
                                            <div class="fw-bold text-light">@Model.Title</div>
                                            <div class="text-info small mt-1">
                                                Free to join · Access member area after confirmation
                                            </div>
                                        </div>

                                        <p class="text-secondary mb-0">
                                            After joining, you can enter the event room, view announcements, chat with members, and check-in.
                                        </p>
                                    </div>

                                    <div class="modal-footer border-0">
                                        <button type="button" class="gs-btn-outline" data-bs-dismiss="modal">
                                            Cancel
                                        </button>

                                        <form method="post" action="/event/join/@Model.EventId">
                                            <input type="hidden" name="returnUrl" value="@returnUrl" />
                                            <input type="hidden" name="method" value="balance" />
                                            <button type="submit" class="gs-btn-free">
                                                <span class="gs-btn-free-icon">⚡</span>
                                                <span>Confirm Join</span>
                                            </button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }

                    @if (!isJoined && !isFull && !isEnded && (Model.AccessType ?? "").Trim().ToLower() != "free")
                    {
                        <div class="modal fade" id="confirmBuyEventModal" tabindex="-1" aria-labelledby="confirmBuyEventModalLabel" aria-hidden="true">
                            <div class="modal-dialog modal-dialog-centered">
                                <div class="modal-content gs-confirm-modal">
                                    <div class="modal-header border-0">
                                        <h5 class="modal-title" id="confirmBuyEventModalLabel">Confirm Purchase of Event Access</h5>
                                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                                    </div>

                                    <div class="modal-body">
                                        <p class="mb-2 text-light">
                                            You are about to purchase access to the event:
                                        </p>

                                        <div class="gs-confirm-box mb-3">
                                            <div class="fw-bold text-light">@Model.Title</div>
                                            <div class="text-secondary small mt-1">
                                                Participation Fee:
                                                <span class="text-warning fw-semibold">@Model.Price.ToString("N0") VND</span>
                                            </div>
                                        </div>

                                        <p class="text-secondary mb-0">
                                            Your account balance will be deducted immediately after confirmation. Are you sure you want to continue?
                                        </p>
                                    </div>

                                    <div class="modal-footer border-0">
                                        <button type="button" class="gs-btn-outline" data-bs-dismiss="modal">
                                            Cancel
                                        </button>

                                        <form method="post" action="/event/join/@Model.EventId">
                                            <input type="hidden" name="method" value="balance" />
                                            <input type="hidden" name="returnUrl" value="@returnUrl" />
                                            <button type="submit" class="gs-btn-primary">
                                                Confirm Purchase
                                            </button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </article>
            </div>

            <div class="col-lg-4">
                <div class="gs-side-panel mb-4">
                    <div class="gs-kicker">Access</div>
                    <h3 class="gs-side-title">Participation Info</h3>
                    <p class="gs-side-text"><strong>Type:</strong> @Model.EventType</p>
                    <p class="gs-side-text"><strong>Access:</strong> @Model.AccessType</p>
                    <p class="gs-side-text"><strong>Status:</strong> @Model.Status</p>
                    <p class="gs-side-text"><strong>Prize:</strong> @(string.IsNullOrWhiteSpace(Model.PrizeInfo) ? "Updating" : Model.PrizeInfo)</p>
                </div>

                <div class="gs-side-panel">
                    <div class="gs-kicker">Announcements</div>
                    <h3 class="gs-side-title">Latest Announcements</h3>

                    @{
                        // Get the list of announcements from ViewBag or use an empty list if not available
                        var announcements = ViewBag.Announcements as List<GameStore.Models.EventAnnouncement> ?? new List<GameStore.Models.EventAnnouncement>();
                    }

                    @if (announcements.Any())
                    {
                        // Loop through the latest 5 announcements and display their title and creation date
                        @foreach (var item in announcements.Take(5))
                        {
                            <div class="gs-announce-item">
                                <div class="fw-bold text-light">@item.Title</div>
                                <div class="text-secondary small">@item.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</div>
                            </div>
                        }
                    }
                    // If there are no announcements, display a placeholder message
                    else
                    {
                        <p class="text-secondary">No announcements available.</p>
                    }
                </div>
            </div>
        </div>
    </div>
</main>

<style>
    :root {
        --gs-bg: #07111f;
        --gs-bg-2: #0b1728;
        --gs-card: rgba(14, 25, 43, 0.88);
        --gs-line: rgba(255,255,255,0.08);
        --gs-text: #f3f7ff;
        --gs-muted: #94a3b8;
        --gs-primary: linear-gradient(135deg, #7c3aed, #2563eb 55%, #06b6d4);
    }

    * {
        font-family: 'Inter', sans-serif;
    }

    body {
        background: radial-gradient(circle at top left, rgba(124,58,237,0.18), transparent 24%), radial-gradient(circle at top right, rgba(37,99,235,0.14), transparent 22%), linear-gradient(180deg, #050b16 0%, #07111f 40%, #091626 100%);
        color: var(--gs-text);
        min-height: 100vh;
    }

    a {
        text-decoration: none;
        color: inherit;
    }

    .gs-page {
        padding: 48px 0 70px;
    }

    .gs-breadcrumb {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
        color: var(--gs-muted);
        font-size: 0.95rem;
    }

        .gs-breadcrumb .active {
            color: #fff;
        }

    .gs-article-card, .gs-side-panel, .gs-summary-box {
        background: linear-gradient(180deg, rgba(14,25,43,0.94), rgba(9,18,33,0.94));
        border: 1px solid var(--gs-line);
        border-radius: 28px;
        box-shadow: 0 20px 45px rgba(0,0,0,0.24);
    }

    .gs-article-card, .gs-side-panel {
        padding: 28px;
    }

    .gs-article-title {
        font-size: clamp(2rem, 4vw, 3rem);
        line-height: 1.15;
        color: #fff;
        margin-bottom: 18px;
        font-weight: 800;
    }

    .gs-meta {
        display: flex;
        gap: 16px;
        flex-wrap: wrap;
        color: #a9b7c9;
        font-size: .95rem;
    }

    .gs-hero-image-wrap {
        overflow: hidden;
        border-radius: 24px;
        border: 1px solid rgba(255,255,255,0.08);
    }

    .gs-hero-image {
        width: 100%;
        min-height: 360px;
        max-height: 520px;
        object-fit: cover;
        display: block;
    }

    .gs-summary-box {
        padding: 18px 20px;
        color: #dbe6f7;
        line-height: 1.75;
    }

    .gs-article-content {
        color: #dbe6f7;
        line-height: 1.9;
        font-size: 1rem;
    }

    .gs-btn-primary, .gs-btn-outline {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 46px;
        padding: 0 20px;
        border-radius: 999px;
        font-weight: 700;
    }

    .gs-btn-primary {
        background: var(--gs-primary);
        color: #fff;
        border: none;
    }

    .gs-btn-outline {
        background: rgba(255,255,255,0.06);
        border: 1px solid rgba(255,255,255,0.12);
        color: #fff;
    }

    .gs-kicker {
        font-size: 12px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 1.8px;
        color: #7dd3fc;
        margin-bottom: 8px;
    }

    .gs-side-title {
        font-size: 1.35rem;
        font-weight: 800;
        color: #fff;
        margin-bottom: 18px;
    }

    .gs-side-text {
        color: #dbe6f7;
        margin-bottom: 10px;
    }

    .gs-announce-item {
        padding: 12px 0;
        border-bottom: 1px solid rgba(255,255,255,0.08);
    }

        .gs-announce-item:last-child {
            border-bottom: none;
        }

    .gs-confirm-modal {
        background: linear-gradient(180deg, rgba(14,25,43,0.98), rgba(9,18,33,0.98));
        border: 1px solid rgba(255,255,255,0.08);
        border-radius: 24px;
        color: #fff;
        box-shadow: 0 20px 50px rgba(0,0,0,0.35);
    }

    .gs-confirm-box {
        background: rgba(255,255,255,0.05);
        border: 1px solid rgba(255,255,255,0.08);
        border-radius: 18px;
        padding: 14px 16px;
    }

    .gs-confirm-modal .modal-header,
    .gs-confirm-modal .modal-footer {
        padding-left: 24px;
        padding-right: 24px;
    }

    .gs-confirm-modal .modal-body {
        padding: 0 24px 8px;
    }

    .gs-btn-free {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        min-height: 46px;
        padding: 0 20px;
        border-radius: 999px;
        font-weight: 700;
        border: 1px solid rgba(34,197,94,0.28);
        background: linear-gradient(135deg, rgba(34,197,94,0.20), rgba(6,182,212,0.18));
        color: #d1fae5;
        box-shadow: 0 14px 28px rgba(6,182,212,0.12);
        transition: all .22s ease;
    }

        .gs-btn-free:hover {
            color: #fff;
            transform: translateY(-2px);
            box-shadow: 0 18px 32px rgba(6,182,212,0.18);
        }

    .gs-btn-free-icon {
        width: 24px;
        height: 24px;
        border-radius: 50%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: rgba(255,255,255,0.12);
        font-size: 13px;
    }

    .gs-confirm-box.free {
        border-color: rgba(34,197,94,0.18);
        background: rgba(34,197,94,0.08);
    }

    .gs-btn-disabled {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 46px;
        padding: 0 20px;
        border-radius: 999px;
        font-weight: 700;
        border: 1px solid rgba(255,255,255,0.10);
        background: rgba(255,255,255,0.08);
        color: #94a3b8;
        cursor: not-allowed;
        opacity: 0.95;
    }

    .gs-inline-toast {
        position: fixed;
        right: 24px;
        bottom: 24px;
        z-index: 2000;
        background: rgba(15, 23, 42, 0.96);
        color: #fff;
        border: 1px solid rgba(248, 113, 113, 0.28);
        box-shadow: 0 16px 40px rgba(0,0,0,0.28);
        border-radius: 16px;
        padding: 14px 18px;
        min-width: 280px;
        max-width: 360px;
        transform: translateY(20px);
        opacity: 0;
        pointer-events: none;
        transition: all .25s ease;
    }

        .gs-inline-toast.show {
            transform: translateY(0);
            opacity: 1;
        }

    @@media (max-width: 575.98px) {
        .gs-inline-toast

    {
        left: 16px;
        right: 16px;
        bottom: 16px;
        min-width: unset;
        max-width: unset;
    }

    }
</style>

<script>
    // Function to show the "Event Full" toast message
    function showEventFullToast() {
        const toast = document.getElementById("eventFullToast");
        if (!toast) return;

        toast.classList.add("show");
        clearTimeout(window.__eventFullToastTimer);

        window.__eventFullToastTimer = setTimeout(() => {
            toast.classList.remove("show");
        }, 2500);
    }

    function showEndedToast() {
        if (typeof showToast === "function") {
            showToast("The event has ended, you cannot join new.", "error");
        } else {
            alert("The event has ended, you cannot join new.");
        }
    }
</script>