@model GameStore.Models.Event

@{
    ViewData["Title"] = Model.Title;
    bool isJoined = ViewBag.IsJoined != null && (bool)ViewBag.IsJoined;

    string GetImage(string? image)
    {
        if (string.IsNullOrWhiteSpace(image))
            return "https://images.unsplash.com/photo-1511512578047-dfb367046420?auto=format&fit=crop&w=1600&q=80";

        if (image.StartsWith("http://") || image.StartsWith("https://"))
            return image;

        return Url.Content("~/images/events/" + image);
    }
}

<main class="gs-page">
    <div class="container-xxl">
        <div class="row g-4">
            <div class="col-lg-8">
                <article class="gs-article-card">
                    <div class="gs-breadcrumb mb-3">
                        <a href="/">Home</a>
                        <span>/</span>
                        <a href="/event">Event</a>
                        <span>/</span>
                        <span class="active">@Model.Title</span>
                    </div>

                    <h1 class="gs-article-title">@Model.Title</h1>

                    <div class="gs-meta mb-4">
                        <span>📅 @Model.StartAt.ToString("dd/MM/yyyy HH:mm")</span>
                        <span>🏁 @Model.EndAt.ToString("dd/MM/yyyy HH:mm")</span>
                        <span>👥 @Model.CurrentParticipants / @(Model.MaxParticipants?.ToString() ?? "∞")</span>
                        <span>💰 @Model.Price.ToString("N0") VND</span>
                        <span>🎮 @(Model.Game?.TenGame ?? "GameStore Event")</span>
                    </div>

                    <div class="gs-hero-image-wrap mb-4">
                        <img src="@GetImage(Model.Banner)" alt="@Model.Title" class="gs-hero-image" />
                    </div>

                    <div class="gs-summary-box mb-4">
                        @(string.IsNullOrWhiteSpace(Model.Summary) ? "Thông tin sự kiện đang được cập nhật." : Model.Summary)
                    </div>

                    <div class="gs-article-content">
                        @Html.Raw((Model.Content ?? "").Replace("\n", "<br />"))
                    </div>

                    <div class="mt-4 d-flex gap-2 flex-wrap">
                        @if (isJoined)
                        {
                            <a href="/event/room/@Model.EventId" class="gs-btn-primary">Open Member Area</a>
                        }
                        else
                        {
                            if ((Model.AccessType ?? "").Trim().ToLower() == "free")
                            {
                                <button type="button"
                                        class="gs-btn-free"
                                        data-bs-toggle="modal"
                                        data-bs-target="#confirmJoinFreeEventModal">
                                    <span class="gs-btn-free-icon">⚡</span>
                                    <span>Join Free Event</span>
                                </button>
                            }
                            else
                            {
                                <button type="button"
                                        class="gs-btn-primary"
                                        data-bs-toggle="modal"
                                        data-bs-target="#confirmBuyEventModal">
                                    Buy Access - @Model.Price.ToString("N0") VND
                                </button>
                            }
                        }

                        <a href="/event" class="gs-btn-outline">Back to Events</a>
                    </div>

                    @* xac nhan khi freee *@
                    @if (!isJoined && (Model.AccessType ?? "").Trim().ToLower() == "free")
                    {
                        <div class="modal fade" id="confirmJoinFreeEventModal" tabindex="-1" aria-labelledby="confirmJoinFreeEventModalLabel" aria-hidden="true">
                            <div class="modal-dialog modal-dialog-centered">
                                <div class="modal-content gs-confirm-modal">
                                    <div class="modal-header border-0">
                                        <h5 class="modal-title" id="confirmJoinFreeEventModalLabel">Xác nhận tham gia sự kiện</h5>
                                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                                    </div>

                                    <div class="modal-body">
                                        <p class="mb-2 text-light">
                                            Bạn sắp tham gia event miễn phí:
                                        </p>

                                        <div class="gs-confirm-box mb-3 free">
                                            <div class="fw-bold text-light">@Model.Title</div>
                                            <div class="text-info small mt-1">
                                                Miễn phí tham gia · Truy cập member area sau khi xác nhận
                                            </div>
                                        </div>

                                        <p class="text-secondary mb-0">
                                            Sau khi tham gia, bạn có thể vào room sự kiện, xem announcement, chat cùng thành viên và check-in.
                                        </p>
                                    </div>

                                    <div class="modal-footer border-0">
                                        <button type="button" class="gs-btn-outline" data-bs-dismiss="modal">
                                            Hủy
                                        </button>

                                        <form method="post" action="/event/join/@Model.EventId">
                                            <input type="hidden" name="method" value="balance" />
                                            <button type="submit" class="gs-btn-free">
                                                <span class="gs-btn-free-icon">⚡</span>
                                                <span>Xác nhận tham gia</span>
                                            </button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }

                    @* xac nhan khi thanh toan phi *@
                    @if (!isJoined && (Model.AccessType ?? "").Trim().ToLower() != "free")
                    {
                        <div class="modal fade" id="confirmBuyEventModal" tabindex="-1" aria-labelledby="confirmBuyEventModalLabel" aria-hidden="true">
                            <div class="modal-dialog modal-dialog-centered">
                                <div class="modal-content gs-confirm-modal">
                                    <div class="modal-header border-0">
                                        <h5 class="modal-title" id="confirmBuyEventModalLabel">Xác nhận mua quyền tham gia</h5>
                                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                                    </div>

                                    <div class="modal-body">
                                        <p class="mb-2 text-light">
                                            Bạn sắp mua quyền tham gia event:
                                        </p>

                                        <div class="gs-confirm-box mb-3">
                                            <div class="fw-bold text-light">@Model.Title</div>
                                            <div class="text-secondary small mt-1">
                                                Giá tham gia:
                                                <span class="text-warning fw-semibold">@Model.Price.ToString("N0") VND</span>
                                            </div>
                                        </div>

                                        <p class="text-secondary mb-0">
                                            Số dư tài khoản của bạn sẽ bị trừ ngay sau khi xác nhận. Bạn có chắc muốn tiếp tục không?
                                        </p>
                                    </div>

                                    <div class="modal-footer border-0">
                                        <button type="button" class="gs-btn-outline" data-bs-dismiss="modal">
                                            Hủy
                                        </button>

                                        <form method="post" action="/event/join/@Model.EventId">
                                            <input type="hidden" name="method" value="balance" />
                                            <button type="submit" class="gs-btn-primary">
                                                Xác nhận mua
                                            </button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }



                </article>
            </div>

            <div class="col-lg-4">
                <div class="gs-side-panel mb-4">
                    <div class="gs-kicker">Access</div>
                    <h3 class="gs-side-title">Participation Info</h3>
                    <p class="gs-side-text"><strong>Type:</strong> @Model.EventType</p>
                    <p class="gs-side-text"><strong>Access:</strong> @Model.AccessType</p>
                    <p class="gs-side-text"><strong>Status:</strong> @Model.Status</p>
                    <p class="gs-side-text"><strong>Prize:</strong> @(string.IsNullOrWhiteSpace(Model.PrizeInfo) ? "Updating" : Model.PrizeInfo)</p>
                </div>

                <div class="gs-side-panel">
                    <div class="gs-kicker">Announcements</div>
                    <h3 class="gs-side-title">Latest Announcements</h3>

                    @{
                        var announcements = ViewBag.Announcements as List<GameStore.Models.EventAnnouncement> ?? new List<GameStore.Models.EventAnnouncement>();
                    }

                    @if (announcements.Any())
                    {
                        @foreach (var item in announcements.Take(5))
                        {
                            <div class="gs-announce-item">
                                <div class="fw-bold text-light">@item.Title</div>
                                <div class="text-secondary small">@item.CreatedAt.ToString("dd/MM/yyyy HH:mm")</div>
                            </div>
                        }
                    }
                    else
                    {
                        <p class="text-secondary">Chưa có thông báo nào.</p>
                    }
                </div>
            </div>
        </div>
    </div>
</main>

<style>
    :root {
        --gs-bg: #07111f;
        --gs-bg-2: #0b1728;
        --gs-card: rgba(14, 25, 43, 0.88);
        --gs-line: rgba(255,255,255,0.08);
        --gs-text: #f3f7ff;
        --gs-muted: #94a3b8;
        --gs-primary: linear-gradient(135deg, #7c3aed, #2563eb 55%, #06b6d4);
    }

    * {
        font-family: 'Inter', sans-serif;
    }

    body {
        background: radial-gradient(circle at top left, rgba(124,58,237,0.18), transparent 24%), radial-gradient(circle at top right, rgba(37,99,235,0.14), transparent 22%), linear-gradient(180deg, #050b16 0%, #07111f 40%, #091626 100%);
        color: var(--gs-text);
        min-height: 100vh;
    }

    a {
        text-decoration: none;
        color: inherit;
    }

    .gs-page {
        padding: 48px 0 70px;
    }

    .gs-breadcrumb {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
        color: var(--gs-muted);
        font-size: 0.95rem;
    }

        .gs-breadcrumb .active {
            color: #fff;
        }

    .gs-article-card, .gs-side-panel, .gs-summary-box {
        background: linear-gradient(180deg, rgba(14,25,43,0.94), rgba(9,18,33,0.94));
        border: 1px solid var(--gs-line);
        border-radius: 28px;
        box-shadow: 0 20px 45px rgba(0,0,0,0.24);
    }

    .gs-article-card, .gs-side-panel {
        padding: 28px;
    }

    .gs-article-title {
        font-size: clamp(2rem, 4vw, 3rem);
        line-height: 1.15;
        color: #fff;
        margin-bottom: 18px;
        font-weight: 800;
    }

    .gs-meta {
        display: flex;
        gap: 16px;
        flex-wrap: wrap;
        color: #a9b7c9;
        font-size: .95rem;
    }

    .gs-hero-image-wrap {
        overflow: hidden;
        border-radius: 24px;
        border: 1px solid rgba(255,255,255,0.08);
    }

    .gs-hero-image {
        width: 100%;
        min-height: 360px;
        max-height: 520px;
        object-fit: cover;
        display: block;
    }

    .gs-summary-box {
        padding: 18px 20px;
        color: #dbe6f7;
        line-height: 1.75;
    }

    .gs-article-content {
        color: #dbe6f7;
        line-height: 1.9;
        font-size: 1rem;
    }

    .gs-btn-primary, .gs-btn-outline {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 46px;
        padding: 0 20px;
        border-radius: 999px;
        font-weight: 700;
    }

    .gs-btn-primary {
        background: var(--gs-primary);
        color: #fff;
        border: none;
    }

    .gs-btn-outline {
        background: rgba(255,255,255,0.06);
        border: 1px solid rgba(255,255,255,0.12);
        color: #fff;
    }

    .gs-kicker {
        font-size: 12px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 1.8px;
        color: #7dd3fc;
        margin-bottom: 8px;
    }

    .gs-side-title {
        font-size: 1.35rem;
        font-weight: 800;
        color: #fff;
        margin-bottom: 18px;
    }

    .gs-side-text {
        color: #dbe6f7;
        margin-bottom: 10px;
    }

    .gs-announce-item {
        padding: 12px 0;
        border-bottom: 1px solid rgba(255,255,255,0.08);
    }

        .gs-announce-item:last-child {
            border-bottom: none;
        }

    .gs-confirm-modal {
        background: linear-gradient(180deg, rgba(14,25,43,0.98), rgba(9,18,33,0.98));
        border: 1px solid rgba(255,255,255,0.08);
        border-radius: 24px;
        color: #fff;
        box-shadow: 0 20px 50px rgba(0,0,0,0.35);
    }

    .gs-confirm-box {
        background: rgba(255,255,255,0.05);
        border: 1px solid rgba(255,255,255,0.08);
        border-radius: 18px;
        padding: 14px 16px;
    }

    .gs-confirm-modal .modal-header,
    .gs-confirm-modal .modal-footer {
        padding-left: 24px;
        padding-right: 24px;
    }

    .gs-confirm-modal .modal-body {
        padding: 0 24px 8px;
    }

    .gs-btn-free {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        min-height: 46px;
        padding: 0 20px;
        border-radius: 999px;
        font-weight: 700;
        border: 1px solid rgba(34,197,94,0.28);
        background: linear-gradient(135deg, rgba(34,197,94,0.20), rgba(6,182,212,0.18));
        color: #d1fae5;
        box-shadow: 0 14px 28px rgba(6,182,212,0.12);
        transition: all .22s ease;
    }

        .gs-btn-free:hover {
            color: #fff;
            transform: translateY(-2px);
            box-shadow: 0 18px 32px rgba(6,182,212,0.18);
        }

    .gs-btn-free-icon {
        width: 24px;
        height: 24px;
        border-radius: 50%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: rgba(255,255,255,0.12);
        font-size: 13px;
    }

    .gs-confirm-modal {
        background: linear-gradient(180deg, rgba(14,25,43,0.98), rgba(9,18,33,0.98));
        border: 1px solid rgba(255,255,255,0.08);
        border-radius: 24px;
        color: #fff;
        box-shadow: 0 20px 50px rgba(0,0,0,0.35);
    }

    .gs-confirm-box {
        background: rgba(255,255,255,0.05);
        border: 1px solid rgba(255,255,255,0.08);
        border-radius: 18px;
        padding: 14px 16px;
    }

        .gs-confirm-box.free {
            border-color: rgba(34,197,94,0.18);
            background: rgba(34,197,94,0.08);
        }

    .gs-confirm-modal .modal-header,
    .gs-confirm-modal .modal-footer {
        padding-left: 24px;
        padding-right: 24px;
    }

    .gs-confirm-modal .modal-body {
        padding: 0 24px 8px;
    }
</style>