@model GameStore.Models.NguoiDung

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Profile";
}

<div class="container mt-5" style="max-width:650px;">

    <h3 class="mb-4 text-light">👤 Account Profile</h3>

    @if (TempData["Err"] != null)
    {
        <div class="alert alert-danger">@TempData["Err"]</div>
    }

    @if (TempData["Msg"] != null)
    {
        <div class="alert alert-success">@TempData["Msg"]</div>
    }

    <!-- INFO CARD -->
    <div class="card bg-dark text-light mb-4 shadow">
        <div class="card-body">

            <h5 class="card-title mb-3">📌 Thông tin tài khoản</h5>

            <div class="row mb-2">
                <div class="col-4 text-secondary">Email:</div>
                <div class="col-8">@Model.Email</div>
            </div>

            <div class="row mb-2">
                <div class="col-4 text-secondary">Username:</div>
                <div class="col-8">@Model.TenNguoiDung</div>
            </div>

            <div class="row mb-2">
                <div class="col-4 text-secondary">Balance:</div>
                <div class="col-8 text-warning">
                    @Model.SoDu.ToString("N0") VND
                </div>
            </div>

            <div class="row">
                <div class="col-4 text-secondary">Role:</div>
                <div class="col-8">@Model.Quyen</div>
            </div>

        </div>
    </div>

    <!-- UPDATE NAME -->
    <div class="card bg-dark text-light mb-4 shadow">
        <div class="card-body">

            <h5 class="mb-3">✏️ Change Username</h5>

            <form asp-action="UpdateName" method="post">
                <div class="mb-3">
                    <input type="text"
                           name="tenNguoiDung"
                           value="@Model.TenNguoiDung"
                           class="form-control"
                           placeholder="Enter new username"
                           required />
                </div>

                <button class="btn btn-info w-100">
                    💾 Save Username
                </button>
            </form>

        </div>
    </div>

    <!-- CHANGE PASSWORD -->
    <div class="card bg-dark text-light shadow">
        <div class="card-body">

            <h5 class="mb-3">🔐 Change Password</h5>

            <form asp-action="ChangePassword" method="post">

                <div class="mb-2">
                    <input type="password"
                           name="oldPass"
                           class="form-control"
                           placeholder="Current password"
                           required />
                </div>

                <div class="mb-2">
                    <input type="password"
                           name="newPass"
                           class="form-control"
                           placeholder="New password"
                           required />
                </div>

                <div class="mb-3">
                    <input type="password"
                           name="confirmPass"
                           class="form-control"
                           placeholder="Confirm new password"
                           required />
                </div>

                <button class="btn btn-warning w-100">
                    🔁 Change Password
                </button>
            </form>

        </div>
    </div>

</div>