@model List<GameStore.Models.UserIconEffect>

@{
    ViewData["Title"] = "My Effects";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<main class="gs-page">
    <div class="container py-5">
        <div class="mb-4">
            <div class="gs-kicker">Customization</div>
            <h2 class="gs-page-title mb-2">My Effects</h2>
            <p class="gs-page-subtitle mb-0">
                Manage the effects you've received from the event and select the effect you're currently using.
            </p>
        </div>

        <div class="d-flex flex-wrap gap-2 mb-4">
            <form method="post" action="/profile/unequip-effect">
                <button type="submit" class="gs-btn-outline rounded-pill">
                    Remove Current Effect
                </button>
            </form>
        </div>

        <div class="row g-4">
            @if (Model.Any())
            {
                @foreach (var item in Model)
                {
                    <div class="col-md-6 col-lg-4">
                        <div class="gs-effect-card h-100">
                            <div class="gs-effect-card-body">
                                <div class="d-flex justify-content-between align-items-start gap-3 mb-3">
                                    <div>
                                        <h5 class="gs-effect-title mb-1">@item.IconEffect?.EffectName</h5>
                                        <div class="gs-effect-code">Code: @item.IconEffect?.EffectCode</div>
                                    </div>

                                    @if (item.IsEquipped)
                                    {
                                        <span class="gs-badge gs-badge-success">Equipped</span>
                                    }
                                </div>

                                <div class="mb-3 d-flex flex-wrap gap-2">
                                    <span class="gs-badge gs-badge-dark">
                                        @(item.IconEffect?.EffectType ?? "Effect")
                                    </span>
                                    <span class="gs-badge gs-badge-warning">
                                        @(item.IconEffect?.Rarity ?? "Common")
                                    </span>
                                </div>

                                <div class="gs-effect-meta mb-2">
                                    Granted at: @item.GrantedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                </div>

                                @if (item.Event != null)
                                {
                                    <div class="gs-effect-meta mb-3">
                                        Reward from event: <strong>@item.Event.Title</strong>
                                    </div>
                                }

                                <div class="preview-box mb-3 @(item.IconEffect?.CssClass ?? "")">
                                    <div class="preview-avatar">U</div>
                                    <div class="preview-text mt-2">Preview effect</div>
                                </div>

                                <form method="post" action="/profile/equip-effect/@item.UserIconEffectId">
                                    <button type="submit" class="gs-btn-primary w-100 rounded-pill">
                                        @(item.IsEquipped ? "Currently Using" : "Use This Effect")
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="col-12">
                    <div class="gs-empty-box">
                        You don't have any effects yet.
                    </div>
                </div>
            }
        </div>
    </div>
</main>

<style>
    :root {
        --gs-text: #f3f7ff;
        --gs-muted: #94a3b8;
        --gs-line: rgba(255,255,255,0.08);
        --gs-card: linear-gradient(180deg, rgba(14, 25, 43, 0.92), rgba(9, 18, 33, 0.92));
        --gs-primary: linear-gradient(135deg, #7c3aed, #2563eb 55%, #06b6d4);
    }

    .gs-page {
        padding: 48px 0 70px;
        color: var(--gs-text);
    }

    .gs-kicker {
        font-size: 12px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 1.8px;
        color: #7dd3fc;
        margin-bottom: 8px;
    }

    .gs-page-title {
        font-size: clamp(1.8rem, 3vw, 2.35rem);
        font-weight: 800;
        color: #fff;
        letter-spacing: -0.02em;
    }

    .gs-page-subtitle {
        color: var(--gs-muted);
        max-width: 760px;
    }

    .gs-effect-card {
        border-radius: 24px;
        background: var(--gs-card);
        border: 1px solid rgba(255,255,255,0.08);
        box-shadow: 0 20px 45px rgba(0,0,0,0.24);
        overflow: hidden;
    }

    .gs-effect-card-body {
        padding: 22px;
    }

    .gs-effect-title {
        color: #fff;
        font-weight: 800;
    }

    .gs-effect-code {
        color: #9fb1c7;
        font-size: 0.9rem;
    }

    .gs-effect-meta {
        color: #aebed3;
        font-size: 0.92rem;
        line-height: 1.6;
    }

    .gs-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 30px;
        padding: 6px 12px;
        border-radius: 999px;
        font-size: 0.82rem;
        font-weight: 700;
        border: 1px solid transparent;
    }

    .gs-badge-success {
        background: rgba(34,197,94,0.14);
        color: #bbf7d0;
        border-color: rgba(34,197,94,0.22);
    }

    .gs-badge-dark {
        background: rgba(255,255,255,0.06);
        color: #e2e8f0;
        border-color: rgba(255,255,255,0.08);
    }

    .gs-badge-warning {
        background: rgba(245,158,11,0.16);
        color: #fde68a;
        border-color: rgba(245,158,11,0.22);
    }

    .gs-btn-primary,
    .gs-btn-outline {
        min-height: 46px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 999px;
        font-weight: 700;
        padding: 0 18px;
        transition: all .2s ease;
        text-decoration: none;
    }

    .gs-btn-primary {
        border: none;
        background: var(--gs-primary);
        color: #fff;
        box-shadow: 0 14px 28px rgba(37, 99, 235, 0.25);
    }

        .gs-btn-primary:hover {
            color: #fff;
            transform: translateY(-1px);
        }

    .gs-btn-outline {
        border: 1px solid rgba(255,255,255,0.12);
        background: rgba(255,255,255,0.05);
        color: #e2e8f0;
    }

        .gs-btn-outline:hover {
            color: #fff;
            background: rgba(255,255,255,0.08);
        }

    .gs-empty-box {
        padding: 18px;
        border-radius: 18px;
        background: rgba(255,255,255,0.05);
        border: 1px solid rgba(255,255,255,0.08);
        color: #cbd5e1;
    }

    .preview-box {
        min-height: 120px;
        border-radius: 18px;
        background: rgba(255,255,255,0.04);
        border: 1px solid rgba(255,255,255,0.08);
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 16px;
    }

    .preview-avatar {
        width: 58px;
        height: 58px;
        border-radius: 50%;
        background: #111827;
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 800;
        font-size: 1.15rem;
    }

    .preview-text {
        color: #cbd5e1;
        font-size: 0.9rem;
    }

    .effect-neon-purple .preview-avatar {
        box-shadow: 0 0 0 4px rgba(168, 85, 247, 0.22), 0 0 18px rgba(168, 85, 247, 0.72), 0 0 30px rgba(168, 85, 247, 0.42);
    }

    .effect-champion-gold .preview-avatar {
        box-shadow: 0 0 0 4px rgba(234, 179, 8, 0.22), 0 0 18px rgba(234, 179, 8, 0.72), 0 0 30px rgba(234, 179, 8, 0.42);
    }

    .effect-community-blue .preview-avatar {
        box-shadow: 0 0 0 4px rgba(59, 130, 246, 0.22), 0 0 18px rgba(59, 130, 246, 0.72), 0 0 30px rgba(59, 130, 246, 0.42);
    }

    .effect-crimson-blaze .preview-avatar {
        box-shadow: 0 0 0 3px rgba(239, 68, 68, 0.24), 0 0 16px rgba(239, 68, 68, 0.78), 0 0 28px rgba(185, 28, 28, 0.42);
    }

    .effect-emerald-pulse .preview-avatar {
        box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.22), 0 0 16px rgba(16, 185, 129, 0.76), 0 0 28px rgba(5, 150, 105, 0.35);
    }

    .effect-frost-crown .preview-avatar {
        box-shadow: 0 0 0 3px rgba(125, 211, 252, 0.24), 0 0 16px rgba(125, 211, 252, 0.78), 0 0 28px rgba(186, 230, 253, 0.45);
    }

    .effect-shadow-rift .preview-avatar {
        box-shadow: 0 0 0 3px rgba(75, 85, 99, 0.24), 0 0 18px rgba(17, 24, 39, 0.82), 0 0 32px rgba(88, 28, 135, 0.38);
    }

    .effect-sunset-nova .preview-avatar {
        box-shadow: 0 0 0 3px rgba(251, 146, 60, 0.25), 0 0 16px rgba(249, 115, 22, 0.76), 0 0 28px rgba(244, 114, 182, 0.34);
    }

    .effect-cyber-lime .preview-avatar {
        box-shadow: 0 0 0 3px rgba(132, 204, 22, 0.26), 0 0 16px rgba(132, 204, 22, 0.78), 0 0 28px rgba(190, 242, 100, 0.36);
    }

    .effect-rose-halo .preview-avatar {
        box-shadow: 0 0 0 3px rgba(244, 114, 182, 0.24), 0 0 16px rgba(236, 72, 153, 0.72), 0 0 28px rgba(192, 132, 252, 0.32);
    }

    @@media (max-width: 575.98px) {
        .gs-effect-card-body {
            padding: 18px;
        }
    }
</style>