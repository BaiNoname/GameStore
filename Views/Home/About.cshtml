@{
    ViewData["Title"] = "About";
}
<div class="gs-about-page">
    <div class="container py-5">
        <section class="gs-about-hero mb-5">
            <div class="gs-about-hero__content text-center">
                <div class="gs-kicker">About Us</div>
                <h1 class="gs-page-title fw-bold">About GameStore</h1>
                <p class="gs-page-subtitle">
                    Your digital platform for discovering amazing games
                </p>
            </div>
        </section>
        <section class="row g-4">
            <div class="col-md-4">
                <div class="gs-feature-card h-100">
                    <div class="gs-feature-icon">🎮</div>
                    <h4 class="mb-3">Our Mission</h4>
                    <p>
                        GameStore is built to help gamers discover,
                        explore and enjoy the best games from many genres.
                    </p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="gs-feature-card h-100">
                    <div class="gs-feature-icon">🚀</div>
                    <h4 class="mb-3">What We Offer</h4>
                    <p>
                        Browse trending games, explore categories,
                        and find new favorites easily with our modern UI.
                    </p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="gs-feature-card h-100">
                    <div class="gs-feature-icon">🤖</div>
                    <h4 class="mb-3">AI Recommendation</h4>
                    <p>
                        Our AI system helps recommend games
                        based on popularity and user interests.
                    </p>
                </div>
            </div>
        </section>
        <section class="gs-about-banner mt-5">
            <div class="row align-items-center g-4">
                <div class="col-lg-8">
                    <div class="gs-kicker">Why GameStore</div>
                    <h3 class="mb-3">A modern game marketplace built for players</h3>
                    <p class="mb-0 text-secondary">
                        We focus on clean browsing, fast discovery, better recommendations,
                        and a premium store experience that feels intuitive and enjoyable.
                    </p>
                </div>
                <div class="col-lg-4 text-lg-end">
                    <a href="/" class="btn gs-btn-primary px-4 py-2 rounded-pill">
                        Explore Store
                    </a>
                </div>
            </div>
        </section>
    </div>
</div>
<style>
    :root {
        --gs-text: #f3f7ff;
        --gs-muted: #94a3b8;
        --gs-line: rgba(255,255,255,0.08);
        --gs-primary: linear-gradient(135deg, #a855f7, #6366f1 55%, #22d3ee);
    }

    .gs-about-page {
        min-height: 100vh;
        color: var(--gs-text);
        background: transparent;
    }

    .gs-kicker {
        font-size: 12px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 1.8px;
        color: #67e8f9;
        margin-bottom: 8px;
    }

    .gs-page-title {
        font-size: clamp(2rem, 4vw, 3.4rem);
        color: #fff;
        letter-spacing: -0.02em;
        margin-bottom: 10px;
        font-family: 'Orbitron', 'Inter', sans-serif;
        background: var(--gs-primary);
        -webkit-background-clip: text;
        background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .gs-page-subtitle {
        color: var(--gs-muted);
        font-size: 1.05rem;
        max-width: 720px;
        margin: 0 auto;
    }

    .gs-about-hero {
        padding: 24px 0 10px;
    }

    .gs-feature-card {
        padding: 32px 24px;
        border-radius: 24px;
        text-align: center;
        background: linear-gradient(180deg, rgba(14, 25, 43, 0.92), rgba(9, 18, 33, 0.92));
        border: 1px solid rgba(255,255,255,0.08);
        box-shadow: 0 20px 45px rgba(0,0,0,0.24);
        transition: transform .28s ease, box-shadow .28s ease, border-color .28s ease;
    }

        .gs-feature-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 28px 55px rgba(0,0,0,0.4), 0 0 0 1px rgba(168,85,247,0.3);
            border-color: rgba(34, 211, 238, 0.3);
        }

    .gs-feature-icon {
        width: 72px;
        height: 72px;
        margin: 0 auto 18px;
        border-radius: 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2rem;
        background: linear-gradient(135deg, rgba(168,85,247,0.18), rgba(34,211,238,0.18));
        border: 1px solid rgba(168,85,247,0.3);
        box-shadow: 0 0 24px rgba(168,85,247,0.25);
    }

    .gs-feature-card h4 {
        color: #fff;
        font-weight: 800;
    }

    .gs-feature-card p {
        color: #cbd5e1;
        line-height: 1.75;
        margin-bottom: 0;
    }

    .gs-about-banner {
        padding: 32px;
        border-radius: 26px;
        background: linear-gradient(135deg, rgba(168, 85, 247, 0.16), rgba(99, 102, 241, 0.16), rgba(34, 211, 238, 0.14));
        border: 1px solid rgba(168,85,247,0.25);
        box-shadow: 0 20px 45px rgba(0,0,0,0.22);
    }

        .gs-about-banner h3 {
            color: #fff;
            font-weight: 800;
            font-family: 'Orbitron','Inter',sans-serif;
        }

    .gs-btn-primary {
        background: var(--gs-primary);
        border: none;
        color: #fff;
        font-weight: 700;
        box-shadow: 0 14px 28px rgba(124, 58, 237, 0.3);
        transition: filter .2s ease, transform .2s ease;
    }

        .gs-btn-primary:hover {
            color: #fff;
            filter: brightness(1.08);
            transform: translateY(-2px);
        }

    @@media (max-width: 575.98px) {
        .gs-feature-card, .gs-about-banner {
            padding: 22px 18px;
        }
    }
</style>
