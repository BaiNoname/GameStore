@model List<GameStore.Models.Game>
@{
    ViewData["Title"] = "Home";
}

@{
    var owned = ViewBag.OwnedGames as List<string> ?? new List<string>();
    var cart = ViewBag.CartGames as List<string> ?? new List<string>();

    var hotGames = ViewBag.HotTop as List<GameStore.Models.Game> ?? new List<GameStore.Models.Game>();
    var newGames = ViewBag.NewGames as List<GameStore.Models.Game> ?? new List<GameStore.Models.Game>();
}

<main class="gs-page">
    <div class="container-xxl">

        <!-- ================= HERO CAROUSEL (HOT TOP 3) ================= -->
        <h4 class="text-light mb-3">🔥 Hot Games</h4>
        <div id="heroCarousel" class="carousel slide mb-5" data-bs-ride="carousel">
            <div class="carousel-inner rounded-4 overflow-hidden">

                @for (int i = 0; i < hotGames.Count; i++)
                {
                    var g = hotGames[i];
                    <div class="carousel-item @(i == 0 ? "active" : "")">

                        <div class="hero-slide">
                            <a asp-controller="Game" asp-action="Detail" asp-route-id="@g.MaGame">
                                <img src="~/images/@g.Hinh" class="w-100 hero-img" />
                            </a>

                            <div class="hero-overlay">
                                <h2>@g.TenGame</h2>
                                <p>@g.MaTheLoai</p>

                                <div class="d-flex gap-2 align-items-center">
                                    <span class="text-warning fw-bold">
                                        @String.Format("{0:N0} VNĐ", g.Gia)
                                    </span>

                                </div>
                                <br />
                                <div class="mb-2 large text-secondary">
                                    👁 <span id="download-@g.MaGame">@g.SoLuotTai</span> lượt mua
                                </div>
                            </div>
                        </div>

                    </div>
                }

            </div>

            <button class="carousel-control-prev" data-bs-target="#heroCarousel" data-bs-slide="prev">
                <span class="carousel-control-prev-icon"></span>
            </button>

            <button class="carousel-control-next" data-bs-target="#heroCarousel" data-bs-slide="next">
                <span class="carousel-control-next-icon"></span>
            </button>
        </div>

        <!-- ================= NEW GAMES SCROLL ================= -->
        <h4 class="text-light mb-3">🆕 New Games</h4>

        <div class="hot-scroll mb-5">
            @foreach (var g in newGames)
            {
                <a class="hot-item" asp-controller="Game" asp-action="Detail" asp-route-id="@g.MaGame">
                    <img src="~/images/@g.Hinh" />
                    <div class="hot-info">
                        <span>@g.TenGame</span>
                        <br />
                        <small class="text-warning">
                            @String.Format("{0:N0}", g.Gia) VNĐ
                        </small>
                        <br />
                        <div class="mb-2 small text-secondary">
                            👁 <span id="download-@g.MaGame">@g.SoLuotTai</span> lượt mua
                        </div>
                    </div>
                </a>
            }
        </div>

        <!-- ================= CATEGORY FILTER ================= -->


        <!-- ================= ALL GAMES ================= -->
        <h3 class="gs-section-title">
            @(ViewBag.CategoryName ?? "All Games")
        </h3>

        <div class="d-flex align-items-center gap-3 flex-wrap">

            <div class="dropdown">
                <button id="categoryBtn" class="btn gs-pill dropdown-toggle" data-bs-toggle="dropdown">
                    Categories
                </button>
                <ul class="dropdown-menu gs-dd">
                    <li>
                        <a class="dropdown-item" href="/Home?category=" data-name="All Games">All</a>
                    </li>
                    @if (ViewBag.Categories != null)
                    {
                        foreach (var c in ViewBag.Categories)
                        {
                            <li>
                                <a class="dropdown-item" href="/home?category=@c.MaTheLoai" data-name="@c.TenLoaiGame">
                                    @c.TenLoaiGame
                                </a>
                            </li>
                        }
                    }
                </ul>
            </div>

            <!-- Search form -->
            <form class="gs-search d-flex ms-auto align-items-center" method="get" action="/home">
                <input class="form-control gs-search-input me-2 flex-grow-1"
                       type="text"
                       name="search"
                       placeholder="Search game..." />
                <button class="btn gs-search-btn" type="submit">
                    Search
                </button>
            </form>
        </div>
        <br />
        <div class="row g-4">

            @foreach (var game in Model)
            {
                <div class="col-12 col-sm-6 col-lg-3">

                    <!-- ===== GIỮ NGUYÊN CARD CỦA BẠN ===== -->
                    <article id="game-@game.MaGame" class="gs-card h-100 shadow rounded-4 overflow-hidden">
                        <div class="row g-0 h-100">

                            <div class="col-12">
                                <div class="gs-media">
                                    <img src="~/images/@game.Hinh"
                                         alt="@game.TenGame"
                                         class="img-fluid w-100 gs-img">
                                </div>
                            </div>

                            <div class="col-12">
                                <div class="gs-card-body d-flex flex-column h-100 p-3">

                                    <span class="badge bg-secondary bg-opacity-75 mb-2 align-self-start">
                                        @game.MaTheLoai
                                    </span>

                                    <h6 class="fw-bold mb-2 game-title text-light">
                                        @game.TenGame
                                    </h6>

                                    <div class="mb-2 small text-secondary">
                                        👁 <span id="download-@game.MaGame">@game.SoLuotTai</span> lượt mua
                                    </div>

                                    <div class="mt-auto pt-2">

                                        <div class="mb-2">
                                            <span class="gs-price text-warning fw-bold">
                                                @String.Format("{0:N0} VNĐ", game.Gia)
                                            </span>
                                        </div>

                                        <div class="d-flex gap-2 flex-wrap">

                                            @if (owned.Contains(game.MaGame))
                                            {
                                                <button class="btn btn-secondary rounded-pill px-3"
                                                        onclick="showToast('Bạn đã sở hữu game này rồi 🎮', 'error')">
                                                    Owned
                                                </button>
                                            }
                                            else if (cart.Contains(game.MaGame))
                                            {
                                                <a asp-controller="Cart"
                                                   asp-action="Index"
                                                   asp-route-gameId="@game.MaGame"
                                                   asp-route-returnUrl="@(Context.Request.Path + Context.Request.QueryString)"
                                                   class="btn btn-warning rounded-pill px-3">
                                                    In Cart
                                                </a>
                                            }
                                            else
                                            {
                                                <a asp-controller="Cart"
                                                   asp-action="Add"
                                                   asp-route-gameId="@game.MaGame"
                                                   asp-route-returnUrl="@(Context.Request.Path + Context.Request.QueryString)"
                                                   asp-route-mode="add"
                                                   class="btn btn-info rounded-pill px-3">
                                                    Add to cart
                                                </a>
                                            }

                                            <a asp-controller="Game"
                                               asp-action="Detail"
                                               asp-route-id="@game.MaGame"
                                               asp-route-returnUrl="@(Context.Request.Path + Context.Request.QueryString)"
                                               class="btn btn-warning rounded-pill px-3">
                                                Detail
                                            </a>

                                        </div>

                                    </div>

                                </div>
                            </div>

                        </div>
                    </article>

                </div>
            }

        </div>

        <!-- ================= PAGINATION ================= -->
        <nav class="mt-4">
            <ul class="pagination justify-content-center">

                <li class="page-item @(ViewBag.CurrentPage == 1 ? "disabled" : "")">
                    <a class="page-link"
                       href="/home?page=@(ViewBag.CurrentPage - 1)&search=@Context.Request.Query["search"]&category=@Context.Request.Query["category"]">
                        Previous
                    </a>
                </li>

                @for (int i = 1; i <= ViewBag.TotalPages; i++)
                {
                    <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                        <a class="page-link"
                           href="/home?page=@i&search=@Context.Request.Query["search"]&category=@Context.Request.Query["category"]">
                            @i
                        </a>
                    </li>
                }

                <li class="page-item @(ViewBag.CurrentPage == ViewBag.TotalPages ? "disabled" : "")">
                    <a class="page-link"
                       href="/home?page=@(ViewBag.CurrentPage + 1)&search=@Context.Request.Query["search"]&category=@Context.Request.Query["category"]">
                        Next
                    </a>
                </li>

            </ul>
        </nav>

    </div>
</main>
<!-- ================= CSS ================= -->
<style>
    .gs-search-input::placeholder {
        color: #aaa; /* hoặc màu sáng/contrast với background */
        opacity: 1; /* đảm bảo hiện */
    }
    .gs-search-btn {
        white-space: nowrap;
    }
    .gs-page {
        background: #0f172a;
        min-height: 100vh;
        padding-bottom: 40px;
    }

    .gs-section-title {
        font-size: 26px;
        font-weight: bold;
        color: #fff;
        margin-bottom: 20px;
    }

    .hero-slide {
        position: relative;
        height: 320px;
    }

    .hero-img {
        height: 100%;
        object-fit: cover;
        filter: brightness(0.6);
    }

    .hero-overlay {
        position: absolute;
        bottom: 20px;
        left: 30px;
        color: white;
        background: linear-gradient(to top, rgba(0,0,0,0.8), transparent);
        padding: 15px;
        border-radius: 10px;
    }

    .gs-card {
        background: #1b2838;
        transition: 0.25s;
    }

        .gs-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 10px 25px rgba(0,0,0,0.5);
        }

    .gs-media {
        height: 160px;
        overflow: hidden;
    }

    .gs-img {
        height: 100%;
        object-fit: cover;
        transition: 0.3s;
    }

    .gs-card:hover .gs-img {
        transform: scale(1.05);
    }

    .game-title {
        min-height: 40px;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .gs-card-body {
        display: flex;
        flex-direction: column;
        height: 100%;
        background: linear-gradient(180deg, #0f1b2a, #0b1622);
    }

    .hot-scroll {
        display: flex;
        gap: 12px;
        overflow-x: auto;
    }

    .hot-item {
        min-width: 180px;
        background: #1b2838;
        border-radius: 12px;
        overflow: hidden;
        transition: 0.2s;
        cursor: pointer;
    }

        .hot-item:hover {
            transform: translateY(-5px) scale(1.05);
        }

        .hot-item img {
            width: 100%;
            height: 100px;
            object-fit: cover;
        }

    .hot-info {
        padding: 8px;
        font-size: 13px;
    }

    .pagination .page-link {
        background: #1b2838;
        color: #c7d5e0;
        border: 1px solid #2a475e;
    }

        .pagination .page-link:hover {
            background: #2a475e;
            color: #fff;
        }

    .pagination .page-item.active .page-link {
        background: #0d6efd;
        color: #fff;
    }
</style>

<!-- ================= SIGNALR ================= -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>

<script>
    const connection = new signalR.HubConnectionBuilder()
        .withUrl("/gameHub")
        .build();

    connection.start().then(function () {
        console.log("Connected to GameHub");
    }).catch(err => console.error(err));

    connection.on("UpdateDownload", function (gameId, count) {
        console.log("RECEIVED:", gameId, count);

        const el = document.getElementById("download-" + gameId);
        if (el) {
            el.innerText = count;
        }
    });
</script>