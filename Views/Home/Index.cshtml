@model List<GameStore.Models.Game>
@{
    ViewData["Title"] = "Home";
}

@{
    var owned = ViewBag.OwnedGames as List<string> ?? new List<string>();
    var cart = ViewBag.CartGames as List<string> ?? new List<string>();
}

<!-- Main -->
<main class="gs-page">
    <div class="container-xxl">
        <h2 class="gs-section-title">
            @(ViewBag.CategoryName ?? "All Games")
        </h2>

        <!-- Featured cards -->
        <div class="gs-featured">

            @foreach (var game in Model)
            {
                <article id="game-@game.MaGame" class="gs-card mb-4 shadow rounded-4 overflow-hidden">
                    <div class="row g-0 align-items-stretch">

                        <!-- Hình game -->
                        <div class="col-12 col-lg-7">
                            <div class="gs-media">
                                <img src="~/images/@game.Hinh"
                                     alt="@game.TenGame"
                                     class="img-fluid w-100 gs-img">
                            </div>
                        </div>

                        <!-- Thông tin -->
                        <div class="col-12 col-lg-5">
                            <div class="gs-card-body d-flex flex-column h-100 p-4">

                                <span class="badge bg-dark text-light mb-2">
                                    @game.MaTheLoai
                                </span>

                                <h3 class="gs-card-title fw-bold mb-2 text-center">
                                    @game.TenGame
                                </h3>

                                <div class="mb-3 text-center">
                                    <div>
                                        <strong>Mã game:</strong> @game.MaGame
                                    </div>
                                    <div>
                                        <strong>Lượt tải:</strong>
                                        <span id="download-@game.MaGame">
                                            @game.SoLuotTai
                                        </span>
                                    </div>
                                </div>

                                <div class="mt-auto d-flex justify-content-between align-items-center">

                                    <!-- Giá -->
                                    <span class="gs-price text-warning fw-bold fs-5">
                                        @String.Format("{0:N0} VNĐ", game.Gia)
                                    </span>
                                    <!-- Nút Buy-->
                                    @if (owned.Contains(game.MaGame))
                                    {
                                        <button class="btn btn-secondary rounded-pill px-4" onclick="return alert(`U bought this game Bro !!!`)">
                                            Owned
                                        </button>
                                    }
                                    else if (cart.Contains(game.MaGame))
                                    {
           
                                        <a asp-controller="Cart"
                                           asp-action="Index"
                                           asp-route-focus="@game.MaGame"
                                           class="btn btn-warning rounded-pill px-4">
                                            In Cart
                                        </a>
                                    }
                                    else
                                    {
                
                                        <a asp-controller="Cart"
                                           asp-action="Add"
                                           asp-route-gameId="@game.MaGame"
                                           asp-route-returnUrl="@Context.Request.Path@Context.Request.QueryString"
                                           class="btn btn-info rounded-pill px-4">
                                            Add to cart
                                        </a>
                                    }
                                    <!-- Nút -->
                                    <a asp-controller="Game"
                                       asp-action="Detail"
                                       asp-route-id="@game.MaGame"
                                       asp-route-returnUrl="@Context.Request.Path@Context.Request.QueryString"
                                       class="btn btn-warning rounded-pill px-4">
                                        Detail
                                    </a>

                                </div>

                            </div>
                        </div>

                    </div>
                </article>
            }

            @* màu cho phân trang *@
            <style>
                /* Pagination dark style */

                .pagination .page-link {
                    background: #1b2838;
                    color: #c7d5e0;
                    border: 1px solid #2a475e;
                }

                    .pagination .page-link:hover {
                        background: #2a475e;
                        color: #fff;
                    }

                .pagination .page-item.active .page-link {
                    background: #0d6efd;
                    border-color: #0d6efd;
                    color: #fff;
                }

                .pagination .page-item.disabled .page-link {
                    background: #0f172a;
                    color: #64748b;
                }

            </style>
            <nav class="mt-4">
                <ul class="pagination justify-content-center">

                    <!-- Previous -->
                    <li class="page-item @(ViewBag.CurrentPage == 1 ? "disabled" : "")">
                        <a class="page-link"
                           href="/home?page=@(ViewBag.CurrentPage - 1)&search=@Context.Request.Query["search"]&category=@Context.Request.Query["category"]&type=@Context.Request.Query["type"]">
                            Previous
                        </a>
                    </li>

                    @for (int i = 1; i <= ViewBag.TotalPages; i++)
                    {
                        <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                            <a class="page-link"
                               href="/home?page=@i&search=@Context.Request.Query["search"]&category=@Context.Request.Query["category"]&type=@Context.Request.Query["type"]">
                                @i
                            </a>
                        </li>
                    }

                    <!-- Next -->
                    <li class="page-item @(ViewBag.CurrentPage == ViewBag.TotalPages ? "disabled" : "")">
                        <a class="page-link"
                           href="/home?page=@(ViewBag.CurrentPage + 1)&search=@Context.Request.Query["search"]&category=@Context.Request.Query["category"]&type=@Context.Request.Query["type"]">
                            Next
                        </a>
                    </li>

                </ul>
            </nav>

        </div>
    </div>
</main>
<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>

<script>
        const connection = new signalR.HubConnectionBuilder()
        .withUrl("/gameHub")
        .build();

    connection.start().then(function () {
        console.log("Connected to GameHub");
    }).catch(err => console.error(err));

    connection.on("UpdateDownload", function (gameId, count) {
        console.log("RECEIVED:", gameId, count);

        const el = document.getElementById("download-" + gameId);
        if (el) {
            el.innerText = count;
        }
    });
</script>

