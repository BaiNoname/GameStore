@{
    ViewData["Title"] = "News";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>GameStore News</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Orbitron:wght@600;700&display=swap" rel="stylesheet" />

    <style>
        :root {
            --gs-bg: #07111f;
            --gs-bg-2: #0b1728;
            --gs-card: rgba(14, 25, 43, 0.88);
            --gs-line: rgba(255,255,255,0.08);
            --gs-text: #f3f7ff;
            --gs-muted: #94a3b8;
            --gs-primary: linear-gradient(135deg, #7c3aed, #2563eb 55%, #06b6d4);
            --gs-accent: #7dd3fc;
            --gs-hot: #f59e0b;
        }

        * {
            font-family: 'Inter', sans-serif;
        }

        body {
            background: radial-gradient(circle at top left, rgba(124, 58, 237, 0.18), transparent 24%), radial-gradient(circle at top right, rgba(37, 99, 235, 0.14), transparent 22%), linear-gradient(180deg, #050b16 0%, #07111f 40%, #091626 100%);
            color: var(--gs-text);
            min-height: 100vh;
        }

        a {
            text-decoration: none;
            color: inherit;
        }

        .gs-page {
            padding: 48px 0 70px;
        }

        .gs-kicker {
            font-size: 12px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1.8px;
            color: var(--gs-accent);
            margin-bottom: 8px;
        }

        .gs-title {
            font-size: clamp(2rem, 4vw, 3.2rem);
            font-weight: 800;
            letter-spacing: -0.03em;
            color: #fff;
            margin-bottom: 10px;
        }

        .gs-subtitle {
            color: var(--gs-muted);
            max-width: 760px;
            margin-bottom: 0;
        }

        .gs-pillbar {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
            margin: 28px 0 36px;
        }

        .gs-pill {
            border: 1px solid rgba(255,255,255,0.10);
            background: rgba(255,255,255,0.05);
            color: #e2e8f0;
            border-radius: 999px;
            padding: 10px 18px;
            font-weight: 600;
            transition: .25s ease;
        }

            .gs-pill.active,
            .gs-pill:hover {
                background: var(--gs-primary);
                color: #fff;
                border-color: transparent;
            }

        .gs-feature-wrap {
            margin-bottom: 42px;
        }

        .gs-feature-main,
        .gs-feature-side-card,
        .gs-news-card,
        .gs-trending-card,
        .gs-cta-box {
            background: linear-gradient(180deg, rgba(14,25,43,0.94), rgba(9,18,33,0.94));
            border: 1px solid var(--gs-line);
            border-radius: 28px;
            box-shadow: 0 20px 45px rgba(0,0,0,0.24);
            overflow: hidden;
        }

        .gs-feature-main {
            height: 100%;
        }

        .gs-feature-image-wrap {
            position: relative;
            min-height: 420px;
            overflow: hidden;
        }

            .gs-feature-image-wrap img {
                width: 100%;
                height: 100%;
                min-height: 420px;
                object-fit: cover;
                display: block;
                filter: brightness(0.62);
                transition: transform .4s ease;
            }

        .gs-feature-main:hover img {
            transform: scale(1.04);
        }

        .gs-feature-overlay {
            position: absolute;
            inset: 0;
            background: linear-gradient(180deg, rgba(2,6,23,0.05) 0%, rgba(2,6,23,0.32) 40%, rgba(2,6,23,0.90) 100%);
            display: flex;
            align-items: end;
            padding: 28px;
        }

        .gs-badge {
            display: inline-flex;
            align-items: center;
            padding: 7px 12px;
            border-radius: 999px;
            font-size: 12px;
            font-weight: 700;
            border: 1px solid rgba(255,255,255,0.12);
            background: rgba(15,23,42,0.72);
            color: #fff;
            margin-bottom: 14px;
        }

            .gs-badge.hot {
                color: #fbbf24;
                background: rgba(245, 158, 11, 0.14);
                border-color: rgba(245, 158, 11, 0.18);
            }

        .gs-feature-title {
            font-family: 'Orbitron', sans-serif;
            font-size: clamp(1.8rem, 3vw, 2.7rem);
            line-height: 1.14;
            margin-bottom: 14px;
            color: #fff;
        }

        .gs-feature-desc {
            color: #dbe6f7;
            line-height: 1.75;
            max-width: 760px;
            margin-bottom: 18px;
        }

        .gs-meta {
            display: flex;
            gap: 16px;
            flex-wrap: wrap;
            color: #a9b7c9;
            font-size: .95rem;
            margin-bottom: 18px;
        }

        .gs-btn-primary {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-height: 46px;
            padding: 0 20px;
            border-radius: 999px;
            background: var(--gs-primary);
            color: #fff;
            font-weight: 700;
            border: none;
            box-shadow: 0 14px 28px rgba(37, 99, 235, 0.25);
        }

            .gs-btn-primary:hover {
                color: #fff;
            }

        .gs-feature-side-card {
            display: flex;
            gap: 14px;
            padding: 14px;
            height: 100%;
            transition: .25s ease;
        }

            .gs-feature-side-card:hover,
            .gs-news-card:hover,
            .gs-trending-card:hover {
                transform: translateY(-6px);
                box-shadow: 0 26px 48px rgba(0,0,0,0.32);
            }

            .gs-feature-side-card img {
                width: 130px;
                height: 110px;
                object-fit: cover;
                border-radius: 18px;
                flex-shrink: 0;
            }

        .gs-feature-side-title {
            font-weight: 800;
            color: #fff;
            line-height: 1.4;
            margin-bottom: 10px;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }

        .gs-section-title {
            font-size: clamp(1.4rem, 2vw, 2rem);
            font-weight: 800;
            color: #fff;
            margin-bottom: 6px;
        }

        .gs-section-subtitle {
            color: var(--gs-muted);
            margin-bottom: 24px;
        }

        .gs-news-card img {
            width: 100%;
            height: 220px;
            object-fit: cover;
            display: block;
        }

        .gs-news-body {
            padding: 20px;
        }

        .gs-news-title {
            font-weight: 800;
            color: #fff;
            line-height: 1.45;
            margin-bottom: 10px;
            min-height: 52px;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }

        .gs-news-desc {
            color: #cbd5e1;
            line-height: 1.7;
            margin-bottom: 14px;
            min-height: 72px;
            display: -webkit-box;
            -webkit-line-clamp: 3;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }

        .gs-readmore {
            color: var(--gs-accent);
            font-weight: 700;
        }

        .gs-trending-card {
            display: flex;
            gap: 14px;
            padding: 14px;
            margin-bottom: 14px;
        }

            .gs-trending-card img {
                width: 110px;
                height: 90px;
                border-radius: 16px;
                object-fit: cover;
                flex-shrink: 0;
            }

        .gs-trending-title {
            color: #fff;
            font-weight: 700;
            line-height: 1.45;
            margin-bottom: 8px;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }

        .gs-cta-box {
            padding: 30px;
            background: linear-gradient(135deg, rgba(124,58,237,0.16), rgba(37,99,235,0.16), rgba(6,182,212,0.10));
        }

            .gs-cta-box h3 {
                font-weight: 800;
                color: #fff;
                margin-bottom: 10px;
            }

            .gs-cta-box p {
                color: #dbe6f7;
                margin-bottom: 0;
                line-height: 1.7;
            }

        @@media (max-width: 991.98px) {
            .gs-feature-image-wrap, .gs-feature-image-wrap img

        {
            min-height: 320px;
        }

        }

        @@media (max-width: 575.98px) {
            .gs-page

        {
            padding: 30px 0 50px;
        }

        .gs-feature-overlay,
        .gs-news-body,
        .gs-cta-box {
            padding: 18px;
        }

        .gs-feature-side-card {
            flex-direction: column;
        }

            .gs-feature-side-card img,
            .gs-trending-card img {
                width: 100%;
                height: 180px;
            }

        .gs-trending-card {
            flex-direction: column;
        }

        }
    </style>
</head>
<body>
    <main class="gs-page">
        <div class="container-xxl">
            <div class="mb-4">
                <div class="gs-kicker">Editorial Hub</div>
                <h1 class="gs-title">GameStore News</h1>
                <p class="gs-subtitle">
                    Cập nhật những tin tức nóng nhất về game mới, bản vá, sự kiện cộng đồng và các bài viết nổi bật từ GameStore.
                </p>
            </div>

            <div class="gs-pillbar">
                <a href="#" class="gs-pill active">All</a>
                <a href="#" class="gs-pill">Updates</a>
                <a href="#" class="gs-pill">Events</a>
                <a href="#" class="gs-pill">Releases</a>
                <a href="#" class="gs-pill">Community</a>
                <a href="#" class="gs-pill">Patch Notes</a>
            </div>

            <section class="gs-feature-wrap">
                <div class="row g-4">
                    <div class="col-lg-8">
                        <article class="gs-feature-main">
                            <div class="gs-feature-image-wrap">
                                <img src="https://images.unsplash.com/photo-1542751371-adc38448a05e?auto=format&fit=crop&w=1600&q=80" alt="Featured News">
                                <div class="gs-feature-overlay">
                                    <div>
                                        <span class="gs-badge hot">HOT NEWS</span>
                                        <h2 class="gs-feature-title">Cyber Arcane Season Update brings new maps, ranked rewards and live events</h2>
                                        <p class="gs-feature-desc">
                                            Khám phá bản cập nhật mùa giải mới với chế độ chơi nâng cấp, phần thưởng độc quyền và chuỗi hoạt động cộng đồng kéo dài suốt tháng này.
                                        </p>
                                        <div class="gs-meta">
                                            <span>📅 16 Apr 2026</span>
                                            <span>📰 GameStore Editorial</span>
                                            <span>⏱ 5 min read</span>
                                        </div>
                                        <a href="#" class="gs-btn-primary">Read More</a>
                                    </div>
                                </div>
                            </div>
                        </article>
                    </div>

                    <div class="col-lg-4">
                        <div class="row g-4 h-100">
                            <div class="col-12">
                                <article class="gs-feature-side-card">
                                    <img src="https://images.unsplash.com/photo-1511512578047-dfb367046420?auto=format&fit=crop&w=800&q=80" alt="">
                                    <div>
                                        <span class="gs-badge">PATCH NOTE</span>
                                        <div class="gs-feature-side-title">Version 2.4 patch note released with balance changes and bug fixes</div>
                                        <div class="gs-meta mb-0">
                                            <span>14 Apr 2026</span>
                                        </div>
                                    </div>
                                </article>
                            </div>

                            <div class="col-12">
                                <article class="gs-feature-side-card">
                                    <img src="https://images.unsplash.com/photo-1493711662062-fa541adb3fc8?auto=format&fit=crop&w=800&q=80" alt="">
                                    <div>
                                        <span class="gs-badge">COMMUNITY</span>
                                        <div class="gs-feature-side-title">Top community creations this week you should not miss</div>
                                        <div class="gs-meta mb-0">
                                            <span>12 Apr 2026</span>
                                        </div>
                                    </div>
                                </article>
                            </div>

                            <div class="col-12">
                                <article class="gs-feature-side-card">
                                    <img src="https://images.unsplash.com/photo-1511882150382-421056c89033?auto=format&fit=crop&w=800&q=80" alt="">
                                    <div>
                                        <span class="gs-badge">RELEASE</span>
                                        <div class="gs-feature-side-title">Neon Arena launch date confirmed with founder pack bonus</div>
                                        <div class="gs-meta mb-0">
                                            <span>10 Apr 2026</span>
                                        </div>
                                    </div>
                                </article>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <section class="mb-5">
                <div class="row align-items-end mb-3">
                    <div class="col-lg-8">
                        <h3 class="gs-section-title">Latest News</h3>
                        <p class="gs-section-subtitle">Những bài viết mới nhất từ hệ thống GameStore.</p>
                    </div>
                </div>

                <div class="row g-4">
                    <div class="col-md-6 col-xl-4">
                        <article class="gs-news-card h-100">
                            <img src="https://images.unsplash.com/photo-1511512578047-dfb367046420?auto=format&fit=crop&w=1200&q=80" alt="">
                            <div class="gs-news-body">
                                <span class="gs-badge">UPDATE</span>
                                <div class="gs-news-title">Major PvP system update is now live for ranked players</div>
                                <div class="gs-news-desc">Bản cập nhật cải thiện hệ thống xếp hạng, matchmaking và phần thưởng mùa giải cho game thủ cạnh tranh.</div>
                                <div class="gs-meta">
                                    <span>15 Apr 2026</span>
                                    <span>4 min read</span>
                                </div>
                                <a href="#" class="gs-readmore">Read Article →</a>
                            </div>
                        </article>
                    </div>

                    <div class="col-md-6 col-xl-4">
                        <article class="gs-news-card h-100">
                            <img src="https://images.unsplash.com/photo-1493711662062-fa541adb3fc8?auto=format&fit=crop&w=1200&q=80" alt="">
                            <div class="gs-news-body">
                                <span class="gs-badge">EVENT</span>
                                <div class="gs-news-title">Spring Festival begins with exclusive missions and reward crates</div>
                                <div class="gs-news-desc">Chuỗi sự kiện mùa xuân đã chính thức mở với nhiệm vụ giới hạn thời gian và phần quà đặc biệt theo tuần.</div>
                                <div class="gs-meta">
                                    <span>13 Apr 2026</span>
                                    <span>6 min read</span>
                                </div>
                                <a href="#" class="gs-readmore">Read Article →</a>
                            </div>
                        </article>
                    </div>

                    <div class="col-md-6 col-xl-4">
                        <article class="gs-news-card h-100">
                            <img src="https://images.unsplash.com/photo-1511882150382-421056c89033?auto=format&fit=crop&w=1200&q=80" alt="">
                            <div class="gs-news-body">
                                <span class="gs-badge">RELEASE</span>
                                <div class="gs-news-title">Kingdom Fall opens pre-download and reveals full release roadmap</div>
                                <div class="gs-news-desc">Người chơi hiện đã có thể preload game và xem lịch ra mắt nội dung sau phát hành trong 3 tháng đầu.</div>
                                <div class="gs-meta">
                                    <span>11 Apr 2026</span>
                                    <span>5 min read</span>
                                </div>
                                <a href="#" class="gs-readmore">Read Article →</a>
                            </div>
                        </article>
                    </div>

                    <div class="col-md-6 col-xl-4">
                        <article class="gs-news-card h-100">
                            <img src="https://images.unsplash.com/photo-1542751371-adc38448a05e?auto=format&fit=crop&w=1200&q=80" alt="">
                            <div class="gs-news-body">
                                <span class="gs-badge">COMMUNITY</span>
                                <div class="gs-news-title">Community spotlight: top streamers and creators of the week</div>
                                <div class="gs-news-desc">Tổng hợp những creator nổi bật nhất trong tuần cùng các nội dung sáng tạo được cộng đồng yêu thích.</div>
                                <div class="gs-meta">
                                    <span>09 Apr 2026</span>
                                    <span>3 min read</span>
                                </div>
                                <a href="#" class="gs-readmore">Read Article →</a>
                            </div>
                        </article>
                    </div>

                    <div class="col-md-6 col-xl-4">
                        <article class="gs-news-card h-100">
                            <img src="https://images.unsplash.com/photo-1511512578047-dfb367046420?auto=format&fit=crop&w=1200&q=80" alt="">
                            <div class="gs-news-body">
                                <span class="gs-badge">PATCH NOTE</span>
                                <div class="gs-news-title">Bug fix rollout improves performance for mid-range devices</div>
                                <div class="gs-news-desc">Đợt sửa lỗi mới tập trung tối ưu hiệu suất, độ ổn định và giảm thời gian tải trong nhiều chế độ chơi.</div>
                                <div class="gs-meta">
                                    <span>08 Apr 2026</span>
                                    <span>4 min read</span>
                                </div>
                                <a href="#" class="gs-readmore">Read Article →</a>
                            </div>
                        </article>
                    </div>

                    <div class="col-md-6 col-xl-4">
                        <article class="gs-news-card h-100">
                            <img src="https://images.unsplash.com/photo-1493711662062-fa541adb3fc8?auto=format&fit=crop&w=1200&q=80" alt="">
                            <div class="gs-news-body">
                                <span class="gs-badge">EDITORIAL</span>
                                <div class="gs-news-title">How modern game stores are improving player discovery experience</div>
                                <div class="gs-news-desc">Phân tích cách các nền tảng game hiện đại cải thiện trải nghiệm khám phá trò chơi thông qua UI và AI.</div>
                                <div class="gs-meta">
                                    <span>07 Apr 2026</span>
                                    <span>7 min read</span>
                                </div>
                                <a href="#" class="gs-readmore">Read Article →</a>
                            </div>
                        </article>
                    </div>
                </div>
            </section>

            <section class="mb-5">
                <div class="row">
                    <div class="col-lg-8">
                        <h3 class="gs-section-title">Trending This Week</h3>
                        <p class="gs-section-subtitle">Các bài viết được quan tâm nhiều nhất trong tuần.</p>
                    </div>
                </div>

                <div class="row g-4">
                    <div class="col-lg-6">
                        <article class="gs-trending-card">
                            <img src="https://images.unsplash.com/photo-1542751371-adc38448a05e?auto=format&fit=crop&w=900&q=80" alt="">
                            <div>
                                <span class="gs-badge">TRENDING</span>
                                <div class="gs-trending-title">Cyber Arcane breaks concurrent player milestone after latest update</div>
                                <div class="gs-meta mb-0"><span>16 Apr 2026</span></div>
                            </div>
                        </article>

                        <article class="gs-trending-card">
                            <img src="https://images.unsplash.com/photo-1511512578047-dfb367046420?auto=format&fit=crop&w=900&q=80" alt="">
                            <div>
                                <span class="gs-badge">NEWS</span>
                                <div class="gs-trending-title">New stealth-action title announced with gameplay reveal trailer</div>
                                <div class="gs-meta mb-0"><span>14 Apr 2026</span></div>
                            </div>
                        </article>
                    </div>

                    <div class="col-lg-6">
                        <article class="gs-trending-card">
                            <img src="https://images.unsplash.com/photo-1493711662062-fa541adb3fc8?auto=format&fit=crop&w=900&q=80" alt="">
                            <div>
                                <span class="gs-badge">COMMUNITY</span>
                                <div class="gs-trending-title">This week’s best fan art, mods and custom game moments</div>
                                <div class="gs-meta mb-0"><span>13 Apr 2026</span></div>
                            </div>
                        </article>

                        <article class="gs-trending-card">
                            <img src="https://images.unsplash.com/photo-1511882150382-421056c89033?auto=format&fit=crop&w=900&q=80" alt="">
                            <div>
                                <span class="gs-badge">PATCH</span>
                                <div class="gs-trending-title">Server maintenance roadmap and ranked rewards timeline published</div>
                                <div class="gs-meta mb-0"><span>12 Apr 2026</span></div>
                            </div>
                        </article>
                    </div>
                </div>
            </section>

            <section class="gs-cta-box">
                <div class="row align-items-center g-4">
                    <div class="col-lg-8">
                        <div class="gs-kicker">Stay Updated</div>
                        <h3>Never miss the next big update</h3>
                        <p>The latest game releases, event highlights and patch notes — all in one place for your community.</p>
                    </div>
                    <div class="col-lg-4 text-lg-end">
                        <a href="#" class="gs-btn-primary">Explore More News</a>
                    </div>
                </div>
            </section>
        </div>
    </main>
</body>
</html>