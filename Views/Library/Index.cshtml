@model List<GameStore.Models.ThuVienGame>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "My Library";
}

<div class="container mt-5">

    <h2 class="mb-4 text-light">🎮 My Library</h2>

    @if (Model == null || Model.Count == 0)
    {
        <div class="alert alert-info">
            Bạn chưa sở hữu game nào 😢
        </div>

        <a asp-controller="Home"
           asp-action="Index"
           class="btn btn-primary">
            ← Back to Store
        </a>
    }
    else
    {
        <table class="table table-dark table-hover align-middle">

            <thead>
                <tr>
                    <th>Game</th>
                    <th>Purchased</th>
                    <th>Status</th>
                    <th>Action</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <!-- GAME -->
                        <td class="d-flex align-items-center gap-3">
                            <img src="@Url.Content("~/images/" + item.Game.Hinh)"
                                 width="100"
                                 style="border-radius:8px;" />

                            <span>@item.Game.TenGame</span>
                        </td>

                        <!-- DATE -->
                        <td>
                            @item.NgayMua.ToString("dd/MM/yyyy")
                        </td>

                        <!-- STATUS -->
                        <td>
                            @if (item.DaTai)
                            {
                                <span class="badge bg-success">Installed</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Not Installed</span>
                            }
                        </td>

                        <!-- ACTION -->
                        <td>
                            @if (item.DaTai)
                            {
                                <a asp-controller="Library"
                                   asp-action="Download"
                                   asp-route-id="@item.MaGame"
                                   class="btn btn-success btn-sm">
                                    🎮 Download
                                </a>
                            }
                            else
                            {
                                <a asp-controller="Library"
                                   asp-action="Download"
                                   asp-route-id="@item.MaGame"
                                   class="btn btn-primary btn-sm">
                                    ⬇ Download
                                </a>
                            }
                        </td>
                    </tr>
                }
            </tbody>

        </table>
        <a asp-controller="Home"
           asp-action="Index"
           class="btn btn-primary">
            ← Back to Store
        </a>
    }

</div>