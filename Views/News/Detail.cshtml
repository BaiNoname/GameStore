@model GameStore.Models.News

@{
    ViewData["Title"] = Model.Title;

    var trendingNews = ViewBag.TrendingNews as List<GameStore.Models.News> ?? new List<GameStore.Models.News>();
    var latestNews = ViewBag.LatestNews as List<GameStore.Models.News> ?? new List<GameStore.Models.News>();

    string GetImage(string? image)
    {
        if (string.IsNullOrWhiteSpace(image))
            return "https://images.unsplash.com/photo-1542751371-adc38448a05e?auto=format&fit=crop&w=1600&q=80";

        if (image.StartsWith("http://") || image.StartsWith("https://"))
            return image;

        return Url.Content("~/images/news/" + image);
    }

    string GetAuthor()
    {
        return Model.NguoiDung?.TenNguoiDung
               ?? Model.NguoiDung?.Email
               ?? "GameStore Editorial";
    }

    string GetGameName(GameStore.Models.News item)
    {
        return item.Game?.TenGame ?? "GameStore";
    }

    string GetBadgeClass(string? type)
    {
        return type == "Hot" ? "gs-badge hot" : "gs-badge";
    }

    string GetDisplayType(string? type)
    {
        return string.IsNullOrWhiteSpace(type) ? "NEWS" : type!.ToUpper();
    }

    string GetReadTime(GameStore.Models.News item)
    {
        var text = (item.Content ?? "").Trim();
        if (string.IsNullOrWhiteSpace(text)) return "1 min read";

        var words = text.Split(' ', StringSplitOptions.RemoveEmptyEntries).Length;
        var mins = Math.Max(1, (int)Math.Ceiling(words / 180.0));
        return $"{mins} min read";
    }

    string FormatContent(string? content)
    {
        if (string.IsNullOrWhiteSpace(content))
            return "<p>Nội dung đang được cập nhật.</p>";

        var encoded = System.Net.WebUtility.HtmlEncode(content);
        encoded = encoded.Replace("\r\n", "\n").Replace("\n\n", "</p><p>").Replace("\n", "<br />");
        return $"<p>{encoded}</p>";
    }
}

<main class="gs-page">
    <div class="container-xxl">
        <div class="row g-4">
            <div class="col-lg-8">
                <article class="gs-article-card">
                    <div class="gs-breadcrumb mb-3">
                        <a href="/">Home</a>
                        <span>/</span>
                        <a href="/news">News</a>
                        <span>/</span>
                        <span class="active">@Model.Title</span>
                    </div>

                    <div class="mb-3">
                        <span class="@GetBadgeClass(Model.NewsType)">@GetDisplayType(Model.NewsType)</span>
                    </div>

                    <h1 class="gs-article-title">@Model.Title</h1>

                    <div class="gs-meta mb-4">
                        <span>📅 @Model.PublishedAt.ToString("dd MMM yyyy")</span>
                        <span>📰 @GetAuthor()</span>
                        <span>🎮 @GetGameName(Model)</span>
                        <span>👁 @Model.ViewCount lượt xem</span>
                        <span>⏱ @GetReadTime(Model)</span>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(Model.Summary))
                    {
                        <div class="gs-summary-box">
                            @Model.Summary
                        </div>
                    }

                    <div class="gs-hero-image-wrap mb-4">
                        <img src="@GetImage(Model.Thumbnail)" alt="@Model.Title" class="gs-hero-image" />
                    </div>

                    <div class="gs-article-content">
                        @Html.Raw(FormatContent(Model.Content))
                    </div>

                    <div class="gs-article-footer mt-4">
                        <a href="/news" class="gs-btn-primary">← Back to News</a>
                    </div>
                </article>
            </div>

            <div class="col-lg-4">
                <div class="gs-side-panel mb-4">
                    <div class="gs-kicker">Trending</div>
                    <h3 class="gs-side-title">Trending This Week</h3>

                    @if (trendingNews.Any())
                    {
                        @foreach (var item in trendingNews.Where(x => x.NewsId != Model.NewsId).Take(4))
                        {
                            <a href="/news/detail/@item.Slug">
                                <article class="gs-side-card">
                                    <img src="@GetImage(item.Thumbnail)" alt="@item.Title" />
                                    <div>
                                        <span class="gs-badge">TRENDING</span>
                                        <div class="gs-side-card-title">@item.Title</div>
                                        <div class="gs-side-meta">@item.PublishedAt.ToString("dd MMM yyyy")</div>
                                    </div>
                                </article>
                            </a>
                        }
                    }
                    else
                    {
                        <p class="gs-empty-text">Chưa có bài viết nổi bật.</p>
                    }
                </div>

                <div class="gs-side-panel">
                    <div class="gs-kicker">Latest</div>
                    <h3 class="gs-side-title">Latest Articles</h3>

                    @if (latestNews.Any())
                    {
                        @foreach (var item in latestNews.Where(x => x.NewsId != Model.NewsId).Take(4))
                        {
                            <a href="/news/detail/@item.Slug">
                                <article class="gs-side-card">
                                    <img src="@GetImage(item.Thumbnail)" alt="@item.Title" />
                                    <div>
                                        <span class="@GetBadgeClass(item.NewsType)">@GetDisplayType(item.NewsType)</span>
                                        <div class="gs-side-card-title">@item.Title</div>
                                        <div class="gs-side-meta">@item.PublishedAt.ToString("dd MMM yyyy")</div>
                                    </div>
                                </article>
                            </a>
                        }
                    }
                    else
                    {
                        <p class="gs-empty-text">Chưa có bài viết mới.</p>
                    }
                </div>
            </div>
        </div>
    </div>
</main>

<style>
    :root {
        --gs-bg: #07111f;
        --gs-bg-2: #0b1728;
        --gs-card: rgba(14, 25, 43, 0.88);
        --gs-line: rgba(255,255,255,0.08);
        --gs-text: #f3f7ff;
        --gs-muted: #94a3b8;
        --gs-primary: linear-gradient(135deg, #7c3aed, #2563eb 55%, #06b6d4);
        --gs-accent: #7dd3fc;
        --gs-hot: #f59e0b;
    }

    * {
        font-family: 'Inter', sans-serif;
    }

    body {
        background: radial-gradient(circle at top left, rgba(124, 58, 237, 0.18), transparent 24%), radial-gradient(circle at top right, rgba(37, 99, 235, 0.14), transparent 22%), linear-gradient(180deg, #050b16 0%, #07111f 40%, #091626 100%);
        color: var(--gs-text);
        min-height: 100vh;
    }

    a {
        text-decoration: none;
        color: inherit;
    }

    .gs-page {
        padding: 48px 0 70px;
    }

    .gs-breadcrumb {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
        color: var(--gs-muted);
        font-size: 0.95rem;
    }

        .gs-breadcrumb a:hover {
            color: #fff;
        }

        .gs-breadcrumb .active {
            color: #fff;
        }

    .gs-kicker {
        font-size: 12px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 1.8px;
        color: var(--gs-accent);
        margin-bottom: 8px;
    }

    .gs-article-card,
    .gs-side-panel,
    .gs-side-card,
    .gs-summary-box {
        background: linear-gradient(180deg, rgba(14,25,43,0.94), rgba(9,18,33,0.94));
        border: 1px solid var(--gs-line);
        border-radius: 28px;
        box-shadow: 0 20px 45px rgba(0,0,0,0.24);
    }

    .gs-article-card {
        padding: 28px;
    }

    .gs-article-title {
        font-family: 'Orbitron', sans-serif;
        font-size: clamp(2rem, 4vw, 3rem);
        line-height: 1.15;
        color: #fff;
        margin-bottom: 18px;
    }

    .gs-meta {
        display: flex;
        gap: 16px;
        flex-wrap: wrap;
        color: #a9b7c9;
        font-size: .95rem;
    }

    .gs-badge {
        display: inline-flex;
        align-items: center;
        padding: 7px 12px;
        border-radius: 999px;
        font-size: 12px;
        font-weight: 700;
        border: 1px solid rgba(255,255,255,0.12);
        background: rgba(15,23,42,0.72);
        color: #fff;
        margin-bottom: 14px;
    }

        .gs-badge.hot {
            color: #fbbf24;
            background: rgba(245, 158, 11, 0.14);
            border-color: rgba(245, 158, 11, 0.18);
        }

    .gs-summary-box {
        padding: 18px 20px;
        color: #dbe6f7;
        line-height: 1.75;
        margin-bottom: 22px;
        border-radius: 22px;
    }

    .gs-hero-image-wrap {
        overflow: hidden;
        border-radius: 24px;
        border: 1px solid rgba(255,255,255,0.08);
    }

    .gs-hero-image {
        width: 100%;
        min-height: 360px;
        max-height: 520px;
        object-fit: cover;
        display: block;
    }

    .gs-article-content {
        color: #dbe6f7;
        line-height: 1.9;
        font-size: 1rem;
    }

        .gs-article-content p {
            margin-bottom: 1rem;
        }

    .gs-btn-primary {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 46px;
        padding: 0 20px;
        border-radius: 999px;
        background: var(--gs-primary);
        color: #fff;
        font-weight: 700;
        border: none;
        box-shadow: 0 14px 28px rgba(37, 99, 235, 0.25);
    }

        .gs-btn-primary:hover {
            color: #fff;
        }

    .gs-side-panel {
        padding: 22px;
    }

    .gs-side-title {
        font-size: 1.35rem;
        font-weight: 800;
        color: #fff;
        margin-bottom: 18px;
    }

    .gs-side-card {
        display: flex;
        gap: 14px;
        padding: 14px;
        margin-bottom: 14px;
        transition: .25s ease;
    }

        .gs-side-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 26px 48px rgba(0,0,0,0.32);
        }

        .gs-side-card img {
            width: 110px;
            height: 90px;
            border-radius: 16px;
            object-fit: cover;
            flex-shrink: 0;
        }

    .gs-side-card-title {
        color: #fff;
        font-weight: 700;
        line-height: 1.45;
        margin-bottom: 8px;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .gs-side-meta {
        color: var(--gs-muted);
        font-size: 0.92rem;
    }

    .gs-empty-text {
        color: var(--gs-muted);
        margin-bottom: 0;
    }

    @@media (max-width: 575.98px) {
        .gs-page {
            padding: 30px 0 50px;
        }

        .gs-article-card,
        .gs-side-panel {
            padding: 18px;
        }

        .gs-side-card {
            flex-direction: column;
        }

            .gs-side-card img {
                width: 100%;
                height: 180px;
            }

        .gs-hero-image {
            min-height: 240px;
        }
    }
</style>