@using GameStore.Pagination.Admin
@model PaymentListVM
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Quản lý Payment";
}

<div class="card admin-list-card">
    <div class="card-body">
        <h4 class="card-title">Danh sách Payment</h4>
        <p class="card-subtitle mb-3">Quản lý toàn bộ Payment trong hệ thống</p>

        <div class="d-flex justify-content-between align-items-center mb-3 gap-2 flex-wrap admin-list-toolbar">

            <form method="get" action="/admin/payment/index" class="d-flex gap-2 flex-wrap admin-search-form admin-payment-search-form">

                <input type="text"
                       name="keyword"
                       value="@Model.Keyword"
                       class="form-control"
                       placeholder="Tìm theo email..." />

                <select name="status" class="form-control">
                    <option value="">-- Tất cả trạng thái --</option>
                    <option value="Success" selected="@(Model.Status == "Success")">Success</option>
                    <option value="Failed" selected="@(Model.Status == "Failed")">Failed</option>
                </select>

                <button class="btn btn-success">Search</button>
            </form>

        </div>

        <div class="p-2 text-success admin-inline-msg">
            @TempData["Msg"]
        </div>

        <div class="table-responsive">
            <table class="table table-striped align-middle admin-payment-table">
                <thead>
                    <tr>
                        <th>Mã GD</th>
                        <th>User</th>
                        <th>Tiền</th>
                        <th>Phương thức</th>
                        <th>Trạng thái</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Payments)
                    {
                        <tr>
                            <td>@item.MaGD</td>
                            <td class="text-break">@item.NguoiDung?.Email</td>
                            <td>@item.ThanhTien</td>
                            <td>@item.PhuongThuc</td>
                            <td>@item.TrangThai</td>
                            <td>
                                <form method="post"
                                      action="/admin/payment/update-status"
                                      class="d-flex align-items-center gap-2 flex-wrap admin-payment-action-form">

                                    <input type="hidden" name="id" value="@item.MaGD" />

                                    <select name="status"
                                            class="form-select form-select-sm">

                                        <option value="Success"
                                                selected="@(item.TrangThai == "Success")">
                                            ✔ Success
                                        </option>

                                        <option value="Failed"
                                                selected="@(item.TrangThai == "Failed")">
                                            ❌ Failed
                                        </option>

                                    </select>

                                    <button type="submit"
                                            class="btn btn-sm btn-warning">
                                        🔄
                                    </button>

                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            <!-- Pagination UI only -->
            <nav>
                <ul class="pagination justify-content-center mt-4 flex-wrap">

                    <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                        <a class="page-link"
                           href="?keyword=@Model.Keyword&status=@Model.Status&page=@(Model.CurrentPage - 1)">
                            Previous
                        </a>
                    </li>

                    @for (int i = 1; i <= Model.TotalPages; i++)
                    {
                        <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                            <a class="page-link"
                               href="?keyword=@Model.Keyword&status=@Model.Status&page=@i">
                                @i
                            </a>
                        </li>
                    }

                    <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                        <a class="page-link"
                           href="?keyword=@Model.Keyword&status=@Model.Status&page=@(Model.CurrentPage + 1)">
                            Next
                        </a>
                    </li>

                </ul>
            </nav>
        </div>
    </div>
</div>

<style>
    .admin-list-card .card-body {
        padding: 1rem;
    }

    .admin-inline-msg {
        word-break: break-word;
    }

    .admin-search-form {
        width: 100%;
        max-width: 100%;
    }

    .admin-payment-search-form > input,
    .admin-payment-search-form > select {
        min-width: 0;
        flex: 1 1 220px;
    }

    .admin-payment-table th,
    .admin-payment-table td {
        white-space: nowrap;
        vertical-align: middle;
    }

        .admin-payment-table td.text-break {
            white-space: normal;
            word-break: break-word;
            min-width: 220px;
        }

    .admin-payment-action-form {
        min-width: 180px;
    }

        .admin-payment-action-form .form-select {
            min-width: 120px;
        }

    @@media (max-width: 991.98px) {
        .admin-list-toolbar {
            align-items: stretch !important;
        }

        .admin-payment-search-form {
            max-width: 100%;
        }
    }

    @@media (max-width: 767.98px) {
        .admin-list-card .card-body {
            padding: 0.9rem;
        }

        .admin-payment-search-form {
            flex-direction: column;
        }

            .admin-payment-search-form > input,
            .admin-payment-search-form > select,
            .admin-payment-search-form > button {
                width: 100%;
                flex: 1 1 auto;
            }

        .admin-payment-table {
            min-width: 860px;
        }

        .admin-payment-action-form {
            flex-wrap: nowrap;
        }

        .pagination .page-link {
            padding: 0.45rem 0.7rem;
        }
    }

    @@media (max-width: 575.98px) {
        .card-title {
            font-size: 1.1rem;
        }

        .card-subtitle {
            font-size: 0.9rem;
        }
    }
</style>