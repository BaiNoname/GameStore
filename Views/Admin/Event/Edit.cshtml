@model GameStore.Models.Event

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Edit Event";
}

<div class="container mt-5">
    <div class="card bg-light shadow-lg border-0">
        <div class="card-header border-bottom border-secondary">
            <h4 class="mb-0">🎮 Edit Event</h4>
        </div>

        @if (TempData["Msg"] != null)
        {
            var msgType = TempData["MsgType"]?.ToString() ?? "info";
            <div class="alert alert-@msgType mt-2 mx-3 fw-bold">@TempData["Msg"]</div>
        }

        <div class="card-body">
            <form method="post" enctype="multipart/form-data" asp-controller="Event" asp-action="Edit" asp-route-id="@Model.EventId">
                <input type="hidden" asp-for="EventId" />
                <input type="hidden" name="filterKeyword" value="@ViewBag.Keyword" />
                <input type="hidden" name="filterEventType" value="@ViewBag.EventType" />
                <input type="hidden" name="filterStatus" value="@ViewBag.Status" />
                <input type="hidden" name="currentPage" value="@ViewBag.CurrentPage" />

                <div class="mb-3">
                    <label class="form-label">Title</label>
                    <input class="form-control" asp-for="Title" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Slug</label>
                    <input class="form-control" asp-for="Slug" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Summary</label>
                    <textarea class="form-control" asp-for="Summary" rows="3"></textarea>
                </div>

                <div class="mb-3">
                    <label class="form-label">Content</label>
                    <textarea class="form-control" asp-for="Content" rows="8"></textarea>
                </div>

                <div class="mb-3">
                    <label class="form-label">Current Banner</label>
                    <div class="mb-2">
                        @if (!string.IsNullOrWhiteSpace(Model.Banner))
                        {
                            <img src="~/images/events/@Model.Banner" style="width:180px;height:110px;object-fit:cover;border-radius:12px;border:1px solid #ddd;" />
                        }
                        else
                        {
                            <span class="text-muted">Chưa có ảnh</span>
                        }
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label">Change Banner</label>
                    <input type="file" class="form-control" name="photo" accept="image/*" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Related Game</label>
                    <select class="form-select" asp-for="RelatedGameId" asp-items="ViewBag.Games">
                        <option value="">-- Select Game --</option>
                    </select>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Event Type</label>
                        <select class="form-select" asp-for="EventType">
                            <option value="Tournament">Tournament</option>
                            <option value="Community">Community</option>
                            <option value="Special Events">Special Events</option>
                        </select>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label">Access Type</label>
                        <select class="form-select" asp-for="AccessType">
                            <option value="Paid">Paid</option>
                            <option value="Free">Free</option>
                        </select>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label class="form-label">Price</label>
                        <input class="form-control" asp-for="Price" type="number" step="0.01" />
                    </div>

                    <div class="col-md-4 mb-3">
                        <label class="form-label">Max Participants</label>
                        <input class="form-control" asp-for="MaxParticipants" type="number" />
                    </div>

                    <div class="col-md-4 mb-3">
                        <label class="form-label">Current Participants</label>
                        <input class="form-control" asp-for="CurrentParticipants" readonly />
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label">Prize Info</label>
                    <input class="form-control" asp-for="PrizeInfo" placeholder="Ex: Check in to receive a reward" />
                </div>

                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label class="form-label">Prize Type</label>
                        <select class="form-select" id="PrizeType" name="PrizeType">
                            @if (string.IsNullOrWhiteSpace(Model.PrizeType))
                            {
                                <option value="" selected>-- No Reward --</option>
                            }
                            else
                            {
                                <option value="">-- No Reward --</option>
                            }

                            @if (Model.PrizeType == "Balance")
                            {
                                <option value="Balance" selected>Balance</option>
                            }
                            else
                            {
                                <option value="Balance">Balance</option>
                            }

                            @if (Model.PrizeType == "Effect")
                            {
                                <option value="Effect" selected>Effect</option>
                            }
                            else
                            {
                                <option value="Effect">Effect</option>
                            }
                        </select>
                    </div>

                    <div class="col-md-4 mb-3" id="prizeBalanceWrap">
                        <label class="form-label">Prize Value (Balance)</label>
                        <input class="form-control"
                               id="PrizeValueBalance"
                               type="number"
                               step="0.01"
                               min="0"
                               value="@(Model.PrizeType == "Balance" ? Model.PrizeValue : "")"
                               placeholder="Ex: 50000" />
                    </div>

                    <div class="col-md-4 mb-3" id="prizeEffectWrap">
                        <label class="form-label">Prize Value (Effect)</label>
                        <select class="form-select" id="PrizeValueEffect">
                            <option value="">-- Select Effect --</option>
                            @foreach (var item in (List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)ViewBag.Effects)
                            {
                                if (item.Selected)
                                {
                                    <option value="@item.Value" selected>@item.Text</option>
                                }
                                else
                                {
                                    <option value="@item.Value">@item.Text</option>
                                }
                            }
                        </select>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label class="form-label">Prize Condition</label>
                        <input class="form-control" name="PrizeCondition" value="CheckIn" readonly />
                    </div>
                </div>

                <input type="hidden" id="PrizeValue" name="PrizeValue" value="@Model.PrizeValue" />

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Start At</label>
                        <input type="datetime-local"
                               class="form-control"
                               value="@Model.StartAt.ToLocalTime().ToString("yyyy-MM-ddTHH:mm:ss")"
                               readonly />
                        <input type="hidden"
                               name="StartAt"
                               value="@Model.StartAt.ToLocalTime().ToString("yyyy-MM-ddTHH:mm:ss")" />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label">End At</label>
                        <input type="datetime-local"
                               class="form-control"
                               id="EndAt"
                               name="EndAt"
                               step="1"
                               value="@Model.EndAt.ToLocalTime().ToString("yyyy-MM-ddTHH:mm:ss")" />
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label">Current Status</label>
                    <input class="form-control" value="@Model.Status" readonly />
                    <small class="text-muted">Status is automatically calculated based on Start At and End At.</small>
                </div>

                <div class="d-flex justify-content-end gap-2 flex-wrap">
                    <a href="/admin/event/index" class="btn btn-secondary">Back</a>

                    <a href="/admin/event-announcement/index/@Model.EventId" class="btn btn-info text-white">
                        Manage Announcements
                    </a>

                    <a href="/admin/event-participant/index/@Model.EventId" class="btn btn-primary">
                        View Participants
                    </a>

                    <button class="btn btn-success" type="submit">💾 Update Event</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const prizeType = document.getElementById("PrizeType");
        const prizeBalanceWrap = document.getElementById("prizeBalanceWrap");
        const prizeEffectWrap = document.getElementById("prizeEffectWrap");
        const prizeValueHidden = document.getElementById("PrizeValue");
        const prizeValueBalance = document.getElementById("PrizeValueBalance");
        const prizeValueEffect = document.getElementById("PrizeValueEffect");

        function syncPrizeUi() {
            const type = prizeType.value;

            if (type === "Balance") {
                prizeBalanceWrap.style.display = "block";
                prizeEffectWrap.style.display = "none";
                prizeValueHidden.value = prizeValueBalance.value || "";
            }
            else if (type === "Effect") {
                prizeBalanceWrap.style.display = "none";
                prizeEffectWrap.style.display = "block";
                prizeValueHidden.value = prizeValueEffect.value || "";
            }
            else {
                prizeBalanceWrap.style.display = "none";
                prizeEffectWrap.style.display = "none";
                prizeValueHidden.value = "";
            }
        }

        prizeType.addEventListener("change", syncPrizeUi);
        prizeValueBalance.addEventListener("input", syncPrizeUi);
        prizeValueEffect.addEventListener("change", syncPrizeUi);

        syncPrizeUi();
    });
</script>