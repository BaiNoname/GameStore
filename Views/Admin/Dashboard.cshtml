@model GameStore.Pagination.Admin.DashboardVM
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Quản lý Dashboard";
}

<div class="row">

    <!-- CARD -->
    <div class="col-md-3">
        <div class="card bg-primary text-white p-3">
            <h5>Total Revenue</h5>
            <h3>@Model.TotalRevenue.ToString("N0") VND</h3>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card bg-success text-white p-3">
            <h5>Orders</h5>
            <h3>@Model.TotalOrders</h3>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card bg-warning text-dark p-3">
            <h5>Users</h5>
            <h3>@Model.TotalUsers</h3>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card bg-danger text-white p-3">
            <h5>Games</h5>
            <h3>@Model.TotalGames</h3>
        </div>
    </div>

</div>

<hr />

<!-- CHART -->
<div class="card p-3">
    <h5>Revenue (7 days)</h5>
    <canvas id="revenueChart"></canvas>
</div>

<hr />

<div class="row">

    <!-- TOP GAME -->
    <div class="col-md-6">
        <div class="card p-3">
            <h5>🔥 Top Games</h5>
            <ul>
                @foreach (var g in Model.TopGames)
                {
                    <li>@g.TenGame - @g.SoLuotTai lượt tải</li>
                }
            </ul>
        </div>
    </div>

    <!-- RECENT ORDERS -->
    <div class="col-md-6">
        <div class="card p-3">
            <h5>🧾 Recent Orders</h5>
            <table class="table">
                <thead>
                    <tr>
                        <th>MaGD</th>
                        <th>Email</th>
                        <th>Money</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var o in Model.RecentOrders)
                    {
                        <tr>
                            <td>@o.MaGD</td>
                            <td>@o.Email</td>
                            <td>@o.ThanhTien.ToString("N0")</td>
                            <td>@o.TrangThai</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>
        const labels = @Html.Raw(Json.Serialize(Model.RevenueChart.Select(x => x.Date)));
        const data = @Html.Raw(Json.Serialize(Model.RevenueChart.Select(x => x.Revenue)));

        new Chart(document.getElementById("revenueChart"), {
            type: 'line',
            data: {
                labels: labels,
                datasets: [{
                    label: 'Revenue',
                    data: data,
                    borderWidth: 2
                }]
            }
        });
    </script>
}