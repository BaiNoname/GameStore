@model GameStore.Models.KhuyenMai
@{
    string Dt(DateTime? d) => d.HasValue ? d.Value.ToLocalTime().ToString("yyyy-MM-ddTHH:mm") : "";
}

<div class="row g-3">
    <div class="col-md-6">
        <label class="form-label">Code <span class="text-danger">*</span></label>
        <input type="text" name="Code" value="@Model.Code" class="form-control" required placeholder="VD: WELCOME10" />
    </div>
    <div class="col-md-6">
        <label class="form-label">Loại giảm</label>
        <select name="LoaiGiam" class="form-select">
            <option value="Percent" selected="@(Model.LoaiGiam == "Percent")">Giảm theo % </option>
            <option value="Fixed" selected="@(Model.LoaiGiam == "Fixed")">Giảm số tiền</option>
        </select>
    </div>

    <div class="col-12">
        <label class="form-label">Mô tả</label>
        <input type="text" name="MoTa" value="@Model.MoTa" class="form-control" placeholder="VD: Giảm 10% cho đơn đầu tiên" />
    </div>

    <div class="col-md-4">
        <label class="form-label">Giá trị <span class="text-danger">*</span></label>
        <input type="number" step="0.01" min="0" name="GiaTri" value="@(Model.GiaTri == 0 ? "" : Model.GiaTri.ToString())" class="form-control" required />
        <div class="form-text">% nếu loại %, hoặc số tiền (đ) nếu loại tiền.</div>
    </div>
    <div class="col-md-4">
        <label class="form-label">Giảm tối đa (đ)</label>
        <input type="number" step="1000" min="0" name="GiamToiDa" value="@(Model.GiamToiDa)" class="form-control" placeholder="Cho loại %" />
    </div>
    <div class="col-md-4">
        <label class="form-label">Đơn tối thiểu (đ)</label>
        <input type="number" step="1000" min="0" name="DonToiThieu" value="@(Model.DonToiThieu)" class="form-control" />
    </div>

    <div class="col-md-4">
        <label class="form-label">Số lượng <span class="text-danger">*</span></label>
        <input type="number" min="1" name="SoLuong" value="@(Model.SoLuong == 0 ? "" : Model.SoLuong.ToString())" class="form-control" required />
    </div>
    <div class="col-md-4">
        <label class="form-label">Ngày bắt đầu</label>
        <input type="datetime-local" name="NgayBatDau" value="@Dt(Model.NgayBatDau)" class="form-control" />
    </div>
    <div class="col-md-4">
        <label class="form-label">Ngày kết thúc</label>
        <input type="datetime-local" name="NgayKetThuc" value="@Dt(Model.NgayKetThuc)" class="form-control" />
    </div>

    <div class="col-12">
        <label class="form-label">Trạng thái</label>
        <select name="IsActive" class="form-select">
            <option value="true" selected="@(Model.IsActive)">Bật</option>
            <option value="false" selected="@(!Model.IsActive)">Tắt</option>
        </select>
    </div>
</div>
