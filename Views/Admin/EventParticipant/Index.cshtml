@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Event Participants";

    var ev = ViewBag.Event as GameStore.Models.Event;
    var participants = ViewBag.Participants as List<GameStore.Models.EventParticipant> ?? new List<GameStore.Models.EventParticipant>();
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
        <div>
            <h3 class="mb-1">👥 Event Participants</h3>
            <p class="text-muted mb-0">
                Event: <strong>@(ev?.Title ?? "Unknown Event")</strong>
            </p>
        </div>

        <a href="/admin/event/index" class="btn btn-secondary">
            ← Back to Events
        </a>
    </div>

    @if (TempData["Msg"] != null)
    {
        var msgType = TempData["MsgType"]?.ToString() ?? "info";
        <div class="alert alert-@msgType fw-bold">@TempData["Msg"]</div>
    }

    <div class="card shadow-lg border-0">
        <div class="card-header bg-light">
            <h5 class="mb-0">Participant List</h5>
        </div>

        <div class="card-body">
            @if (participants.Any())
            {
                <div class="table-responsive">
                    <table class="table table-striped align-middle">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>User</th>
                                <th>Join Status</th>
                                <th>Paid Amount</th>
                                <th>Joined At</th>
                                <th>Check-in</th>
                                <th>Checked In At</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in participants)
                            {
                                <tr>
                                    <td>@item.ParticipantId</td>
                                    <td>
                                        <div class="fw-bold">
                                            @(item.NguoiDung?.TenNguoiDung ?? item.NguoiDung?.Email ?? "Unknown")
                                        </div>
                                        <small class="text-muted">@item.NguoiDung?.Email</small>
                                    </td>
                                    <td>@item.JoinStatus</td>
                                    <td>@item.PaidAmount.ToString("N0") VND</td>
                                    <td>@item.JoinedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                    <td>
                                        @if (item.IsCheckedIn)
                                        {
                                            <span class="badge bg-success">Checked-in</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark">Not checked-in</span>
                                        }
                                    </td>
                                    <td>
                                        @(item.CheckedInAt.HasValue? item.CheckedInAt.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm") : "-")
                                    </td>
                                    <td>
                                        <button type="button"
                                                class="btn btn-sm btn-danger"
                                                data-bs-toggle="modal"
                                                data-bs-target="#deleteParticipantModal"
                                                data-participant-id="@item.ParticipantId"
                                                data-participant-name="@(item.NguoiDung?.TenNguoiDung ?? item.NguoiDung?.Email ?? "Unknown")">
                                            Remove
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-muted">No participants have been registered for this event yet.</div>
            }
        </div>
    </div>
</div>

<div class="modal fade" id="deleteParticipantModal" tabindex="-1" aria-labelledby="deleteParticipantModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-dark text-light border-secondary rounded-4">
            <div class="modal-header border-secondary">
                <h5 class="modal-title" id="deleteParticipantModalLabel">Confirm Delete Participant</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body">
                Are you sure you want to delete the participant <strong id="deleteParticipantName"></strong> from this event? 🛑
            </div>

            <div class="modal-footer border-secondary flex-wrap">
                <form method="get" id="deleteParticipantForm">
                    <button type="submit" class="btn btn-danger">
                        Confirm Delete
                    </button>
                </form>

                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    Cancel
                </button>
            </div>
        </div>
    </div>
</div>

<style>
    @@media (max-width: 575.98px) {
        .modal-footer form,
        .modal-footer .btn {
            width: 100%;
        }
    }
</style>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const deleteModal = document.getElementById("deleteParticipantModal");
        if (!deleteModal) return;

        deleteModal.addEventListener("show.bs.modal", function (event) {
            const button = event.relatedTarget;
            const participantId = button.getAttribute("data-participant-id");
            const participantName = button.getAttribute("data-participant-name");

            document.getElementById("deleteParticipantName").textContent = participantName;
            document.getElementById("deleteParticipantForm").action = "/admin/event-participant/delete/" + participantId;
        });
    });
</script>