@model GameStore.Models.NguoiDung

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Edit Users";
}

<div class="container mt-5">
    <div class="card bg-light text-light shadow-lg border-0">
        <div class="card-header border-bottom border-secondary">
            <h4 class="mb-0">🎮 Edit Users</h4>
        </div>

        @if (TempData["Msg"] != null)
        {
            var msgType = TempData["MsgType"]?.ToString() ?? "info";
            <div class="alert alert-@msgType mt-2 fw-bold text-danger">
                @TempData["Msg"]
            </div>
        }

        <div class="card-body">
            <form method="post" asp-controller="User" asp-action="Edit">
                <input type="hidden" name="keyword" value="@ViewBag.Keyword" />
                <input type="hidden" name="status" value="@ViewBag.Status" />
                <input type="hidden" name="page" value="@ViewBag.CurrentPage" />

                <div class="mb-3">
                    <label class="form-label">User ID</label>
                    <input type="text"
                           class="form-control"
                           asp-for="MaNguoiDung"
                           readonly />
                    <span asp-validation-for="MaNguoiDung" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label">User Name</label>
                    <input type="text"
                           class="form-control"
                           asp-for="TenNguoiDung"
                           placeholder="Enter User Name..." />
                    <span asp-validation-for="TenNguoiDung" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label">Email</label>
                    <input type="email"
                           class="form-control"
                           asp-for="Email"
                           placeholder="Enter Email..." />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label">PassWord</label>
                    <input type="password"
                           class="form-control"
                           asp-for="MatKhau"
                           placeholder="Enter PassWord..." />
                    <span asp-validation-for="MatKhau" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label">Confirm Password</label>
                    <input type="password"
                           class="form-control"
                           name="confirmPassword"
                           placeholder="Confirm Password..." />
                </div>

                <div class="mb-3">
                    <label class="form-label">Release Date</label>
                    <input type="text"
                           class="form-control"
                           value="@Model.NgayDangKy"
                           readonly />
                </div>

                <div class="mb-3">
                    <label class="form-label">Role</label>
                    <select class="form-control" asp-for="Quyen">
                        <option value="user">User</option>
                        <option value="admin">Admin</option>
                    </select>
                    <span asp-validation-for="Quyen" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label">Balance</label>
                    <input type="text"
                           class="form-control"
                           asp-for="SoDu"
                           placeholder="Enter Balance..." />
                    <span asp-validation-for="SoDu" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label d-block">Status</label>
                    <div class="form-check form-switch">
                        <input class="form-check-input" asp-for="IsActive" type="checkbox" />
                        <label class="form-check-label" asp-for="IsActive">
                            Tài khoản đang hoạt động
                        </label>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2">
                    <a asp-controller="User"
                       asp-action="Index"
                       asp-route-keyword="@ViewBag.Keyword"
                       asp-route-status="@ViewBag.Status"
                       asp-route-page="@ViewBag.CurrentPage"
                       class="btn btn-secondary">
                        Back
                    </a>

                    <button class="btn btn-success" type="submit">
                        Edit User
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    setTimeout(() => {
        const alert = document.querySelector('.alert');
        if (alert) alert.style.display = 'none';
    }, 3000);
</script>