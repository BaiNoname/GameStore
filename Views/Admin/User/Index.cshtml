@model GameStore.Pagination.Admin.UserListVM

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Quản lý User";
    string status = ViewBag.Status?.ToString() ?? "all";
}

<div class="card admin-list-card">
    <div class="card-body">
        <h4 class="card-title">Danh sách Users</h4>
        <p class="card-subtitle mb-3">Quản lý toàn bộ Users trong hệ thống</p>

        <div class="d-flex justify-content-between align-items-center mb-3 gap-2 flex-wrap admin-list-toolbar">
            <form method="get" action="/admin/user/index" class="d-flex flex-wrap gap-2 admin-search-form">
                <input type="text"
                       name="keyword"
                       value="@Model.Keyword"
                       class="form-control"
                       placeholder="Tìm user theo email hoặc tên..." />

                <select name="status" class="form-control">
                    <option value="all" selected="@(status == "all")">All</option>
                    <option value="active" selected="@(status == "active")">Active</option>
                    <option value="inactive" selected="@(status == "inactive")">Inactive</option>
                </select>

                <button type="submit" class="btn btn-success">
                    Search
                </button>
            </form>

            <a asp-controller="User"
               asp-action="Add"
               asp-route-keyword="@Model.Keyword"
               asp-route-status="@status"
               asp-route-page="@Model.CurrentPage"
               class="btn btn-primary">
                + Add New User
            </a>

            @if (TempData["Msg"] != null)
            {
                var msgType = TempData["MsgType"]?.ToString() ?? "info";
                <div class="alert alert-@msgType mt-2 fw-bold text-danger mb-0 admin-inline-alert">
                    @TempData["Msg"]
                </div>
            }
        </div>

        <div class="table-responsive">
            <table class="table table-striped align-middle admin-user-table">
                <thead>
                    <tr>
                        <th>User ID</th>
                        <th>UserName</th>
                        <th>Email</th>
                        <th>Date Register</th>
                        <th>Role</th>
                        <th>Balance</th>
                        <th>Status</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Users != null && Model.Users.Any())
                    {
                        @foreach (var user in Model.Users)
                        {
                            <tr class="@(user.IsActive ? "" : "table-secondary")">
                                <td>@user.MaNguoiDung</td>
                                <td>@user.TenNguoiDung</td>
                                <td class="text-break">@user.Email</td>
                                <td>@user.NgayDangKy</td>
                                <td>@user.Quyen</td>
                                <td>@user.SoDu</td>
                                <td>
                                    @if (user.IsActive)
                                    {
                                        <span class="badge bg-success">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-dark">Inactive</span>
                                    }
                                </td>
                                <td>
                                    <div class="d-flex gap-2 flex-wrap admin-action-group">
                                        <a class="btn btn-sm btn-warning"
                                           asp-controller="User"
                                           asp-action="Edit"
                                           asp-route-id="@user.MaNguoiDung"
                                           asp-route-page="@Model.CurrentPage"
                                           asp-route-keyword="@Model.Keyword"
                                           asp-route-status="@status">
                                            Edit
                                        </a>

                                        @if (user.IsActive)
                                        {
                                            <button class="btn btn-danger btn-sm"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#deleteModal"
                                                    data-user-id="@user.MaNguoiDung"
                                                    data-user-name="@user.TenNguoiDung">
                                                Deactivate
                                            </button>
                                        }
                                        else
                                        {
                                            <a class="btn btn-success btn-sm"
                                               asp-controller="User"
                                               asp-action="Activate"
                                               asp-route-id="@user.MaNguoiDung"
                                               asp-route-page="@Model.CurrentPage"
                                               asp-route-keyword="@Model.Keyword"
                                               asp-route-status="@status">
                                                Activate
                                            </a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center text-muted">Không có user nào</td>
                        </tr>
                    }
                </tbody>
            </table>

            @if (Model.TotalPages > 1)
            {
                <nav>
                    <ul class="pagination justify-content-center mt-4 flex-wrap">
                        <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                            <a class="page-link"
                               href="?keyword=@Model.Keyword&status=@status&page=@(Model.CurrentPage - 1)">
                                Previous
                            </a>
                        </li>

                        @for (int i = 1; i <= Model.TotalPages; i++)
                        {
                            <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                <a class="page-link"
                                   href="?keyword=@Model.Keyword&status=@status&page=@i">
                                    @i
                                </a>
                            </li>
                        }

                        <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                            <a class="page-link"
                               href="?keyword=@Model.Keyword&status=@status&page=@(Model.CurrentPage + 1)">
                                Next
                            </a>
                        </li>
                    </ul>
                </nav>
            }
        </div>
    </div>
</div>

<div class="modal fade" id="deleteModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-dark text-light">
            <div class="modal-header border-secondary">
                <h5 class="modal-title">Xác nhận vô hiệu hóa user</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                Bạn có chắc muốn chuyển user <strong id="deleteUserName"></strong> sang trạng thái Inactive không? 🛑
            </div>

            <div class="modal-footer border-secondary flex-wrap">
                <form method="get" id="deleteForm">
                    <input type="hidden" name="page" value="@Model.CurrentPage" />
                    <input type="hidden" name="keyword" value="@Model.Keyword" />
                    <input type="hidden" name="status" value="@status" />
                    <button type="submit" class="btn btn-danger">
                        Đồng ý
                    </button>
                </form>
                <button class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
            </div>
        </div>
    </div>
</div>

<style>
    .admin-list-card .card-body {
        padding: 1rem;
    }

    .admin-search-form {
        width: 100%;
    }

        .admin-search-form .form-control,
        .admin-search-form select {
            min-width: 0;
            flex: 1 1 220px;
        }

    .admin-inline-alert {
        width: 100%;
        word-break: break-word;
    }

    .admin-user-table th,
    .admin-user-table td {
        white-space: nowrap;
        vertical-align: middle;
    }

        .admin-user-table td.text-break {
            white-space: normal;
            word-break: break-word;
            min-width: 220px;
        }

    .admin-action-group {
        min-width: 140px;
    }

    @@media (max-width: 991.98px) {
        .admin-list-toolbar {
            align-items: stretch !important;
        }
    }

    @@media (max-width: 767.98px) {
        .admin-list-card .card-body {
            padding: 0.9rem;
        }

        .admin-search-form {
            flex-direction: column;
        }

            .admin-search-form .form-control,
            .admin-search-form select,
            .admin-search-form .btn,
            .admin-list-toolbar > .btn {
                width: 100%;
                flex: 1 1 auto;
            }

        .admin-user-table {
            min-width: 1050px;
        }
    }

    @@media (max-width: 575.98px) {
        .modal-footer form,
        .modal-footer .btn {
            width: 100%;
        }
    }
</style>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        var deleteModal = document.getElementById('deleteModal');
        if (!deleteModal) return;

        deleteModal.addEventListener('show.bs.modal', function (event) {
            var button = event.relatedTarget;
            var userId = button.getAttribute('data-user-id');
            var userName = button.getAttribute('data-user-name');

            document.getElementById('deleteUserName').textContent = userName;

            var deleteForm = document.getElementById('deleteForm');
            deleteForm.action = '/admin/user/delete/' + userId;
        });
    });
</script>