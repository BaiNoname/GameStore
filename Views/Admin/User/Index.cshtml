@model GameStore.Pagination.Admin.UserListVM

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Quản lý User";
}

<div class="card">
    <div class="card-body">
        <h4 class="card-title">Danh sách Users</h4>
        <p class="card-subtitle mb-3">Quản lý toàn bộ Users trong hệ thống</p>

        <!-- Search + Add Button -->
        <div class="d-flex justify-content-between align-items-center mb-3">

            <form method="get" action="/admin/user/index" class="d-flex" style="width:350px;">
                <input type="text"
                       name="keyword"
                       value="@Model.Keyword"
                       class="form-control me-2"
                       placeholder="Tìm user theo email..." />

                <button type="submit" class="btn btn-success">
                    Search
                </button>
            </form>

            <a href="/admin/user/add" class="btn btn-primary">
                + Add New User
            </a>

            @if (TempData["Msg"] != null)
            {
                var msgType = TempData["MsgType"]?.ToString() ?? "info";
                <div class="alert alert-@msgType mt-2 fw-bold text-danger">
                    @TempData["Msg"]
                </div>
            }

        </div>

        <div class="table-responsive">
            <table class="table table-striped align-middle">
                <thead>
                    <tr>
                        <th>User ID</th>
                        <th>UserName</th>
                        <th>Email</th>
                        <th>Date Register</th>
                        <th>Role</th>
                        <th>Balance</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model.Users)
                    {
                        <tr>
                            <td>@user.MaNguoiDung</td>
                            <td>@user.TenNguoiDung</td>
                            <td>@user.Email</td>
                            <td>@user.NgayDangKy</td>
                            <td>@user.Quyen</td>
                            <td>@user.SoDu</td>
                            <td>
                                <a class="btn btn-sm btn-warning"
                                   asp-controller="User"
                                   asp-action="Edit"
                                   asp-route-id="@user.MaNguoiDung"
                                   asp-route-page="@Model.CurrentPage">
                                    Edit
                                </a>
                                <!-- Nút Delete -->
                                <button class="btn btn-danger btn-sm"
                                        data-bs-toggle="modal"
                                        data-bs-target="#deleteModal"
                                        data-user-id="@user.MaNguoiDung"
                                        data-user-name="@user.TenNguoiDung">
                                    Delete
                                </button>
                                <div class="modal fade" id="deleteModal" tabindex="-1">
                                    <div class="modal-dialog modal-dialog-centered">
                                        <div class="modal-content bg-dark text-light">

                                            <div class="modal-header border-secondary">
                                                <h5 class="modal-title">Xác nhận xóa user</h5>
                                                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                                            </div>

                                            <div class="modal-body">
                                                Bạn có chắc muốn xóa user <strong id="deleteUserName"></strong> không? 🛑
                                            </div>

                                            <div class="modal-footer border-secondary">
                                                <form method="get" id="deleteForm">
                                                    <button type="submit" class="btn btn-danger">
                                                        Đồng ý xóa
                                                    </button>
                                                </form>
                                                <button class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                                            </div>

                                        </div>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            <!-- Pagination UI only -->
            <nav>
                <ul class="pagination justify-content-center mt-4">

                    <!-- Previous -->
                    <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                        <a class="page-link"
                           href="?keyword=@Model.Keyword&page=@(Model.CurrentPage - 1)">
                            Previous
                        </a>
                    </li>

                    <!-- Page numbers -->
                    @for (int i = 1; i <= Model.TotalPages; i++)
                    {
                        <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                            <a class="page-link"
                               href="?keyword=@Model.Keyword&page=@i">
                                @i
                            </a>
                        </li>
                    }

                    <!-- Next -->
                    <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                        <a class="page-link"
                           href="?keyword=@Model.Keyword&page=@(Model.CurrentPage + 1)">
                            Next
                        </a>
                    </li>

                </ul>
            </nav>
        </div>
    </div>
</div>
<script>
    document.addEventListener("DOMContentLoaded", function() {
        var deleteModal = document.getElementById('deleteModal');
        deleteModal.addEventListener('show.bs.modal', function(event) {
            var button = event.relatedTarget; // nút vừa click
            var userId = button.getAttribute('data-user-id');
            var userName = button.getAttribute('data-user-name');

            // set tên user trong modal
            document.getElementById('deleteUserName').textContent = userName;

            // set action cho form
            var deleteForm = document.getElementById('deleteForm');
            deleteForm.action = '/admin/user/delete/' + userId + '?page=@Model.CurrentPage';
        });
    });
</script>
