@model GameStore.Pagination.Admin.UserListVM

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Quản lý User";
}

<div class="card">
    <div class="card-body">
        <h4 class="card-title">Danh sách Users</h4>
        <p class="card-subtitle mb-3">Quản lý toàn bộ Users trong hệ thống</p>

        <!-- Search + Add Button -->
        <div class="d-flex justify-content-between align-items-center mb-3">

            <form method="get" action="/admin/user/index" class="d-flex" style="width:350px;">
                <input type="text"
                       name="keyword"
                       value="@Model.Keyword"
                       class="form-control me-2"
                       placeholder="Tìm user theo email..." />

                <button type="submit" class="btn btn-success">
                    Search
                </button>
            </form>

            <a href="/admin/user/add" class="btn btn-primary">
                + Add New User
            </a>

        </div>

        <div class="table-responsive">
            <table class="table table-striped align-middle">
                <thead>
                    <tr>
                        <th>User ID</th>
                        <th>UserName</th>
                        <th>Email</th>
                        <th>Date Register</th>
                        <th>Role</th>
                        <th>Balance</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model.Users)
                    {
                        <tr>
                            <td>@user.MaNguoiDung</td>
                            <td>@user.TenNguoiDung</td>
                            <td>@user.Email</td>
                            <td>@user.NgayDangKy</td>
                            <td>@user.Quyen</td>
                            <td>@user.SoDu</td>
                            <td>
                                <a class="btn btn-sm btn-warning" asp-controller="user" asp-action="edit" asp-route-id="@user.MaNguoiDung">Edit</a>
                                <a class="btn btn-sm btn-danger" asp-controller="user" asp-action="delete" asp-route-id="@user.MaNguoiDung" onclick="return confirm(`Are you Sure`)">Delete</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            <!-- Pagination UI only -->
            <nav>
                <ul class="pagination justify-content-center mt-4">

                    <!-- Previous -->
                    <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                        <a class="page-link"
                           href="?keyword=@Model.Keyword&page=@(Model.CurrentPage - 1)">
                            Previous
                        </a>
                    </li>

                    <!-- Page numbers -->
                    @for (int i = 1; i <= Model.TotalPages; i++)
                    {
                        <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                            <a class="page-link"
                               href="?keyword=@Model.Keyword&page=@i">
                                @i
                            </a>
                        </li>
                    }

                    <!-- Next -->
                    <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                        <a class="page-link"
                           href="?keyword=@Model.Keyword&page=@(Model.CurrentPage + 1)">
                            Next
                        </a>
                    </li>

                </ul>
            </nav>
        </div>
    </div>
</div>
