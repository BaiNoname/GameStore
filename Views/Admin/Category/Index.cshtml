@model GameStore.Pagination.Admin.CategoryListVM
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Quản lý Category Game";
}

<div class="card">
    <div class="card-body">
        <h4 class="card-title">Danh sách thể loại game</h4>
        <p class="card-subtitle mb-3">Quản lý toàn bộ thể loại game trong hệ thống</p>

        <!-- Search + Add Button -->
        <div class="d-flex justify-content-between align-items-center mb-3">

            <form method="get" action="/admin/category/index" class="d-flex" style="width:350px;">
                <input type="text"
                       name="keyword"
                       value="@Model.Keyword"
                       class="form-control me-2"
                       placeholder="Tìm thể loại theo tên..." />

                <button type="submit" class="btn btn-success">
                    Search
                </button>
            </form>

            <a href="/admin/category/add" class="btn btn-primary">
                + Thêm thể loại game mới
            </a>

        </div>
        <div>
            @if (TempData["Msg"] != null)
            {
                var msgType = TempData["MsgType"]?.ToString() ?? "info";
                <div class="alert alert-@msgType mt-2 fw-bold text-danger">
                    @TempData["Msg"]
                </div>
            }
        </div>

        <div class="table-responsive">
            <table class="table table-striped align-middle">
                <thead>
                    <tr>
                        <th>Mã thể loại game</th>
                        <th>Tên loại game</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var theLoai in Model.Categories)
                    {
                        <tr>
                            <td>@theLoai.MaTheLoai</td>
                            <td>@theLoai.TenLoaiGame</td>
                            <td>
                                <a class="btn btn-sm btn-warning" asp-controller="category" asp-action="edit" asp-route-id="@theLoai.MaTheLoai">Edit</a>
                                <button class="btn btn-danger btn-sm"
                                        data-bs-toggle="modal"
                                        data-bs-target="#deleteModal"
                                        data-category-id="@theLoai.MaTheLoai"
                                        data-category-name="@theLoai.TenLoaiGame">
                                    Delete
                                </button>
                                <div class="modal fade" id="deleteModal" tabindex="-1">
                                    <div class="modal-dialog modal-dialog-centered">
                                        <div class="modal-content bg-dark text-light">

                                            <div class="modal-header border-secondary">
                                                <h5 class="modal-title">Xác nhận xóa thể loại</h5>
                                                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                                            </div>

                                            <div class="modal-body">
                                                Bạn có chắc muốn xóa thể loại <strong id="deleteCategoryName"></strong> không? 🛑
                                            </div>

                                            <div class="modal-footer border-secondary">
                                                <form method="get" id="deleteForm">
                                                    <button type="submit" class="btn btn-danger">
                                                        Đồng ý xóa
                                                    </button>
                                                </form>
                                                <button class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                                            </div>

                                        </div>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            <!-- Pagination UI only -->
            <nav>
                <ul class="pagination justify-content-center mt-4">

                    <!-- Previous -->
                    <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                        <a class="page-link"
                           href="?keyword=@Model.Keyword&page=@(Model.CurrentPage - 1)">
                            Previous
                        </a>
                    </li>

                    <!-- Page numbers -->
                    @for (int i = 1; i <= Model.TotalPages; i++)
                    {
                        <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                            <a class="page-link"
                               href="?keyword=@Model.Keyword&page=@i">
                                @i
                            </a>
                        </li>
                    }

                    <!-- Next -->
                    <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                        <a class="page-link"
                           href="?keyword=@Model.Keyword&page=@(Model.CurrentPage + 1)">
                            Next
                        </a>
                    </li>

                </ul>
            </nav>
        </div>
    </div>
</div>
<script>
    var deleteModal = document.getElementById('deleteModal');
    deleteModal.addEventListener('show.bs.modal', function (event) {
        var button = event.relatedTarget;
        var categoryId = button.getAttribute('data-category-id');
        var categoryName = button.getAttribute('data-category-name');

        var modalTitle = deleteModal.querySelector('.modal-title');
        var modalBodyName = deleteModal.querySelector('#deleteCategoryName');

        modalBodyName.textContent = categoryName;

        var form = deleteModal.querySelector('#deleteForm');
        form.action = '/admin/category/delete/' + categoryId;
    });
</script>