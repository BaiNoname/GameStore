@model GameStore.Models.TheLoaiGame

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Add Category";
}

<div class="container mt-5">

    <div class="card bg-light text-light shadow-lg border-0">

        <div class="card-header border-bottom border-secondary">
            <h4 class="mb-0">🎮 Add Game Category</h4>
        </div>

        <div>
            @if (TempData["Msg"] != null)
            {
                var msgType = TempData["MsgType"]?.ToString() ?? "info";
                <div class="alert alert-@msgType mt-2 fw-bold text-danger">
                    @TempData["Msg"]
                </div>
            }
        </div>

        <div class="card-body">
            <form method="post" asp-controller="category" asp-action="add">

                <!-- Category ID -->
                <div class="mb-3">
                    <label class="form-label">Category ID</label>

                    <input type="text"
                           class="form-control"
                           asp-for="MaTheLoai"
                           placeholder="Enter category Id..." />

                    <span asp-validation-for="MaTheLoai"
                          class="text-danger"></span>
                </div>

                <!-- Category Name -->
                <div class="mb-3">
                    <label class="form-label">Category Name</label>

                    <input type="text"
                           class="form-control"
                           asp-for="TenLoaiGame"
                           placeholder="Enter category name..." />

                    <span asp-validation-for="TenLoaiGame"
                          class="text-danger"></span>
                </div>

                <!-- Buttons -->
                <div class="d-flex justify-content-end gap-2">

                    <a href="/Admin/Category/index"
                       class="btn btn-secondary">
                        Back
                    </a>

                    <button class="btn btn-success" type="submit">
                        ➕ Add Category
                    </button>

                </div>

            </form>

        </div>

    </div>

</div>