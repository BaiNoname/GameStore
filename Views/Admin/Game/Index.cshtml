@model GameStore.ViewModels.GameListVM
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Quản lý Game";
}

<div class="card">
    <div class="card-body">
        <h4 class="card-title">Danh sách game</h4>
        <p class="card-subtitle mb-3">Quản lý toàn bộ game trong hệ thống</p>

        <!-- Search + Add Button -->
        <div class="d-flex justify-content-between align-items-center mb-3">

            <form method="get" action="/admin/game/index" class="d-flex gap-2">

                <input type="text"
                       name="keyword"
                       value="@Model.Keyword"
                       class="form-control"
                       placeholder="Tìm game..." />

                <select name="categoryId" class="form-control">
                    <option value="">-- Tất cả thể loại --</option>

                    @foreach (var c in Model.Categories)
                    {
                        <option value="@c.MaTheLoai"
                                selected="@(Model.CategoryId == c.MaTheLoai)">
                            @c.TenLoaiGame
                        </option>
                    }
                </select>

                <button class="btn btn-success">Search</button>
            </form>

            <a href="/admin/game/add" class="btn btn-primary">
                + Add New Game
            </a>

        </div>
        <div class="p-2 text-success">
            @TempData["Msg"]
        </div>
        <div class="table-responsive">
            <table class="table table-striped align-middle">
                <thead>
                    <tr>
                        <th>Mã game</th>
                        <th>Tên game</th>
                        <th>Thể loại</th>
                        <th>Hình</th>
                        <th>Giá</th>
                        <th>Lượt tải</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var game in Model.Games)
                    {
                        <tr>
                            <td>@game.MaGame</td>
                            <td>@game.TenGame</td>
                            <td>@game.TheLoaiGame?.TenLoaiGame</td>
                            <td>
                                <img src="/images/@game.Hinh" width="120" />
                            </td>
                            <td>@String.Format("{0:N0} VNĐ", game.Gia)</td>
                            <td>@game.SoLuotTai</td>
                            <td>
                                <a class="btn btn-sm btn-warning" asp-controller="game" asp-action="edit" asp-route-id="@game.MaGame">Edit</a>
                                <a class="btn btn-sm btn-danger" asp-controller="game" asp-action="delete" asp-route-id="@game.MaGame" onclick="return confirm(`Are you Sure`)">Delete</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            <!-- Pagination UI only -->
            <nav>
                <ul class="pagination justify-content-center mt-4">

                    <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                        <a class="page-link"
                           href="?keyword=@Model.Keyword&categoryId=@Model.CategoryId&page=@(Model.CurrentPage - 1)">
                            Previous
                        </a>
                    </li>

                    @for (int i = 1; i <= Model.TotalPages; i++)
                    {
                        <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                            <a class="page-link"
                               href="?keyword=@Model.Keyword&categoryId=@Model.CategoryId&page=@i">
                                @i
                            </a>
                        </li>
                    }

                    <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                        <a class="page-link"
                           href="?keyword=@Model.Keyword&categoryId=@Model.CategoryId&page=@(Model.CurrentPage + 1)">
                            Next
                        </a>
                    </li>

                </ul>
            </nav>
        </div>
    </div>
</div>
