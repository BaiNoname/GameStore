@{
    ViewData["Title"] = "Community Chat";
}
<main class="gs-chat-page">
    <div class="container py-4 py-lg-5">
        <div class="mb-4">
            <div class="gs-kicker">Live Community</div>
            <h2 class="gs-chat-title mb-0">💬 Community Chat</h2>
        </div>

        <div class="chat-box gs-chat-shell mx-auto">
            <div id="messages" class="gs-chat-messages"></div>

            <div class="gs-chat-input-row">
                <input id="msg" class="form-control gs-chat-input" placeholder="Enter message..." autocomplete="off" />
                <button onclick="send()" class="btn gs-chat-send">Send</button>
            </div>
        </div>
    </div>
</main>

<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>
<script>
    // Create a connection to the SignalR hub
    const connection = new signalR.HubConnectionBuilder()
        .withUrl("/chatHub")
        .build();
    connection.start();
    connection.on("ReceiveMessage", function (sender, message) {
        const box = document.getElementById("messages");
        const div = document.createElement("div");
        div.className = "gs-chat-line";
        div.innerHTML = `<b>${sender}:</b> ${message}`;
        box.appendChild(div);
        box.scrollTop = box.scrollHeight; // tự cuộn xuống tin mới
    });
    function send() {
        const input = document.getElementById("msg");
        const msg = input.value;
        if (!msg.trim()) return;
        connection.invoke("SendMessage", msg);
        input.value = "";
        input.focus();
    }
    // Enter để gửi
    document.getElementById("msg").addEventListener("keydown", function (e) {
        if (e.key === "Enter") { e.preventDefault(); send(); }
    });
</script>

<style>
    :root {
        --gs-text: #f3f7ff;
        --gs-muted: #94a3b8;
        --gs-line: rgba(255,255,255,0.08);
        --gs-primary: linear-gradient(135deg, #a855f7, #6366f1 55%, #22d3ee);
    }

    .gs-chat-page {
        min-height: 100vh;
        color: var(--gs-text);
    }

    .gs-kicker {
        font-size: 12px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 1.8px;
        color: #67e8f9;
        margin-bottom: 8px;
    }

    .gs-chat-title {
        font-size: clamp(1.7rem, 3vw, 2.3rem);
        font-weight: 800;
        color: #fff;
        font-family: 'Orbitron', 'Inter', sans-serif;
    }

    .gs-chat-shell {
        max-width: 820px;
        border-radius: 24px;
        background: linear-gradient(180deg, rgba(14, 25, 43, 0.92), rgba(9, 18, 33, 0.92));
        border: 1px solid rgba(255,255,255,0.08);
        box-shadow: 0 20px 45px rgba(0,0,0,0.28);
        overflow: hidden;
    }

    .gs-chat-messages {
        height: 440px;
        overflow: auto;
        padding: 20px;
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .gs-chat-line {
        background: rgba(255,255,255,0.05);
        border: 1px solid rgba(255,255,255,0.06);
        border-left: 3px solid transparent;
        border-image: linear-gradient(180deg, #a855f7, #22d3ee) 1;
        border-radius: 12px;
        padding: 10px 14px;
        color: #e6eefb;
        line-height: 1.5;
        max-width: 85%;
        align-self: flex-start;
        animation: gsChatIn .25s ease;
        word-break: break-word;
    }

        .gs-chat-line b {
            color: #67e8f9;
            margin-right: 4px;
        }

    @@keyframes gsChatIn {
        from {
            opacity: 0;
            transform: translateY(8px);
        }

        to {
            opacity: 1;
            transform: none;
        }
    }

    .gs-chat-input-row {
        display: flex;
        gap: 10px;
        padding: 16px;
        border-top: 1px solid rgba(255,255,255,0.08);
        background: rgba(255,255,255,0.02);
    }

    .gs-chat-input,
    .gs-chat-input:focus {
        background: rgba(255,255,255,0.05);
        border: 1px solid rgba(255,255,255,0.08);
        color: #fff;
        border-radius: 999px;
        min-height: 48px;
        padding: 0 18px;
        box-shadow: none;
        flex: 1;
    }

        .gs-chat-input:focus {
            border-color: #a855f7;
            box-shadow: 0 0 0 3px rgba(168,85,247,.22);
        }

        .gs-chat-input::placeholder {
            color: #94a3b8;
        }

    .gs-chat-send {
        min-height: 48px;
        padding: 0 26px;
        border-radius: 999px;
        border: none;
        font-weight: 700;
        color: #fff;
        background: var(--gs-primary);
        box-shadow: 0 12px 26px rgba(124,58,237,.3);
        white-space: nowrap;
        transition: transform .18s ease, filter .2s ease;
    }

        .gs-chat-send:hover {
            color: #fff;
            filter: brightness(1.08);
            transform: translateY(-2px);
        }

    /* Thanh cuộn khung chat */
    .gs-chat-messages::-webkit-scrollbar {
        width: 8px;
    }

    .gs-chat-messages::-webkit-scrollbar-thumb {
        background: linear-gradient(180deg, #a855f7, #22d3ee);
        border-radius: 999px;
    }

    @@media (max-width: 575.98px) {
        .gs-chat-messages {
            height: 60vh;
        }

        .gs-chat-send {
            padding: 0 18px;
        }
    }
</style>
